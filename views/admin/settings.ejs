                    <label>Heritage — Handcrafted Image</label>

                    <div class="settings-upload-box">

                        <input
                            type="hidden"
                            name="heritageHandcraftedImage"
                            value="<%= s.heritageHandcraftedImage || '' %>"
                        >


                        <div class="settings-upload-preview">

                            <% if (s.heritageHandcraftedImage) { %>

                                <img
                                    id="heritageHandcraftedImagePreview"
                                    src="<%= s.heritageHandcraftedImage %>"
                                    alt="Heritage Handcrafted Image"
                                >

                            <% } else { %>

                                <div
                                    id="heritageHandcraftedImagePreviewPlaceholder"
