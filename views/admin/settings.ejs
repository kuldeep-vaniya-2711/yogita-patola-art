                    <div class="settings-toggle-info">

                        <strong>Show Contact</strong>

                        <span>
                            Display contact functionality on the website.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="showContact"
                            value="true"
                            <%= s.showContact !== false ? "checked" : "" %>
                        >

                        <span class="switch-slider"></span>

                    </label>

                </div>



                <!-- SHOW FEEDBACK -->

