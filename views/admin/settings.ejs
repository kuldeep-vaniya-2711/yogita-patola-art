<%
    const s =
        typeof settingsData !== "undefined" && settingsData
            ? settingsData
            : {};
%>

<%
    layout("admin/layout", {
        title: "Website Settings",
        pageTitle: "Website Settings",
        activePage: "settings",
        pageCss: "/css/admin/settings.css"
    });
%>


<div class="admin-settings-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="settings-page-header">
        <div>
            <h1>Website Settings</h1>
            <p>
                Manage your website information, images, SEO,
                social links and website visibility.
            </p>
        </div>
    </div>


    <!-- =====================================================
         SUCCESS / ERROR MESSAGES
    ====================================================== -->

    <% if (typeof success !== "undefined" && success) { %>
        <div class="settings-alert settings-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="settings-alert settings-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span><%= error %></span>
        </div>
    <% } %>


    <!-- =====================================================
         SETTINGS FORM
    ====================================================== -->

    <form
        action="/admin/settings"
        method="POST"
        enctype="multipart/form-data"
        class="settings-form"
    >


        <!-- =================================================
             WEBSITE INFORMATION
        ================================================== -->

        <section class="settings-section">

            <div class="settings-section-header">
                <div>
                    <h2>Website Information</h2>
                    <p>Basic information displayed throughout the website.</p>
                </div>

                <i class="bi bi-globe2"></i>
            </div>


            <div class="settings-grid">

                <div class="settings-field">
                    <label for="siteName">Site Name</label>

                    <input
                        type="text"
                        id="siteName"
                        name="siteName"
                        value="<%= s.siteName || '' %>"
                        placeholder="Yogita Patola Art"
                    >
                </div>


                <div class="settings-field">
                    <label for="siteEmail">Site Email</label>

                    <input
                        type="email"
                        id="siteEmail"
                        name="siteEmail"
                        value="<%= s.siteEmail || '' %>"
                        placeholder="info@example.com"
                    >
                </div>


                <div class="settings-field">
                    <label for="sitePhone">Site Phone</label>

                    <input
                        type="text"
                        id="sitePhone"
                        name="sitePhone"
                        value="<%= s.sitePhone || '' %>"
                        placeholder="+91 XXXXX XXXXX"
                    >
                </div>


                <div class="settings-field settings-field-full">
                    <label for="siteDescription">
                        Site Description
                    </label>

                    <textarea
                        id="siteDescription"
                        name="siteDescription"
                        rows="4"
                        placeholder="Website description"
                    ><%= s.siteDescription || '' %></textarea>
                </div>

            </div>

        </section>



        <!-- =================================================
             SEO SETTINGS
        ================================================== -->

        <section class="settings-section">

            <div class="settings-section-header">
                <div>
                    <h2>SEO Settings</h2>
                    <p>Manage search engine metadata for your website.</p>
                </div>

                <i class="bi bi-search"></i>
            </div>


            <div class="settings-grid">

                <div class="settings-field settings-field-full">
                    <label for="metaTitle">Meta Title</label>

                    <input
                        type="text"
                        id="metaTitle"
                        name="metaTitle"
                        value="<%= s.metaTitle || '' %>"
                        placeholder="Yogita Patola Art | Handcrafted Patola Sarees"
                    >
                </div>


                <div class="settings-field settings-field-full">
                    <label for="metaDescription">
                        Meta Description
                    </label>

                    <textarea
                        id="metaDescription"
                        name="metaDescription"
                        rows="4"
                        placeholder="Meta description"
                    ><%= s.metaDescription || '' %></textarea>
                </div>


                <div class="settings-field settings-field-full">
                    <label for="metaKeywords">
                        Meta Keywords
                    </label>

                    <input
                        type="text"
                        id="metaKeywords"
                        name="metaKeywords"
                        value="<%= s.metaKeywords || '' %>"
                        placeholder="Patola sarees, handcrafted Patola, traditional textiles"
                    >
                </div>


                <!-- FAVICON -->

                <div class="settings-field settings-field-full">

                    <label>Favicon</label>

                    <div class="settings-upload-box">

                        <input
                            type="hidden"
                            name="faviconUrl"
                            value="<%= s.faviconUrl || '' %>"
                        >

                        <div class="settings-upload-preview">

                            <% if (s.faviconUrl) { %>

                                <img
                                    id="faviconPreview"
                                    src="<%= s.faviconUrl %>"
                                    alt="Favicon"
                                >

                            <% } else { %>

                                <div
                                    id="faviconPreviewPlaceholder"
                                    class="settings-upload-placeholder"
                                >
                                    No image uploaded
                                </div>

                                <img
                                    id="faviconPreview"
                                    src=""
                                    alt="Favicon"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>


                        <div class="settings-upload-content">

                            <strong>Upload Favicon</strong>

                            <span>
                                JPG, PNG or WEBP · Max 5MB
                            </span>

                            <input
                                type="file"
                                name="faviconFile"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                data-preview-target="faviconPreview"
                                data-placeholder="faviconPreviewPlaceholder"
                            >

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =================================================
             HOME PAGE CONTENT
        ================================================== -->

        <section class="settings-section">

            <div class="settings-section-header">
                <div>
                    <h2>Home Page Content</h2>
                    <p>
                        Manage hero, about and heritage section content.
                    </p>
                </div>

                <i class="bi bi-house-door"></i>
            </div>


            <div class="settings-grid">


                <!-- HERO HEADING -->

