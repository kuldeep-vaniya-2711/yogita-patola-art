<%
    const s =
        typeof settingsData !== "undefined" &&
        settingsData
            ? settingsData
            : {};
%>

<%
    layout(
        "admin/layout",
        {
            title:
                "Website Settings"
        }
    );
%>


<div class="admin-settings-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="settings-page-header">

        <div>
            <span class="settings-eyebrow">
                WEBSITE CONTROL
            </span>

            <h1>
                Website Settings
            </h1>

            <p>
                Manage your website content, images,
                social links and visibility settings.
            </p>
        </div>

    </div>


    <!-- =====================================================
         MESSAGES
    ====================================================== -->

    <% if (success) { %>

        <div class="settings-alert settings-alert-success">
            <i class="bi bi-check-circle"></i>

            <span>
                <%= success %>
            </span>
        </div>

    <% } %>


    <% if (error) { %>

        <div class="settings-alert settings-alert-error">
            <i class="bi bi-exclamation-circle"></i>

            <span>
                <%= error %>
            </span>
        </div>

    <% } %>


    <!-- =====================================================
         SETTINGS FORM
    ====================================================== -->

    <form
        action="/admin/settings"
        method="POST"
        enctype="multipart/form-data"
        class="settings-form"
    >


        <!-- =================================================
             WEBSITE INFORMATION
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>
                    <span class="settings-section-label">
                        01
                    </span>

                    <h2>
                        Website Information
                    </h2>

                    <p>
                        Basic information displayed
                        across the website.
                    </p>
                </div>

            </div>


            <div class="settings-grid">

                <div class="settings-field">

                    <label for="siteName">
                        Website Name
                    </label>

                    <input
                        type="text"
                        id="siteName"
                        name="siteName"
                        value="<%= s.siteName || '' %>"
                        maxlength="150"
                        required
                    >

                </div>


                <div class="settings-field">

                    <label for="siteEmail">
                        Website Email
                    </label>

                    <input
                        type="email"
                        id="siteEmail"
                        name="siteEmail"
                        value="<%= s.siteEmail || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label for="sitePhone">
                        Phone Number
                    </label>

                    <input
                        type="text"
                        id="sitePhone"
                        name="sitePhone"
                        value="<%= s.sitePhone || '' %>"
                    >

                </div>


                <div class="settings-field settings-field-full">

                    <label for="siteDescription">
                        Website Description
                    </label>

                    <textarea
                        id="siteDescription"
                        name="siteDescription"
                        rows="4"
                        maxlength="500"
                    ><%= s.siteDescription || '' %></textarea>

                </div>

            </div>

        </section>


        <!-- =================================================
             SEO
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        02
                    </span>

                    <h2>
                        SEO Settings
                    </h2>

                    <p>
                        Search engine and metadata settings.
                    </p>

                </div>

            </div>


            <div class="settings-grid">

                <div class="settings-field settings-field-full">

                    <label for="metaTitle">
                        Meta Title
                    </label>

                    <input
                        type="text"
                        id="metaTitle"
                        name="metaTitle"
                        value="<%= s.metaTitle || '' %>"
                    >

                </div>


                <div class="settings-field settings-field-full">

                    <label for="metaDescription">
                        Meta Description
                    </label>

                    <textarea
                        id="metaDescription"
                        name="metaDescription"
                        rows="4"
                    ><%= s.metaDescription || '' %></textarea>

                </div>


                <div class="settings-field settings-field-full">

                    <label for="metaKeywords">
                        Meta Keywords
                    </label>

                    <input
                        type="text"
                        id="metaKeywords"
                        name="metaKeywords"
                        value="<%= s.metaKeywords || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label for="faviconUrl">
                        Favicon URL
                    </label>

                    <input
                        type="text"
                        id="faviconUrl"
                        name="faviconUrl"
                        value="<%= s.faviconUrl || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label>
                        Upload Favicon
                    </label>

                    <input
                        type="file"
                        name="faviconFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                </div>

            </div>

        </section>


        <!-- =================================================
             HOME PAGE
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        03
                    </span>

                    <h2>
                        Home Page Content
                    </h2>

                    <p>
                        Manage hero and introduction content.
                    </p>

                </div>

            </div>


            <div class="settings-grid">

                <div class="settings-field settings-field-full">

                    <label for="heroHeading">
                        Hero Heading
                    </label>

                    <input
                        type="text"
                        id="heroHeading"
                        name="heroHeading"
                        value="<%= s.heroHeading || '' %>"
                    >

                </div>


                <div class="settings-field settings-field-full">

                    <label for="heroDescription">
                        Hero Description
                    </label>

                    <textarea
                        id="heroDescription"
                        name="heroDescription"
                        rows="4"
                    ><%= s.heroDescription || '' %></textarea>

                </div>


                <div class="settings-field">

                    <label>
                        Hero Image
                    </label>

                    <input
                        type="file"
                        name="heroImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (s.heroImage) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.heroImage %>"
                                alt="Hero Image"
                            >

                        </div>

                    <% } %>

                </div>


                <div class="settings-field">

                    <label for="aboutHeading">
                        About Heading
                    </label>

                    <input
                        type="text"
                        id="aboutHeading"
                        name="aboutHeading"
                        value="<%= s.aboutHeading || '' %>"
                    >

                </div>


                <div class="settings-field settings-field-full">

                    <label for="aboutDescription">
                        About Description
                    </label>

                    <textarea
                        id="aboutDescription"
                        name="aboutDescription"
                        rows="4"
                    ><%= s.aboutDescription || '' %></textarea>

                </div>


                <div class="settings-field">

                    <label>
                        About Image
                    </label>

                    <input
                        type="file"
                        name="aboutImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (s.aboutImage) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.aboutImage %>"
                                alt="About Image"
                            >

                        </div>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- =================================================
             OUR STORY
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        04
                    </span>

                    <h2>
                        Our Story Images
                    </h2>

                    <p>
                        Images used on the Our Story page.
                    </p>

                </div>

            </div>


            <div class="settings-grid">

                <div class="settings-field">

                    <label>
                        Our Story Image
                    </label>

                    <input
                        type="file"
                        name="aboutStoryImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (s.aboutStoryImage) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.aboutStoryImage %>"
                                alt="Our Story Image"
                            >

                        </div>

                    <% } %>

                </div>


                <div class="settings-field">

                    <label>
                        The Art of Patola Image
                    </label>

                    <small class="settings-help-text">
                        Upload the image displayed in
                        the "The Art of Patola" section
                        of the Our Story page.
                    </small>

                    <input
                        type="file"
                        name="aboutArtImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (s.aboutArtImage) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.aboutArtImage %>"
                                alt="The Art of Patola"
                            >

                        </div>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- =================================================
             HERITAGE
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        05
                    </span>

                    <h2>
                        Heritage Images
                    </h2>

                    <p>
                        Images used in the heritage section.
                    </p>

                </div>

            </div>


            <div class="settings-grid">


                <div class="settings-field">

                    <label>
                        Handcrafted Image
                    </label>

                    <input
                        type="file"
                        name="heritageHandcraftedImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (
                        s.heritageHandcraftedImage
                    ) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.heritageHandcraftedImage %>"
                                alt="Handcrafted Heritage"
                            >

                        </div>

                    <% } %>

                </div>


                <div class="settings-field">

                    <label>
                        Intricate Image
                    </label>

                    <input
                        type="file"
                        name="heritageIntricateImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (
                        s.heritageIntricateImage
                    ) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.heritageIntricateImage %>"
                                alt="Intricate Heritage"
                            >

                        </div>

                    <% } %>

                </div>


                <div class="settings-field">

                    <label>
                        Timeless Image
                    </label>

                    <input
                        type="file"
                        name="heritageTimelessImageFile"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (
                        s.heritageTimelessImage
                    ) { %>

                        <div class="settings-image-preview">

                            <img
                                src="<%= s.heritageTimelessImage %>"
                                alt="Timeless Heritage"
                            >

                        </div>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- =================================================
             CONTACT & SOCIAL
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        06
                    </span>

                    <h2>
                        Contact & Social
                    </h2>

                    <p>
                        Contact information and social profiles.
                    </p>

                </div>

            </div>


            <div class="settings-grid">

                <div class="settings-field settings-field-full">

                    <label for="address">
                        Address
                    </label>

                    <textarea
                        id="address"
                        name="address"
                        rows="4"
                        maxlength="500"
                    ><%= s.address || '' %></textarea>

                </div>


                <div class="settings-field">

                    <label for="whatsapp">
                        WhatsApp
                    </label>

                    <input
                        type="text"
                        id="whatsapp"
                        name="whatsapp"
                        value="<%= s.whatsapp || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label for="instagram">
                        Instagram
                    </label>

                    <input
                        type="text"
                        id="instagram"
                        name="instagram"
                        value="<%= s.instagram || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label for="facebook">
                        Facebook
                    </label>

                    <input
                        type="text"
                        id="facebook"
                        name="facebook"
                        value="<%= s.facebook || '' %>"
                    >

                </div>


                <div class="settings-field">

                    <label for="youtube">
                        YouTube
                    </label>

                    <input
                        type="text"
                        id="youtube"
                        name="youtube"
                        value="<%= s.youtube || '' %>"
                    >

                </div>

            </div>

        </section>


        <!-- =================================================
             WEBSITE STATUS
        ================================================== -->

        <section class="settings-card">

            <div class="settings-card-header">

                <div>

                    <span class="settings-section-label">
                        07
                    </span>

                    <h2>
                        Website Status
                    </h2>

                    <p>
                        Control website visibility and features.
                    </p>

                </div>

            </div>


            <div class="settings-status-list">


                <!-- Maintenance -->

                <div class="settings-status-row">

                    <div>

                        <strong>
                            Maintenance Mode
                        </strong>

                        <span>
                            Temporarily place the website
                            into maintenance mode.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="maintenanceMode"
                            value="true"
                            <%= s.maintenanceMode ? "checked" : "" %>
                        >

                        <span class="switch-slider"></span>

                    </label>

                </div>


                <!-- Contact -->

                <div class="settings-status-row">

                    <div>

                        <strong>
                            Show Contact
                        </strong>

                        <span>
                            Display contact functionality
                            on the public website.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="showContact"
                            value="true"
                            <%= s.showContact !== false ? "checked" : "" %>
                        >

                        <span class="switch-slider"></span>

                    </label>

                </div>


                <!-- Feedback -->

                <div class="settings-status-row">

                    <div>

                        <strong>
                            Show Feedback
                        </strong>

                        <span>
                            Display feedback functionality
                            on the public website.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="showFeedback"
                            value="true"
                            <%= s.showFeedback !== false ? "checked" : "" %>
                        >

                        <span class="switch-slider"></span>

                    </label>

                </div>


                <!-- Reviews -->

                <div class="settings-status-row">

                    <div>

                        <strong>
                            Show Reviews
                        </strong>

                        <span>
                            Display customer reviews
                            on the public website.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="showReviews"
                            value="true"
                            <%= s.showReviews !== false ? "checked" : "" %>
                        >

                        <span class="switch-slider"></span>

                    </label>

                </div>

            </div>

        </section>


        <!-- =================================================
             SAVE
        ================================================== -->

        <div class="settings-save-area">

            <button
                type="submit"
                class="settings-save-button"
            >

                <i class="bi bi-check2-circle"></i>

                Save Website Settings

            </button>

        </div>

    </form>

</div>