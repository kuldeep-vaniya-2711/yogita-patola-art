                                    class="settings-upload-placeholder"
                                >
                                    No image uploaded
                                </div>

                                <img
                                    id="aboutStoryImagePreview"
                                    src=""
                                    alt="Our Story Image"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>


                        <div class="settings-upload-content">

