                        <div class="settings-upload-preview">

                            <% if (s.aboutStoryImage) { %>

                                <img
                                    id="aboutStoryImagePreview"
                                    src="<%= s.aboutStoryImage %>"
                                    alt="Our Story Image"
                                >

                            <% } else { %>

                                <div
