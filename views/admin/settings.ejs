                            Temporarily show maintenance mode to visitors.
                        </span>

                    </div>


                    <label class="settings-switch">

                        <input
                            type="checkbox"
                            name="maintenanceMode"
                            value="true"
                            <%= s.maintenanceMode ? "checked" : "" %>
