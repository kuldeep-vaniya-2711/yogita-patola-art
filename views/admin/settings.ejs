<%
layout("admin/layout", {
title: "Website Settings",
pageTitle: "Website Settings",
pageCss: "/css/admin/settings.css"
});
%>

<%
const s =
typeof settingsData !== "undefined" &&
settingsData
? settingsData
: {};


const successMessage =
    typeof success !== "undefined"
        ? success
        : "";

const errorMessage =
    typeof error !== "undefined"
        ? error
        : "";


%>

<div class="admin-settings-page">


<!-- ==================================================
     PAGE HEADER
================================================== -->

<div class="settings-page-header">

    <div>

        <div class="settings-eyebrow">
            WEBSITE CONTROL
        </div>

        <h1>
            Website Settings
        </h1>

        <p>
            Manage your website content, images,
            contact information and visibility options.
        </p>

    </div>

</div>


<!-- ==================================================
     ALERTS
================================================== -->

<% if (successMessage) { %>

    <div class="settings-alert settings-alert-success">
        <span class="settings-alert-icon">✓</span>

        <span>
            <%= successMessage %>
        </span>
    </div>

<% } %>


<% if (errorMessage) { %>

    <div class="settings-alert settings-alert-error">
        <span class="settings-alert-icon">!</span>

        <span>
            <%= errorMessage %>
        </span>
    </div>

<% } %>


<!-- ==================================================
     SETTINGS FORM
================================================== -->

<form
    action="/admin/settings"
    method="POST"
    enctype="multipart/form-data"
    class="settings-form"
>


    <!-- ==================================================
         WEBSITE INFORMATION
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ◈
            </div>

            <div>

                <h2>
                    Website Information
                </h2>

                <p>
                    Basic information displayed throughout
                    the public website.
                </p>

            </div>

        </div>


        <div class="settings-grid">

            <div class="settings-field settings-field-full">

                <label>
                    Website Name
                </label>

                <input
                    type="text"
                    name="siteName"
                    value="<%= s.siteName || '' %>"
                    maxlength="150"
                    placeholder="Yogita Patola Art"
                    required
                >

            </div>


            <div class="settings-field settings-field-full">

                <label>
                    Website Description
                </label>

                <textarea
                    name="siteDescription"
                    rows="4"
                    maxlength="500"
                    placeholder="Website description"
                ><%= s.siteDescription || '' %></textarea>

            </div>


            <div class="settings-field">

                <label>
                    Website Email
                </label>

                <input
                    type="email"
                    name="siteEmail"
                    value="<%= s.siteEmail || '' %>"
                    placeholder="info@example.com"
                >

            </div>


            <div class="settings-field">

                <label>
                    Phone Number
                </label>

                <input
                    type="text"
                    name="sitePhone"
                    value="<%= s.sitePhone || '' %>"
                    maxlength="30"
                    placeholder="+91 XXXXX XXXXX"
                >

            </div>

        </div>

    </section>


    <!-- ==================================================
         HOME PAGE
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ✦
            </div>

            <div>

                <h2>
                    Home Page
                </h2>

                <p>
                    Manage the main content and imagery
                    shown on your homepage.
                </p>

            </div>

        </div>


        <div class="settings-grid">


            <!-- HERO HEADING -->

            <div class="settings-field settings-field-full">

                <label>
                    Hero Heading
                </label>

                <input
                    type="text"
                    name="heroHeading"
                    value="<%= s.heroHeading || '' %>"
                    placeholder="Woven Heritage, Timeless Beauty."
                >

            </div>


            <!-- HERO DESCRIPTION -->

            <div class="settings-field settings-field-full">

                <label>
                    Hero Description
                </label>

                <textarea
                    name="heroDescription"
                    rows="4"
                    placeholder="Hero description"
                ><%= s.heroDescription || '' %></textarea>

            </div>


            <!-- HERO IMAGE -->

            <div class="settings-field settings-field-full">

                <label>
                    Hero Image
                </label>

                <div class="settings-upload-box">

                    <input
                        type="hidden"
                        name="heroImage"
                        value="<%= s.heroImage || '' %>"
                    >

                    <div class="settings-upload-preview">

                        <% if (s.heroImage) { %>

                            <img
                                id="heroImagePreview"
                                src="<%= s.heroImage %>"
                                alt="Hero Image"
                            >

                        <% } else { %>

                            <div
                                id="heroImagePreviewPlaceholder"
                                class="settings-upload-placeholder"
                            >
                                No image uploaded
                            </div>

                            <img
                                id="heroImagePreview"
                                src=""
                                alt="Hero Image"
                                style="display:none;"
                            >

                        <% } %>

                    </div>

                    <div class="settings-upload-content">

                        <strong>
                            Upload Hero Image
                        </strong>

                        <span>
                            JPG, PNG or WEBP · Max 5MB
                        </span>

                        <input
                            type="file"
                            name="heroImageFile"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            data-preview-target="heroImagePreview"
                            data-placeholder="heroImagePreviewPlaceholder"
                        >

                    </div>

                </div>

            </div>


            <!-- ABOUT HEADING -->

            <div class="settings-field settings-field-full">

                <label>
                    About Heading
                </label>

                <input
                    type="text"
                    name="aboutHeading"
                    value="<%= s.aboutHeading || '' %>"
                    placeholder="Preserving Tradition. Creating Legacy."
                >

            </div>


            <!-- ABOUT DESCRIPTION -->

            <div class="settings-field settings-field-full">

                <label>
                    About Description
                </label>

                <textarea
                    name="aboutDescription"
                    rows="4"
                    placeholder="About section description"
                ><%= s.aboutDescription || '' %></textarea>

            </div>


            <!-- ABOUT IMAGE -->

            <div class="settings-field settings-field-full">

                <label>
                    About Image
                </label>

                <div class="settings-upload-box">

                    <input
                        type="hidden"
                        name="aboutImage"
                        value="<%= s.aboutImage || '' %>"
                    >

                    <div class="settings-upload-preview">

                        <% if (s.aboutImage) { %>

                            <img
                                id="aboutImagePreview"
                                src="<%= s.aboutImage %>"
                                alt="About Image"
                            >

                        <% } else { %>

                            <div
                                id="aboutImagePreviewPlaceholder"
                                class="settings-upload-placeholder"
                            >
                                No image uploaded
                            </div>

                            <img
                                id="aboutImagePreview"
                                src=""
                                alt="About Image"
                                style="display:none;"
                            >

                        <% } %>

                    </div>

                    <div class="settings-upload-content">

                        <strong>
                            Upload About Image
                        </strong>

                        <span>
                            JPG, PNG or WEBP · Max 5MB
                        </span>

                        <input
                            type="file"
                            name="aboutImageFile"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            data-preview-target="aboutImagePreview"
                            data-placeholder="aboutImagePreviewPlaceholder"
                        >

                    </div>

                </div>

            </div>

        </div>


        <!-- ==================================================
             HERITAGE IMAGES
        ================================================== -->

        <div class="settings-subsection">

            <div class="settings-subsection-header">

                <div>

                    <span class="settings-subsection-eyebrow">
                        OUR HERITAGE
                    </span>

                    <h3>
                        Heritage Card Images
                    </h3>

                    <p>
                        Upload the three images used behind
                        the Handcrafted, Intricate Art and
                        Timeless cards on the public homepage.
                    </p>

                </div>

            </div>


            <div class="settings-grid">


                <!-- HANDCRAFTED -->

                <div class="settings-field">

                    <label>
                        Handcrafted Image
                    </label>

                    <div class="settings-upload-box settings-heritage-upload">

                        <input
                            type="hidden"
                            name="heritageHandcraftedImage"
                            value="<%= s.heritageHandcraftedImage || '' %>"
                        >

                        <div class="settings-upload-preview">

                            <% if (s.heritageHandcraftedImage) { %>

                                <img
                                    id="heritageHandcraftedImagePreview"
                                    src="<%= s.heritageHandcraftedImage %>"
                                    alt="Handcrafted Heritage"
                                >

                            <% } else { %>

                                <div
                                    id="heritageHandcraftedImagePreviewPlaceholder"
                                    class="settings-upload-placeholder"
                                >
                                    No image uploaded
                                </div>

                                <img
                                    id="heritageHandcraftedImagePreview"
                                    src=""
                                    alt="Handcrafted Heritage"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>

                        <div class="settings-upload-content">

                            <strong>
                                Handcrafted
                            </strong>

                            <span>
                                Artisan hands, loom,
                                weaving or craftsmanship
                            </span>

                            <input
                                type="file"
                                name="heritageHandcraftedImageFile"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                data-preview-target="heritageHandcraftedImagePreview"
                                data-placeholder="heritageHandcraftedImagePreviewPlaceholder"
                            >

                        </div>

                    </div>

                </div>


                <!-- INTRICATE -->

                <div class="settings-field">

                    <label>
                        Intricate Art Image
                    </label>

                    <div class="settings-upload-box settings-heritage-upload">

                        <input
                            type="hidden"
                            name="heritageIntricateImage"
                            value="<%= s.heritageIntricateImage || '' %>"
                        >

                        <div class="settings-upload-preview">

                            <% if (s.heritageIntricateImage) { %>

                                <img
                                    id="heritageIntricateImagePreview"
                                    src="<%= s.heritageIntricateImage %>"
                                    alt="Intricate Patola Art"
                                >

                            <% } else { %>

                                <div
                                    id="heritageIntricateImagePreviewPlaceholder"
                                    class="settings-upload-placeholder"
                                >
                                    No image uploaded
                                </div>

                                <img
                                    id="heritageIntricateImagePreview"
                                    src=""
                                    alt="Intricate Patola Art"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>

                        <div class="settings-upload-content">

                            <strong>
                                Intricate Art
                            </strong>

                            <span>
                                Close-up Patola weave,
                                motifs or geometric patterns
                            </span>

                            <input
                                type="file"
                                name="heritageIntricateImageFile"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                data-preview-target="heritageIntricateImagePreview"
                                data-placeholder="heritageIntricateImagePreviewPlaceholder"
                            >

                        </div>

                    </div>

                </div>


                <!-- TIMELESS -->

                <div class="settings-field">

                    <label>
                        Timeless Image
                    </label>

                    <div class="settings-upload-box settings-heritage-upload">

                        <input
                            type="hidden"
                            name="heritageTimelessImage"
                            value="<%= s.heritageTimelessImage || '' %>"
                        >

                        <div class="settings-upload-preview">

                            <% if (s.heritageTimelessImage) { %>

                                <img
                                    id="heritageTimelessImagePreview"
                                    src="<%= s.heritageTimelessImage %>"
                                    alt="Timeless Patola Heritage"
                                >

                            <% } else { %>

                                <div
                                    id="heritageTimelessImagePreviewPlaceholder"
                                    class="settings-upload-placeholder"
                                >
                                    No image uploaded
                                </div>

                                <img
                                    id="heritageTimelessImagePreview"
                                    src=""
                                    alt="Timeless Patola Heritage"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>

                        <div class="settings-upload-content">

                            <strong>
                                Timeless
                            </strong>

                            <span>
                                Traditional Patola textile,
                                heritage pattern or saree
                            </span>

                            <input
                                type="file"
                                name="heritageTimelessImageFile"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                data-preview-target="heritageTimelessImagePreview"
                                data-placeholder="heritageTimelessImagePreviewPlaceholder"
                            >

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==================================================
         CONTACT INFORMATION
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ◎
            </div>

            <div>

                <h2>
                    Contact Information
                </h2>

                <p>
                    Contact details shown across the website.
                </p>

            </div>

        </div>


        <div class="settings-grid">

            <div class="settings-field settings-field-full">

                <label>
                    Address
                </label>

                <textarea
                    name="address"
                    rows="4"
                    maxlength="500"
                    placeholder="Business address"
                ><%= s.address || '' %></textarea>

            </div>


            <div class="settings-field">

                <label>
                    WhatsApp
                </label>

                <input
                    type="text"
                    name="whatsapp"
                    value="<%= s.whatsapp || '' %>"
                    placeholder="WhatsApp number or link"
                >

            </div>

        </div>

    </section>


    <!-- ==================================================
         SOCIAL MEDIA
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ◎
            </div>

            <div>

                <h2>
                    Social Media
                </h2>

                <p>
                    Add your official social media profiles.
                </p>

            </div>

        </div>


        <div class="settings-grid">

            <div class="settings-field">

                <label>
                    Instagram
                </label>

                <input
                    type="text"
                    name="instagram"
                    value="<%= s.instagram || '' %>"
                    placeholder="Instagram profile URL"
                >

            </div>


            <div class="settings-field">

                <label>
                    Facebook
                </label>

                <input
                    type="text"
                    name="facebook"
                    value="<%= s.facebook || '' %>"
                    placeholder="Facebook profile URL"
                >

            </div>


            <div class="settings-field">

                <label>
                    YouTube
                </label>

                <input
                    type="text"
                    name="youtube"
                    value="<%= s.youtube || '' %>"
                    placeholder="YouTube channel URL"
                >

            </div>

        </div>

    </section>


    <!-- ==================================================
         SEO
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ◇
            </div>

            <div>

                <h2>
                    SEO Settings
                </h2>

                <p>
                    Search engine metadata for your website.
                </p>

            </div>

        </div>


        <div class="settings-grid">

            <div class="settings-field settings-field-full">

                <label>
                    Meta Title
                </label>

                <input
                    type="text"
                    name="metaTitle"
                    value="<%= s.metaTitle || '' %>"
                    placeholder="Yogita Patola Art | Handcrafted Patola Sarees"
                >

            </div>


            <div class="settings-field settings-field-full">

                <label>
                    Meta Description
                </label>

                <textarea
                    name="metaDescription"
                    rows="4"
                    placeholder="Meta description"
                ><%= s.metaDescription || '' %></textarea>

            </div>


            <div class="settings-field settings-field-full">

                <label>
                    Meta Keywords
                </label>

                <textarea
                    name="metaKeywords"
                    rows="3"
                    placeholder="Patola sarees, Patola art, traditional textiles"
                ><%= s.metaKeywords || '' %></textarea>

            </div>


            <!-- FAVICON -->

            <div class="settings-field settings-field-full">

                <label>
                    Favicon
                </label>

                <div class="settings-upload-box">

                    <input
                        type="hidden"
                        name="faviconUrl"
                        value="<%= s.faviconUrl || '' %>"
                    >

                    <div class="settings-upload-preview settings-favicon-preview">

                        <% if (s.faviconUrl) { %>

                            <img
                                id="faviconPreview"
                                src="<%= s.faviconUrl %>"
                                alt="Favicon"
                            >

                        <% } else { %>

                            <div
                                id="faviconPreviewPlaceholder"
                                class="settings-upload-placeholder"
                            >
                                No favicon
                            </div>

                            <img
                                id="faviconPreview"
                                src=""
                                alt="Favicon"
                                style="display:none;"
                            >

                        <% } %>

                    </div>

                    <div class="settings-upload-content">

                        <strong>
                            Upload Favicon
                        </strong>

                        <span>
                            PNG, JPG or WEBP · Max 5MB
                        </span>

                        <input
                            type="file"
                            name="faviconFile"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            data-preview-target="faviconPreview"
                            data-placeholder="faviconPreviewPlaceholder"
                        >

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==================================================
         WEBSITE OPTIONS
    ================================================== -->

    <section class="settings-card">

        <div class="settings-card-header">

            <div class="settings-card-icon">
                ⚙
            </div>

            <div>

                <h2>
                    Website Options
                </h2>

                <p>
                    Control which public features are visible.
                </p>

            </div>

        </div>


        <div class="settings-options">


            <!-- MAINTENANCE -->

            <label class="settings-switch-row">

                <div>

                    <strong>
                        Maintenance Mode
                    </strong>

                    <span>
                        Temporarily place the public website
                        into maintenance mode.
                    </span>

                </div>

                <span class="settings-switch">

                    <input
                        type="checkbox"
                        name="maintenanceMode"
                        <%= s.maintenanceMode ? "checked" : "" %>
                    >

                    <span class="switch-slider"></span>

                </span>

            </label>


            <!-- CONTACT -->

            <label class="settings-switch-row">

                <div>

                    <strong>
                        Show Contact
                    </strong>

                    <span>
                        Show contact options on the public website.
                    </span>

                </div>

                <span class="settings-switch">

                    <input
                        type="checkbox"
                        name="showContact"
                        <%= s.showContact !== false ? "checked" : "" %>
                    >

                    <span class="switch-slider"></span>

                </span>

            </label>


            <!-- FEEDBACK -->

            <label class="settings-switch-row">

                <div>

                    <strong>
                        Show Feedback
                    </strong>

                    <span>
                        Allow visitors to access feedback features.
                    </span>

                </div>

                <span class="settings-switch">

                    <input
                        type="checkbox"
                        name="showFeedback"
                        <%= s.showFeedback !== false ? "checked" : "" %>
                    >

                    <span class="switch-slider"></span>

                </span>

            </label>


            <!-- REVIEWS -->

            <label class="settings-switch-row">

                <div>

                    <strong>
                        Show Reviews
                    </strong>

                    <span>
                        Display customer reviews on the website.
                    </span>

                </div>

                <span class="settings-switch">

                    <input
                        type="checkbox"
                        name="showReviews"
                        <%= s.showReviews !== false ? "checked" : "" %>
                    >

                    <span class="switch-slider"></span>

                </span>

            </label>

        </div>

    </section>


    <!-- ==================================================
         SAVE BUTTON
    ================================================== -->

    <div class="settings-save-bar">

        <div>

            <strong>
                Save your changes
            </strong>

            <span>
                All website settings will be updated together.
            </span>

        </div>

        <button
            type="submit"
            class="settings-save-button"
        >
            <span>Save Settings</span>
            <span class="settings-save-arrow">→</span>
        </button>

    </div>


</form>


</div>

<!-- ==================================================
     IMAGE PREVIEW SCRIPT
================================================== -->

<script>

(function () {

    const fileInputs =
        document.querySelectorAll(
            "input[type='file'][data-preview-target]"
        );


    fileInputs.forEach(
        input => {

            input.addEventListener(
                "change",
                function () {

                    const file =
                        this.files &&
                        this.files[0];

                    const previewId =
                        this.dataset.previewTarget;

                    const placeholderId =
                        this.dataset.placeholder;

                    const preview =
                        document.getElementById(
                            previewId
                        );

                    const placeholder =
                        placeholderId
                            ? document.getElementById(
                                placeholderId
                            )
                            : null;


                    if (!file) {
                        return;
                    }


                    if (
                        !file.type.startsWith(
                            "image/"
                        )
                    ) {

                        this.value = "";

                        return;

                    }


                    const objectUrl =
                        URL.createObjectURL(
                            file
                        );


                    if (preview) {

                        preview.src =
                            objectUrl;

                        preview.style.display =
                            "block";

                    }


                    if (placeholder) {

                        placeholder.style.display =
                            "none";

                    }

                }
            );

        }
    );

})();

</script>
