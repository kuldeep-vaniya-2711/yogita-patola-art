                                    alt="About Image"
                                    style="display:none;"
                                >

                            <% } %>

                        </div>


                        <div class="settings-upload-content">

                            <strong>Upload About Image</strong>

                            <span>
                                JPG, PNG or WEBP · Max 5MB
                            </span>

