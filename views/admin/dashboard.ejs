<%
    /*
     * =========================================================
     * ADMIN DASHBOARD
     * =========================================================
     *
     * IMPORTANT:
     * This page MUST use the admin layout.
     *
     * Do NOT change this to:
     * layout("layout")
     *
     * because views/layout.ejs is the PUBLIC website layout
     * and contains the public navbar/footer.
     *
     * Correct admin layout:
     * views/admin/layout.ejs
     * =========================================================
     */

    layout("admin/layout", {
        title: "Admin Dashboard",
        pageTitle: "Dashboard",
        pageCss: "/css/admin/dashboard.css",
        pageJs: "/js/admin/dashboard.js"
    });
%>


<section class="admin-dashboard-page">

    <!-- =====================================================
         WELCOME HEADER
         ===================================================== -->

    <section class="admin-dashboard-welcome">

        <div class="admin-dashboard-welcome-content">

            <span class="admin-dashboard-eyebrow">
                YOGITA PATOLA ART
            </span>

            <h2>
                Welcome back, Administrator
            </h2>

            <p>
                Manage your products, customer activity,
                website content and analytics from one place.
            </p>

        </div>

        <div class="admin-dashboard-welcome-decoration">
            <i class="bi bi-grid-1x2-fill"></i>
        </div>

    </section>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <section class="admin-dashboard-stats">

        <!-- TOTAL PRODUCTS -->

        <article class="admin-stat-card">

            <div class="admin-stat-icon">
                <i class="bi bi-bag-fill"></i>
            </div>

            <div class="admin-stat-content">

                <span class="admin-stat-label">
                    Total Products
                </span>

                <strong class="admin-stat-value">
                    <%= typeof productCount !== "undefined"
                        ? productCount
                        : 0 %>
                </strong>

                <span class="admin-stat-description">
                    Products in catalog
                </span>

            </div>

        </article>


        <!-- REVIEWS -->

        <article class="admin-stat-card">

            <div class="admin-stat-icon">
                <i class="bi bi-star-fill"></i>
            </div>

            <div class="admin-stat-content">

                <span class="admin-stat-label">
                    Reviews
                </span>

                <strong class="admin-stat-value">
                    <%= typeof reviewCount !== "undefined"
                        ? reviewCount
                        : 0 %>
                </strong>

                <span class="admin-stat-description">
                    Customer reviews
                </span>

            </div>

        </article>


        <!-- FEEDBACK -->

        <article class="admin-stat-card">

            <div class="admin-stat-icon">
                <i class="bi bi-chat-square-text-fill"></i>
            </div>

            <div class="admin-stat-content">

                <span class="admin-stat-label">
                    Feedback
                </span>

                <strong class="admin-stat-value">
                    <%= typeof feedbackCount !== "undefined"
                        ? feedbackCount
                        : 0 %>
                </strong>

                <span class="admin-stat-description">
                    Customer feedback
                </span>

            </div>

        </article>


        <!-- VISITORS -->

        <article class="admin-stat-card">

            <div class="admin-stat-icon">
                <i class="bi bi-bar-chart-fill"></i>
            </div>

            <div class="admin-stat-content">

                <span class="admin-stat-label">
                    Visitors
                </span>

                <strong class="admin-stat-value">
                    <%= typeof visitorCount !== "undefined"
                        ? visitorCount
                        : 0 %>
                </strong>

                <span class="admin-stat-description">
                    Website visits
                </span>

            </div>

        </article>

    </section>


    <!-- =====================================================
         MAIN DASHBOARD GRID
         ===================================================== -->

    <div class="admin-dashboard-grid">


        <!-- =================================================
             QUICK ACTIONS
             ================================================= -->

        <section class="admin-dashboard-card admin-quick-actions">

            <div class="admin-dashboard-card-header">

                <div>
                    <span class="admin-card-eyebrow">
                        MANAGEMENT
                    </span>

                    <h3>
                        Quick Actions
                    </h3>
                </div>

                <span class="admin-card-header-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </span>

            </div>


            <div class="admin-quick-actions-grid">

                <!-- ADD PRODUCT -->

                <a
                    href="/admin/products/add"
                    class="admin-quick-action"
                >

                    <span class="admin-quick-action-icon">
                        <i class="bi bi-plus-square-fill"></i>
                    </span>

                    <span class="admin-quick-action-content">

                        <strong>
                            Add Product
                        </strong>

                        <small>
                            Add a new product
                        </small>

                    </span>

                    <i class="bi bi-arrow-right admin-quick-action-arrow"></i>

                </a>


                <!-- MANAGE PRODUCTS -->

                <a
                    href="/admin/products"
                    class="admin-quick-action"
                >

                    <span class="admin-quick-action-icon">
                        <i class="bi bi-bag-fill"></i>
                    </span>

                    <span class="admin-quick-action-content">

                        <strong>
                            Manage Products
                        </strong>

                        <small>
                            View and edit products
                        </small>

                    </span>

                    <i class="bi bi-arrow-right admin-quick-action-arrow"></i>

                </a>


                <!-- MANAGE REVIEWS -->

                <a
                    href="/admin/reviews"
                    class="admin-quick-action"
                >

                    <span class="admin-quick-action-icon">
                        <i class="bi bi-star-fill"></i>
                    </span>

                    <span class="admin-quick-action-content">

                        <strong>
                            Manage Reviews
                        </strong>

                        <small>
                            Review customer ratings
                        </small>

                    </span>

                    <i class="bi bi-arrow-right admin-quick-action-arrow"></i>

                </a>


                <!-- FEEDBACK -->

                <a
                    href="/admin/feedback"
                    class="admin-quick-action"
                >

                    <span class="admin-quick-action-icon">
                        <i class="bi bi-chat-square-text-fill"></i>
                    </span>

                    <span class="admin-quick-action-content">

                        <strong>
                            View Feedback
                        </strong>

                        <small>
                            Read customer feedback
                        </small>

                    </span>

                    <i class="bi bi-arrow-right admin-quick-action-arrow"></i>

                </a>

            </div>

        </section>



        <!-- =================================================
             WEBSITE SHORTCUTS
             ================================================= -->

        <section class="admin-dashboard-card admin-website-shortcuts">

            <div class="admin-dashboard-card-header">

                <div>
                    <span class="admin-card-eyebrow">
                        WEBSITE
                    </span>

                    <h3>
                        Website Shortcuts
                    </h3>
                </div>

                <span class="admin-card-header-icon">
                    <i class="bi bi-globe2"></i>
                </span>

            </div>


            <div class="admin-shortcuts-list">


                <!-- VIEW WEBSITE -->

                <a
                    href="/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="admin-shortcut-item"
                >

                    <span class="admin-shortcut-icon">
                        <i class="bi bi-globe2"></i>
                    </span>

                    <span class="admin-shortcut-content">

                        <strong>
                            View Website
                        </strong>

                        <small>
                            Open public website
                        </small>

                    </span>

                    <i class="bi bi-box-arrow-up-right"></i>

                </a>


                <!-- COLLECTIONS -->

                <a
                    href="/collections"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="admin-shortcut-item"
                >

                    <span class="admin-shortcut-icon">
                        <i class="bi bi-grid-fill"></i>
                    </span>

                    <span class="admin-shortcut-content">

                        <strong>
                            Collections
                        </strong>

                        <small>
                            View product collections
                        </small>

                    </span>

                    <i class="bi bi-box-arrow-up-right"></i>

                </a>


                <!-- CONTACT -->

                <a
                    href="/contact"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="admin-shortcut-item"
                >

                    <span class="admin-shortcut-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </span>

                    <span class="admin-shortcut-content">

                        <strong>
                            Contact Page
                        </strong>

                        <small>
                            View public contact page
                        </small>

                    </span>

                    <i class="bi bi-box-arrow-up-right"></i>

                </a>


                <!-- SETTINGS -->

                <a
                    href="/admin/settings"
                    class="admin-shortcut-item"
                >

                    <span class="admin-shortcut-icon">
                        <i class="bi bi-sliders2"></i>
                    </span>

                    <span class="admin-shortcut-content">

                        <strong>
                            Website Settings
                        </strong>

                        <small>
                            Manage website content
                        </small>

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </section>


    </div>



    <!-- =====================================================
         ANALYTICS + AVAILABILITY
         ===================================================== -->

    <div class="admin-dashboard-grid admin-dashboard-grid-secondary">


        <!-- =================================================
             VISITOR ANALYTICS
             ================================================= -->

        <section class="admin-dashboard-card admin-analytics-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <span class="admin-card-eyebrow">
                        ANALYTICS
                    </span>

                    <h3>
                        Visitor Overview
                    </h3>

                </div>

                <a
                    href="/admin/visitors"
                    class="admin-card-header-link"
                >
                    View Details
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="admin-chart-wrapper">

                <canvas
                    id="visitorChart"
                    aria-label="Visitor overview chart"
                ></canvas>

            </div>

        </section>



        <!-- =================================================
             AVAILABILITY / STATUS
             ================================================= -->

        <section class="admin-dashboard-card admin-availability-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <span class="admin-card-eyebrow">
                        SYSTEM
                    </span>

                    <h3>
                        Availability
                    </h3>

                </div>

                <span class="admin-card-header-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </span>

            </div>


            <div class="admin-availability-list">


                <!-- WEBSITE -->

                <div class="admin-availability-item">

                    <div class="admin-availability-item-left">

                        <span class="admin-availability-status">
                        </span>

                        <div>

                            <strong>
                                Public Website
                            </strong>

                            <small>
                                Website is accessible
                            </small>

                        </div>

                    </div>

                    <span class="admin-availability-badge">
                        Online
                    </span>

                </div>


                <!-- ADMIN -->

                <div class="admin-availability-item">

                    <div class="admin-availability-item-left">

                        <span class="admin-availability-status">
                        </span>

                        <div>

                            <strong>
                                Admin Panel
                            </strong>

                            <small>
                                Administration system
                            </small>

                        </div>

                    </div>

                    <span class="admin-availability-badge">
                        Active
                    </span>

                </div>


                <!-- DATABASE -->

                <div class="admin-availability-item">

                    <div class="admin-availability-item-left">

                        <span class="admin-availability-status">
                        </span>

                        <div>

                            <strong>
                                Database
                            </strong>

                            <small>
                                MongoDB connection
                            </small>

                        </div>

                    </div>

                    <span class="admin-availability-badge">
                        Connected
                    </span>

                </div>


            </div>

        </section>

    </div>



    <!-- =====================================================
         RECENT PRODUCTS
         ===================================================== -->

    <section class="admin-dashboard-card admin-recent-products">

        <div class="admin-dashboard-card-header">

            <div>

                <span class="admin-card-eyebrow">
                    CATALOG
                </span>

                <h3>
                    Recent Products
                </h3>

            </div>

            <a
                href="/admin/products"
                class="admin-card-header-link"
            >
                View All
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>


        <div class="admin-table-wrapper">

            <table class="admin-dashboard-table">

                <thead>

                    <tr>

                        <th>
                            Product
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Price
                        </th>

                        <th>
                            Availability
                        </th>

                        <th>
                            Featured
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (
                        Array.isArray(recentProducts) &&
                        recentProducts.length
                    ) { %>


                        <% recentProducts.forEach(product => { %>

                            <tr>

                                <!-- PRODUCT -->

                                <td>

                                    <div class="admin-product-table-item">

                                        <% if (
                                            product.images &&
                                            product.images.length
                                        ) { %>

                                            <img
                                                src="<%= product.images[0] %>"
                                                alt="<%= product.name %>"
                                                class="admin-product-table-image"
                                            >

                                        <% } else { %>

                                            <div class="admin-product-table-placeholder">
                                                <i class="bi bi-image"></i>
                                            </div>

                                        <% } %>


                                        <div class="admin-product-table-info">

                                            <strong>
                                                <%= product.name || "Untitled Product" %>
                                            </strong>

                                            <small>
                                                <%= product.technique || "Patola Art" %>
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    <span class="admin-table-category">

                                        <%= product.category || "—" %>

                                    </span>

                                </td>


                                <!-- PRICE -->

                                <td>

                                    <strong class="admin-table-price">

                                        ₹<%= product.price !== undefined &&
                                            product.price !== null
                                            ? Number(product.price).toLocaleString("en-IN")
                                            : "0" %>

                                    </strong>

                                </td>


                                <!-- AVAILABILITY -->

                                <td>

                                    <span
                                        class="admin-availability-pill
                                        <%= String(product.availability || "In Stock")
                                            .toLowerCase()
                                            .replace(/\s+/g, "-") %>"
                                    >

                                        <%= product.availability || "In Stock" %>

                                    </span>

                                </td>


                                <!-- FEATURED -->

                                <td>

                                    <% if (product.featured) { %>

                                        <span class="admin-featured-pill">

                                            <i class="bi bi-star-fill"></i>

                                            Featured

                                        </span>

                                    <% } else { %>

                                        <span class="admin-not-featured-pill">

                                            Standard

                                        </span>

                                    <% } %>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <a
                                        href="/admin/products/edit/<%= product._id %>"
                                        class="admin-table-action"
                                        aria-label="Edit <%= product.name %>"
                                        title="Edit Product"
                                    >

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                </td>

                            </tr>

                        <% }) %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="6"
                                class="admin-dashboard-empty"
                            >

                                <div class="admin-empty-state">

                                    <span class="admin-empty-icon">
                                        <i class="bi bi-bag"></i>
                                    </span>

                                    <strong>
                                        No products yet
                                    </strong>

                                    <small>
                                        Add your first product to get started.
                                    </small>

                                    <a
                                        href="/admin/products/add"
                                        class="admin-empty-action"
                                    >
                                        Add Product
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                </div>

                            </td>

                        </tr>


                    <% } %>

                </tbody>

            </table>

        </div>

    </section>



    <!-- =====================================================
         CUSTOMER ACTIVITY
         ===================================================== -->

    <div class="admin-dashboard-grid admin-dashboard-grid-tertiary">


        <!-- RECENT REVIEWS -->

        <section class="admin-dashboard-card admin-activity-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <span class="admin-card-eyebrow">
                        CUSTOMER ACTIVITY
                    </span>

                    <h3>
                        Recent Reviews
                    </h3>

                </div>

                <a
                    href="/admin/reviews"
                    class="admin-card-header-link"
                >
                    View All
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="admin-activity-list">

                <% if (
                    Array.isArray(recentReviews) &&
                    recentReviews.length
                ) { %>


                    <% recentReviews.forEach(review => { %>

                        <div class="admin-activity-item">

                            <div class="admin-activity-icon admin-review-icon">
                                <i class="bi bi-star-fill"></i>
                            </div>

                            <div class="admin-activity-content">

                                <strong>
                                    <%= review.name ||
                                        review.userName ||
                                        "Customer" %>
                                </strong>

                                <span>

                                    <% const rating =
                                        Number(review.rating || 0); %>

                                    <% for (
                                        let i = 1;
                                        i <= 5;
                                        i++
                                    ) { %>

                                        <i
                                            class="bi <%= i <= rating
                                                ? 'bi-star-fill'
                                                : 'bi-star' %>"
                                        ></i>

                                    <% } %>

                                </span>

                                <small>
                                    <%= review.comment ||
                                        review.message ||
                                        "Customer review" %>
                                </small>

                            </div>

                        </div>

                    <% }) %>


                <% } else { %>


                    <div class="admin-activity-empty">

                        <i class="bi bi-star"></i>

                        <span>
                            No reviews available yet.
                        </span>

                    </div>


                <% } %>

            </div>

        </section>



        <!-- RECENT FEEDBACK -->

        <section class="admin-dashboard-card admin-activity-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <span class="admin-card-eyebrow">
                        CUSTOMER ACTIVITY
                    </span>

                    <h3>
                        Recent Feedback
                    </h3>

                </div>

                <a
                    href="/admin/feedback"
                    class="admin-card-header-link"
                >
                    View All
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="admin-activity-list">

                <% if (
                    Array.isArray(recentFeedback) &&
                    recentFeedback.length
                ) { %>


                    <% recentFeedback.forEach(feedback => { %>

                        <div class="admin-activity-item">

                            <div class="admin-activity-icon admin-feedback-icon">
                                <i class="bi bi-chat-square-text-fill"></i>
                            </div>

                            <div class="admin-activity-content">

                                <strong>
                                    <%= feedback.name ||
                                        feedback.userName ||
                                        "Customer" %>
                                </strong>

                                <small>
                                    <%= feedback.message ||
                                        feedback.feedback ||
                                        feedback.comment ||
                                        "Customer feedback" %>
                                </small>

                            </div>

                        </div>

                    <% }) %>


                <% } else { %>


                    <div class="admin-activity-empty">

                        <i class="bi bi-chat-square-text"></i>

                        <span>
                            No feedback available yet.
                        </span>

                    </div>


                <% } %>

            </div>

        </section>



        <!-- RECENT CONTACTS -->

        <section class="admin-dashboard-card admin-activity-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <span class="admin-card-eyebrow">
                        INQUIRIES
                    </span>

                    <h3>
                        Recent Messages
                    </h3>

                </div>

                <a
                    href="/admin/contacts"
                    class="admin-card-header-link"
                >
                    View All
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="admin-activity-list">

                <% if (
                    Array.isArray(recentContacts) &&
                    recentContacts.length
                ) { %>


                    <% recentContacts.forEach(contact => { %>

                        <div class="admin-activity-item">

                            <div class="admin-activity-icon admin-contact-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </div>

                            <div class="admin-activity-content">

                                <strong>
                                    <%= contact.name ||
                                        contact.fullName ||
                                        "Visitor" %>
                                </strong>

                                <small>
                                    <%= contact.message ||
                                        contact.subject ||
                                        "Contact inquiry" %>
                                </small>

                            </div>

                        </div>

                    <% }) %>


                <% } else { %>


                    <div class="admin-activity-empty">

                        <i class="bi bi-envelope"></i>

                        <span>
                            No contact messages yet.
                        </span>

                    </div>


                <% } %>

            </div>

        </section>

    </div>


</section>