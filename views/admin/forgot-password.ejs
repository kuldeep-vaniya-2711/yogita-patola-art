
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Forgot Password | Yogita Patola Art</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f7f1e8;
            color: #3b3030;
            font-family: "Montserrat", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .reset-card {
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(60, 35, 25, 0.12);
        }

        .reset-header {
            background: #641f2b;
            padding: 34px 28px;
            text-align: center;
        }

        .symbol {
            color: #d8b56a;
            font-size: 25px;
            margin-bottom: 8px;
        }

        .brand {
            color: #d8b56a;
            font-family: "Cormorant Garamond", serif;
            font-size: 30px;
            font-weight: 700;
        }

        .header-text {
            color: #ffffff;
            margin: 7px 0 0;
            font-size: 12px;
            letter-spacing: 1.5px;
        }

        .reset-body {
            padding: 38px 32px;
        }

        h1 {
            margin: 0 0 10px;
            color: #641f2b;
            font-family: "Cormorant Garamond", serif;
            font-size: 34px;
        }

        .description {
            color: #756761;
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 28px;
        }

        .alert {
            padding: 13px 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
            line-height: 1.5;
        }

        .alert-error {
            background: #fff0ef;
            border: 1px solid #edc6c2;
            color: #8c2f28;
        }

        .alert-success {
            background: #eff8f0;
            border: 1px solid #c7dfc9;
            color: #326b38;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #4c3a34;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .4px;
        }

        input {
            width: 100%;
            height: 52px;
            border: 1px solid #d9cec5;
            border-radius: 9px;
            padding: 0 15px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: .2s;
        }

        input:focus {
            border-color: #8b5960;
            box-shadow: 0 0 0 3px rgba(100, 31, 43, .08);
        }

        .field {
            margin-bottom: 20px;
        }

        button {
            width: 100%;
            height: 52px;
            border: 0;
            border-radius: 9px;
            background: #641f2b;
            color: #ffffff;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }

        button:hover {
            background: #4d1720;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #641f2b;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .back:hover {
            text-decoration: underline;
        }

        .note {
            margin-top: 25px;
            padding-top: 18px;
            border-top: 1px solid #eee4d8;
            text-align: center;
            color: #8a7b73;
            font-size: 11px;
        }

        @media (max-width: 520px) {

            body {
                padding: 14px;
            }

            .reset-body {
                padding: 30px 22px;
            }

            h1 {
                font-size: 30px;
            }

        }

    </style>

</head>

<body>

    <main class="reset-card">

        <header class="reset-header">

            <div class="symbol">✦</div>

            <div class="brand">
                Yogita Patola Art
            </div>

            <p class="header-text">
                ADMINISTRATOR PASSWORD RECOVERY
            </p>

        </header>


        <section class="reset-body">

            <h1>
                Forgot Password?
            </h1>

            <p class="description">
                Enter your administrator email address.
                We will send a secure OTP to verify
                your identity and reset your password.
            </p>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="alert alert-error">
                    <%= error %>
                </div>

            <% } %>


            <% if (typeof success !== "undefined" && success) { %>

                <div class="alert alert-success">
                    <%= success %>
                </div>

            <% } %>


            <form
                action="/admin/forgot-password"
                method="POST"
                autocomplete="off"
            >

                <div class="field">

                    <label for="email">
                        ADMIN EMAIL ADDRESS
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your admin email"
                        autocomplete="email"
                        required
                    >

                </div>


                <button type="submit">
                    Send Password Reset OTP
                </button>

            </form>


            <a
                href="/admin/login"
                class="back"
            >
                ← Back to Admin Login
            </a>


            <div class="note">
                Secure administrator password recovery
            </div>

        </section>

    </main>

</body>

</html>

