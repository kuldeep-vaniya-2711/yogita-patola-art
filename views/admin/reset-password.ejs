
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Reset Password | Yogita Patola Art</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f7f1e8;
            color: #3b3030;
            font-family: "Montserrat", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .reset-card {
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(60, 35, 25, 0.12);
        }

        .reset-header {
            background: #641f2b;
            padding: 34px 28px;
            text-align: center;
        }

        .symbol {
            color: #d8b56a;
            font-size: 25px;
            margin-bottom: 8px;
        }

        .brand {
            color: #d8b56a;
            font-family: "Cormorant Garamond", serif;
            font-size: 30px;
            font-weight: 700;
        }

        .header-text {
            color: #ffffff;
            margin: 7px 0 0;
            font-size: 12px;
            letter-spacing: 1.5px;
        }

        .reset-body {
            padding: 38px 32px;
        }

        h1 {
            margin: 0 0 10px;
            color: #641f2b;
            font-family: "Cormorant Garamond", serif;
            font-size: 34px;
        }

        .description {
            color: #756761;
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 28px;
        }

        .alert {
            padding: 13px 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
            line-height: 1.5;
        }

        .alert-error {
            background: #fff0ef;
            border: 1px solid #edc6c2;
            color: #8c2f28;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #4c3a34;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .4px;
        }

        .field {
            margin-bottom: 20px;
        }

        .password-wrap {
            position: relative;
        }

        input {
            width: 100%;
            height: 52px;
            border: 1px solid #d9cec5;
            border-radius: 9px;
            padding: 0 52px 0 15px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        input:focus {
            border-color: #8b5960;
            box-shadow: 0 0 0 3px rgba(100, 31, 43, .08);
        }

        .toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border: 0;
            background: transparent;
            color: #641f2b;
            cursor: pointer;
            font-size: 16px;
        }

        .hint {
            margin-top: 7px;
            color: #8a7b73;
            font-size: 11px;
        }

        .reset-button {
            width: 100%;
            height: 52px;
            border: 0;
            border-radius: 9px;
            background: #641f2b;
            color: #ffffff;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .reset-button:hover {
            background: #4d1720;
        }

        .note {
            margin-top: 25px;
            padding-top: 18px;
            border-top: 1px solid #eee4d8;
            text-align: center;
            color: #8a7b73;
            font-size: 11px;
        }

        @media (max-width: 520px) {

            body {
                padding: 14px;
            }

            .reset-body {
                padding: 30px 22px;
            }

            h1 {
                font-size: 30px;
            }

        }

    </style>

</head>

<body>

    <main class="reset-card">

        <header class="reset-header">

            <div class="symbol">✦</div>

            <div class="brand">
                Yogita Patola Art
            </div>

            <p class="header-text">
                CREATE NEW ADMIN PASSWORD
            </p>

        </header>


        <section class="reset-body">

            <h1>
                Reset Password
            </h1>

            <p class="description">
                Your OTP has been verified.
                Create a new secure password for
                your administrator account.
            </p>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="alert alert-error">
                    <%= error %>
                </div>

            <% } %>


            <form
                action="/admin/reset-password"
                method="POST"
                autocomplete="off"
            >

                <div class="field">

                    <label for="password">
                        NEW PASSWORD
                    </label>

                    <div class="password-wrap">

                        <input
                            type="password"
                            id="password"
                            name="password"
                            minlength="8"
                            placeholder="Enter new password"
                            autocomplete="new-password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle"
                            data-target="password"
                            aria-label="Show password"
                        >
                            ◉
                        </button>

                    </div>

                    <div class="hint">
                        Minimum 8 characters.
                    </div>

                </div>


                <div class="field">

                    <label for="confirmPassword">
                        CONFIRM NEW PASSWORD
                    </label>

                    <div class="password-wrap">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            minlength="8"
                            placeholder="Confirm new password"
                            autocomplete="new-password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle"
                            data-target="confirmPassword"
                            aria-label="Show password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <button
                    type="submit"
                    class="reset-button"
                >
                    Reset Admin Password
                </button>

            </form>


            <div class="note">
                After resetting your password, you will
                need to sign in again.
            </div>

        </section>

    </main>


    <script>

        document
            .querySelectorAll(".toggle")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        const input =
                            document.getElementById(
                                this.dataset.target
                            );

                        if (!input) {
                            return;
                        }

                        const isPassword =
                            input.type === "password";

                        input.type =
                            isPassword
                                ? "text"
                                : "password";

                        this.setAttribute(
                            "aria-label",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );

                    }
                );

            });


        const password =
            document.getElementById(
                "password"
            );

        const confirmPassword =
            document.getElementById(
                "confirmPassword"
            );


        if (
            password &&
            confirmPassword
        ) {

            confirmPassword.addEventListener(
                "input",
                function () {

                    if (
                        this.value &&
                        this.value !== password.value
                    ) {

                        this.setCustomValidity(
                            "Passwords do not match."
                        );

                    } else {

                        this.setCustomValidity(
                            ""
                        );

                    }

                }
            );

        }

    </script>

</body>

</html>
