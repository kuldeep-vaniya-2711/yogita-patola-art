<%
    /*
     * =========================================================
     * ADMIN PRODUCTS PAGE
     * =========================================================
     */

    layout("layout", {
        title: title || "Products",
        pageTitle: "Products",
        pageCss: "/css/admin/products.css"
    });
%>


<%
    /*
     * =========================================================
     * SAFE PRODUCT DATA
     * =========================================================
     */

    const productList =
        typeof products !== "undefined" &&
        Array.isArray(products)
            ? products
            : [];


    const categories = [
        ...new Set(
            productList
                .map(function(product) {
                    return product && product.category
                        ? product.category
                        : null;
                })
                .filter(Boolean)
        )
    ];


    const totalProducts =
        productList.length;


    const inStockProducts =
        productList.filter(function(product) {

            return String(
                product && product.availability
                    ? product.availability
                    : "In Stock"
            )
            .toLowerCase() === "in stock";

        }).length;


    const featuredProducts =
        productList.filter(function(product) {

            return product &&
                product.featured === true;

        }).length;


    const visibleProducts =
        productList.filter(function(product) {

            return String(
                product && product.availability
                    ? product.availability
                    : "In Stock"
            )
            .toLowerCase() !== "hidden";

        }).length;
%>



<!-- =========================================================
     PRODUCTS PAGE
========================================================= -->

<div class="admin-products-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="products-page-header">


        <div class="products-header-content">

            <span class="products-eyebrow">
                PRODUCT MANAGEMENT
            </span>


            <h1 class="admin-page-title">
                Products
            </h1>


            <p class="admin-page-description">
                Manage your handcrafted Patola collection.
            </p>

        </div>



        <a
            href="/admin/products/add"
            class="admin-btn admin-btn-primary products-add-btn"
        >

            <i class="bi bi-plus-lg"></i>

            <span>
                Add Product
            </span>

        </a>


    </section>



    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <section class="products-stats-grid">


        <!-- TOTAL -->

        <div class="product-stat-card">

            <div class="product-stat-icon">

                <i class="bi bi-box-seam"></i>

            </div>


            <div class="product-stat-content">

                <span>
                    Total Products
                </span>


                <strong id="totalProducts">
                    <%= totalProducts %>
                </strong>

            </div>

        </div>



        <!-- IN STOCK -->

        <div class="product-stat-card">

            <div class="product-stat-icon success">

                <i class="bi bi-check-circle"></i>

            </div>


            <div class="product-stat-content">

                <span>
                    In Stock
                </span>


                <strong id="inStockProducts">
                    <%= inStockProducts %>
                </strong>

            </div>

        </div>



        <!-- FEATURED -->

        <div class="product-stat-card">

            <div class="product-stat-icon warning">

                <i class="bi bi-star"></i>

            </div>


            <div class="product-stat-content">

                <span>
                    Featured
                </span>


                <strong id="featuredProducts">
                    <%= featuredProducts %>
                </strong>

            </div>

        </div>



        <!-- VISIBLE -->

        <div class="product-stat-card">

            <div class="product-stat-icon gold">

                <i class="bi bi-eye"></i>

            </div>


            <div class="product-stat-content">

                <span>
                    Visible
                </span>


                <strong id="visibleProducts">
                    <%= visibleProducts %>
                </strong>

            </div>

        </div>


    </section>



    <!-- =====================================================
         FILTER TOOLBAR
    ====================================================== -->

    <section class="products-toolbar">


        <!-- SEARCH -->

        <div class="products-search">

            <i class="bi bi-search"></i>


            <input
                type="search"
                id="productSearch"
                placeholder="Search products..."
                autocomplete="off"
            >

        </div>



        <!-- CATEGORY -->

        <div class="products-filter">

            <select
                id="categoryFilter"
                class="form-select"
            >

                <option value="all">
                    All Categories
                </option>


                <% categories.forEach(function(category) { %>

                    <option
                        value="<%= String(category).toLowerCase() %>"
                    >
                        <%= category %>
                    </option>

                <% }); %>

            </select>

        </div>



        <!-- AVAILABILITY -->

        <div class="products-filter">

            <select
                id="availabilityFilter"
                class="form-select"
            >

                <option value="all">
                    All Availability
                </option>


                <option value="in stock">
                    In Stock
                </option>


                <option value="limited">
                    Limited
                </option>


                <option value="out of stock">
                    Out of Stock
                </option>


                <option value="hidden">
                    Hidden
                </option>

            </select>

        </div>



        <!-- RESET -->

        <button
            type="button"
            id="resetFilters"
            class="products-reset-btn"
        >

            <i class="bi bi-arrow-counterclockwise"></i>

            <span>
                Reset
            </span>

        </button>


    </section>



    <!-- =====================================================
         RESULT BAR
    ====================================================== -->

    <section class="products-result-bar">


        <div class="products-result-count">

            Showing

            <strong id="visibleProductCount">
                <%= totalProducts %>
            </strong>

            products

        </div>


        <div
            id="filterStatus"
            class="filter-status"
        >
            All products
        </div>


    </section>



    <!-- =====================================================
         PRODUCTS TABLE
    ====================================================== -->

    <section class="admin-table-wrapper products-table-wrapper">


        <div class="products-table-scroll">

            <table
                class="admin-table products-table"
                id="productsTable"
            >


                <thead>

                    <tr>

                        <th>
                            Product
                        </th>


                        <th>
                            Category
                        </th>


                        <th>
                            Price
                        </th>


                        <th>
                            Availability
                        </th>


                        <th>
                            Featured
                        </th>


                        <th>
                            Images
                        </th>


                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>



                <tbody id="productsTableBody">


                    <% if (productList.length > 0) { %>


                        <% productList.forEach(function(product) { %>


                            <%

                                const safeProduct =
                                    product || {};


                                const availability =
                                    String(
                                        safeProduct.availability ||
                                        "In Stock"
                                    ).toLowerCase();


                                const category =
                                    String(
                                        safeProduct.category ||
                                        ""
                                    ).toLowerCase();


                                const productName =
                                    String(
                                        safeProduct.name ||
                                        ""
                                    ).toLowerCase();


                                const availabilityClass =
                                    availability === "out of stock"
                                        ? "admin-status-danger"
                                        : availability === "hidden"
                                            ? "admin-status-muted"
                                            : availability === "limited"
                                                ? "admin-status-warning"
                                                : "admin-status-success";


                                const images =
                                    Array.isArray(
                                        safeProduct.images
                                    )
                                        ? safeProduct.images
                                        : [];


                                const firstImage =
                                    images.length > 0
                                        ? images[0]
                                        : null;

                            %>



                            <tr
                                class="product-row"
                                data-name="<%= productName %>"
                                data-category="<%= category %>"
                                data-availability="<%= availability %>"
                            >


                                <!-- =================================
                                     PRODUCT
                                ================================== -->

                                <td data-label="Product">

                                    <div class="product-table-info">


                                        <div class="product-table-image">


                                            <% if (firstImage) { %>

                                                <img
                                                    src="<%= firstImage %>"
                                                    alt="<%= safeProduct.name || 'Product' %>"
                                                    loading="lazy"
                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                                >

                                                <div
                                                    class="product-no-image"
                                                    style="display:none;"
                                                >

                                                    <i class="bi bi-image"></i>

                                                </div>

                                            <% } else { %>

                                                <div class="product-no-image">

                                                    <i class="bi bi-image"></i>

                                                </div>

                                            <% } %>


                                        </div>



                                        <div class="product-table-details">


                                            <strong>
                                                <%= safeProduct.name || "Unnamed Product" %>
                                            </strong>


                                            <% if (safeProduct.fabric) { %>

                                                <small>
                                                    <%= safeProduct.fabric %>
                                                </small>

                                            <% } %>


                                        </div>


                                    </div>

                                </td>



                                <!-- =================================
                                     CATEGORY
                                ================================== -->

                                <td data-label="Category">

                                    <span class="product-category-badge">

                                        <%= safeProduct.category || "Uncategorized" %>

                                    </span>

                                </td>



                                <!-- =================================
                                     PRICE
                                ================================== -->

                                <td data-label="Price">

                                    <strong class="product-price">

                                        ₹<%= Number(
                                            safeProduct.price || 0
                                        ).toLocaleString("en-IN") %>

                                    </strong>

                                </td>



                                <!-- =================================
                                     AVAILABILITY
                                ================================== -->

                                <td data-label="Availability">


                                    <span
                                        class="admin-status <%= availabilityClass %>"
                                    >


                                        <% if (availability === "in stock") { %>

                                            <i class="bi bi-check-circle"></i>


                                        <% } else if (availability === "limited") { %>

                                            <i class="bi bi-exclamation-circle"></i>


                                        <% } else if (availability === "out of stock") { %>

                                            <i class="bi bi-x-circle"></i>


                                        <% } else { %>

                                            <i class="bi bi-eye-slash"></i>

                                        <% } %>


                                        <%= safeProduct.availability || "In Stock" %>


                                    </span>


                                </td>



                                <!-- =================================
                                     FEATURED
                                ================================== -->

                                <td data-label="Featured">


                                    <% if (
                                        safeProduct.featured === true
                                    ) { %>


                                        <span class="featured-badge active">

                                            <i class="bi bi-star-fill"></i>

                                            Featured

                                        </span>


                                    <% } else { %>


                                        <span class="featured-badge">

                                            <i class="bi bi-star"></i>

                                            No

                                        </span>


                                    <% } %>


                                </td>



                                <!-- =================================
                                     IMAGES
                                ================================== -->

                                <td data-label="Images">

                                    <div class="product-image-count">

                                        <i class="bi bi-images"></i>

                                        <%= images.length %>

                                    </div>

                                </td>



                                <!-- =================================
                                     ACTIONS
                                ================================== -->

                                <td
                                    data-label="Actions"
                                    class="products-actions-cell"
                                >


                                    <div class="product-actions">


                                        <!-- VIEW -->

                                        <a
                                            href="/products/<%= safeProduct._id %>"
                                            class="product-action-btn view"
                                            title="View Product"
                                            aria-label="View Product"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >

                                            <i class="bi bi-eye"></i>

                                        </a>



                                        <!-- EDIT -->

                                        <a
                                            href="/admin/products/edit/<%= safeProduct._id %>"
                                            class="product-action-btn edit"
                                            title="Edit Product"
                                            aria-label="Edit Product"
                                        >

                                            <i class="bi bi-pencil"></i>

                                        </a>



                                        <!-- DELETE -->

                                        <button
                                            type="button"
                                            class="product-action-btn delete delete-product-trigger"
                                            title="Delete Product"
                                            aria-label="Delete Product"
                                            data-id="<%= safeProduct._id %>"
                                            data-name="<%= safeProduct.name || 'this product' %>"
                                        >

                                            <i class="bi bi-trash3"></i>

                                        </button>



                                        <form
                                            id="deleteProductForm-<%= safeProduct._id %>"
                                            action="/admin/products/delete/<%= safeProduct._id %>"
                                            method="POST"
                                            class="delete-product-form"
                                        ></form>


                                    </div>


                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <!-- =========================================
                             NO PRODUCTS
                        ========================================== -->

                        <tr id="initialEmptyRow">

                            <td
                                colspan="7"
                                class="products-empty-cell"
                            >


                                <div class="products-empty-state">


                                    <div class="products-empty-icon">

                                        <i class="bi bi-box-seam"></i>

                                    </div>


                                    <h3>
                                        No Products Yet
                                    </h3>


                                    <p>
                                        Start building your collection
                                        by adding your first handcrafted
                                        product.
                                    </p>


                                    <a
                                        href="/admin/products/add"
                                        class="admin-btn admin-btn-primary"
                                    >

                                        <i class="bi bi-plus-lg"></i>

                                        Add First Product

                                    </a>


                                </div>


                            </td>

                        </tr>


                    <% } %>


                </tbody>


            </table>

        </div>



        <!-- =====================================================
             FILTER EMPTY STATE
        ====================================================== -->

        <div
            id="filterEmptyState"
            class="products-filter-empty"
            style="display:none;"
        >


            <div class="products-empty-icon">

                <i class="bi bi-search"></i>

            </div>


            <h3>
                No Matching Products
            </h3>


            <p>
                Try changing your search or filter.
            </p>


            <button
                type="button"
                id="clearFiltersFromEmpty"
                class="admin-btn admin-btn-outline"
            >
                Clear Filters
            </button>


        </div>


    </section>


</div>



<!-- =========================================================
     DELETE PRODUCT MODAL
========================================================= -->

<div
    class="modal fade"
    id="deleteProductModal"
    tabindex="-1"
    aria-hidden="true"
>


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content product-delete-modal">


            <div class="modal-header">


                <div class="delete-modal-icon">

                    <i class="bi bi-trash3"></i>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>


            </div>



            <div class="modal-body">


                <h4>
                    Delete Product?
                </h4>


                <p>

                    Are you sure you want to delete

                    <strong id="deleteProductName">
                        this product
                    </strong>?

                    This action cannot be undone.

                </p>


            </div>



            <div class="modal-footer">


                <button
                    type="button"
                    class="admin-btn admin-btn-outline"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    id="confirmDeleteProduct"
                    class="admin-btn delete-confirm-btn"
                >
                    Delete Product
                </button>


            </div>


        </div>


    </div>


</div>



<!-- =========================================================
     PRODUCTS JAVASCRIPT
========================================================= -->

<% block("scripts").append(`

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ==================================================
           ELEMENTS
        ================================================== */

        const search =
            document.getElementById(
                "productSearch"
            );


        const categoryFilter =
            document.getElementById(
                "categoryFilter"
            );


        const availabilityFilter =
            document.getElementById(
                "availabilityFilter"
            );


        const resetButton =
            document.getElementById(
                "resetFilters"
            );


        const clearEmptyButton =
            document.getElementById(
                "clearFiltersFromEmpty"
            );


        const rows =
            Array.from(
                document.querySelectorAll(
                    ".product-row"
                )
            );


        const visibleCount =
            document.getElementById(
                "visibleProductCount"
            );


        const filterStatus =
            document.getElementById(
                "filterStatus"
            );


        const filterEmpty =
            document.getElementById(
                "filterEmptyState"
            );



        /* ==================================================
           FILTER PRODUCTS
        ================================================== */

        function filterProducts() {


            const query =
                String(
                    search
                        ? search.value
                        : ""
                )
                .trim()
                .toLowerCase();


            const category =
                String(
                    categoryFilter
                        ? categoryFilter.value
                        : "all"
                )
                .toLowerCase();


            const availability =
                String(
                    availabilityFilter
                        ? availabilityFilter.value
                        : "all"
                )
                .toLowerCase();


            let visible = 0;


            rows.forEach(
                function (row) {


                    const name =
                        String(
                            row.dataset.name || ""
                        )
                        .toLowerCase();


                    const rowCategory =
                        String(
                            row.dataset.category || ""
                        )
                        .toLowerCase();


                    const rowAvailability =
                        String(
                            row.dataset.availability || ""
                        )
                        .toLowerCase();


                    const matchesSearch =
                        !query ||
                        name.includes(query);


                    const matchesCategory =
                        category === "all" ||
                        rowCategory === category;


                    const matchesAvailability =
                        availability === "all" ||
                        rowAvailability === availability;


                    const shouldShow =
                        matchesSearch &&
                        matchesCategory &&
                        matchesAvailability;


                    row.classList.toggle(
                        "product-row-hidden",
                        !shouldShow
                    );


                    if (shouldShow) {

                        visible++;

                    }

                }
            );


            if (visibleCount) {

                visibleCount.textContent =
                    visible;

            }


            if (filterEmpty) {

                filterEmpty.style.display =
                    rows.length > 0 &&
                    visible === 0
                        ? "block"
                        : "none";

            }


            updateFilterStatus(
                query,
                category,
                availability
            );

        }



        /* ==================================================
           FILTER STATUS
        ================================================== */

        function updateFilterStatus(
            query,
            category,
            availability
        ) {


            if (!filterStatus) {

                return;

            }


            const activeFilters = [];


            if (query) {

                activeFilters.push(
                    'Search: "' +
                    query +
                    '"'
                );

            }


            if (category !== "all") {

                activeFilters.push(
                    "Category: " +
                    category
                );

            }


            if (availability !== "all") {

                activeFilters.push(
                    "Availability: " +
                    availability
                );

            }


            filterStatus.textContent =
                activeFilters.length > 0
                    ? activeFilters.join(" • ")
                    : "All products";

        }



        /* ==================================================
           RESET FILTERS
        ================================================== */

        function resetFilters() {


            if (search) {

                search.value = "";

            }


            if (categoryFilter) {

                categoryFilter.value =
                    "all";

            }


            if (availabilityFilter) {

                availabilityFilter.value =
                    "all";

            }


            filterProducts();


            if (search) {

                search.focus();

            }

        }



        if (search) {

            search.addEventListener(
                "input",
                filterProducts
            );

        }


        if (categoryFilter) {

            categoryFilter.addEventListener(
                "change",
                filterProducts
            );

        }


        if (availabilityFilter) {

            availabilityFilter.addEventListener(
                "change",
                filterProducts
            );

        }


        if (resetButton) {

            resetButton.addEventListener(
                "click",
                resetFilters
            );

        }


        if (clearEmptyButton) {

            clearEmptyButton.addEventListener(
                "click",
                resetFilters
            );

        }



        /* ==================================================
           DELETE MODAL
        ================================================== */

        let selectedDeleteForm = null;


        const deleteModalElement =
            document.getElementById(
                "deleteProductModal"
            );


        const deleteProductName =
            document.getElementById(
                "deleteProductName"
            );


        const confirmDelete =
            document.getElementById(
                "confirmDeleteProduct"
            );


        let deleteModal = null;


        if (
            deleteModalElement &&
            typeof bootstrap !== "undefined"
        ) {

            deleteModal =
                new bootstrap.Modal(
                    deleteModalElement
                );

        }



        /* ==================================================
           DELETE BUTTONS
        ================================================== */

        document
            .querySelectorAll(
                ".delete-product-trigger"
            )
            .forEach(
                function (button) {


                    button.addEventListener(
                        "click",
                        function () {


                            const id =
                                button.dataset.id;


                            const name =
                                button.dataset.name ||
                                "this product";


                            selectedDeleteForm =
                                document.getElementById(
                                    "deleteProductForm-" +
                                    id
                                );


                            if (deleteProductName) {

                                deleteProductName.textContent =
                                    name;

                            }


                            if (deleteModal) {

                                deleteModal.show();

                            } else {


                                const confirmed =
                                    window.confirm(
                                        'Are you sure you want to delete "' +
                                        name +
                                        '"?'
                                    );


                                if (
                                    confirmed &&
                                    selectedDeleteForm
                                ) {

                                    selectedDeleteForm.submit();

                                }

                            }

                        }
                    );

                }
            );



        /* ==================================================
           CONFIRM DELETE
        ================================================== */

        if (confirmDelete) {


            confirmDelete.addEventListener(
                "click",
                function () {


                    if (!selectedDeleteForm) {

                        return;

                    }


                    confirmDelete.disabled =
                        true;


                    confirmDelete.textContent =
                        "Deleting...";


                    selectedDeleteForm.submit();

                }
            );

        }



        /* ==================================================
           INITIAL FILTER
        ================================================== */

        filterProducts();


    }
);

</script>

`); %>