<%
layout("admin/layout", {
title: "Products",
pageTitle: "Products",
pageCss: "/css/admin/products.css",
pageJs: "/js/admin/products.js"
});
%>

<section class="admin-products-page">

```
<div class="products-page-header">

    <div>
        <span class="products-eyebrow">
            CATALOG MANAGEMENT
        </span>

        <h2 class="admin-page-title">
            Products
        </h2>

        <p class="admin-page-description">
            Manage your Patola products, pricing, images and featured collections.
        </p>
    </div>

    <a
        href="/admin/products/add"
        class="admin-btn"
    >
        <i class="bi bi-plus-lg"></i>
        Add Product
    </a>

</div>


<div class="products-stats-grid">

    <div class="product-stat-card">

        <div class="product-stat-icon">
            <i class="bi bi-bag-fill"></i>
        </div>

        <div class="product-stat-content">
            <span>Total Products</span>

            <strong>
                <%= Array.isArray(products) ? products.length : 0 %>
            </strong>
        </div>

    </div>


    <div class="product-stat-card">

        <div class="product-stat-icon warning">
            <i class="bi bi-star-fill"></i>
        </div>

        <div class="product-stat-content">
            <span>Featured</span>

            <strong>
                <%= Array.isArray(products)
                    ? products.filter(function(product) {
                        return product && product.featured === true;
                    }).length
                    : 0
                %>
            </strong>
        </div>

    </div>


    <div class="product-stat-card">

        <div class="product-stat-icon gold">
            <i class="bi bi-grid-fill"></i>
        </div>

        <div class="product-stat-content">
            <span>Categories</span>

            <strong>
                <%= Array.isArray(products)
                    ? new Set(
                        products
                            .map(function(product) {
                                return product && product.category
                                    ? String(product.category).trim()
                                    : "";
                            })
                            .filter(function(category) {
                                return category !== "";
                            })
                    ).size
                    : 0
                %>
            </strong>
        </div>

    </div>


    <div class="product-stat-card">

        <div class="product-stat-icon success">
            <i class="bi bi-box-seam-fill"></i>
        </div>

        <div class="product-stat-content">
            <span>Regular Products</span>

            <strong>
                <%= Array.isArray(products)
                    ? products.filter(function(product) {
                        return !product || product.featured !== true;
                    }).length
                    : 0
                %>
            </strong>
        </div>

    </div>

</div>


<div class="products-toolbar">

    <div class="products-search">

        <i class="bi bi-search"></i>

        <input
            type="search"
            id="productSearch"
            placeholder="Search products..."
            autocomplete="off"
        >

    </div>


    <div class="products-filter">

        <select id="categoryFilter">

            <option value="all">
                All Categories
            </option>

            <% if (Array.isArray(products)) { %>

                <%
                    const categories = [
                        ...new Set(
                            products
                                .map(function(product) {
                                    return product && product.category
                                        ? String(product.category).trim()
                                        : "";
                                })
                                .filter(function(category) {
                                    return category !== "";
                                })
                        )
                    ].sort();
                %>

                <% categories.forEach(function(category) { %>

                    <option value="<%= category.toLowerCase() %>">
                        <%= category %>
                    </option>

                <% }); %>

            <% } %>

        </select>

    </div>


    <div class="products-filter">

        <select id="availabilityFilter">

            <option value="all">
                All Products
            </option>

            <option value="featured">
                Featured
            </option>

            <option value="regular">
                Regular
            </option>

        </select>

    </div>


    <button
        type="button"
        id="resetFilters"
        class="products-reset-btn"
    >
        <i class="bi bi-arrow-counterclockwise"></i>
        Reset
    </button>

</div>


<div class="products-result-bar">

    <div>
        Showing
        <strong id="visibleProductCount">
            <%= Array.isArray(products) ? products.length : 0 %>
        </strong>
        products
    </div>

    <div
        id="filterStatus"
        class="filter-status"
    >
        All products
    </div>

</div>


<div
    id="productsTable"
    class="products-table-wrapper"
>

    <table class="products-table">

        <thead>

            <tr>

                <th>Product</th>
                <th>Category</th>
                <th>Price</th>
                <th>Availability</th>
                <th>Featured</th>
                <th>Images</th>
                <th>Actions</th>

            </tr>

        </thead>


        <tbody>

            <% if (Array.isArray(products) && products.length > 0) { %>

                <% products.forEach(function(product) { %>

                    <%
                        const productId =
                            product && product._id
                                ? String(product._id)
                                : "";

                        const productName =
                            product && product.name
                                ? String(product.name)
                                : "Untitled Product";

                        const productCategory =
                            product && product.category
                                ? String(product.category)
                                : "Other";

                        const productPrice =
                            product && product.price !== undefined
                                ? Number(product.price)
                                : 0;

                        const productImages =
                            product && Array.isArray(product.images)
                                ? product.images
                                : [];

                        const firstImage =
                            productImages.length
                                ? productImages[0]
                                : "";

                        const isFeatured =
                            product && product.featured === true;

                        const availability =
                            product && (
                                product.available === false ||
                                product.availability === false ||
                                product.stock === 0
                            )
                                ? "unavailable"
                                : "available";
                    %>


                    <tr
                        class="product-row"
                        data-name="<%= productName.toLowerCase() %>"
                        data-category="<%= productCategory.toLowerCase() %>"
                        data-availability="<%= isFeatured ? 'featured' : 'regular' %>"
                    >


                        <td>

                            <div class="product-table-info">

                                <div class="product-table-image">

                                    <% if (firstImage) { %>

                                        <img
                                            src="<%= firstImage %>"
                                            alt="<%= productName %>"
                                            loading="lazy"
                                        >

                                    <% } else { %>

                                        <div class="product-no-image">
                                            <i class="bi bi-image"></i>
                                        </div>

                                    <% } %>

                                </div>


                                <div class="product-table-details">

                                    <strong>
                                        <%= productName %>
                                    </strong>

                                    <small>
                                        ID: <%= productId %>
                                    </small>

                                </div>

                            </div>

                        </td>


                        <td>

                            <span class="product-category-badge">
                                <%= productCategory %>
                            </span>

                        </td>


                        <td>

                            <span class="product-price">
                                ₹<%= productPrice.toLocaleString("en-IN") %>
                            </span>

                        </td>


                        <td>

                            <% if (availability === "available") { %>

                                <span class="admin-status admin-status-success">
                                    Available
                                </span>

                            <% } else { %>

                                <span class="admin-status admin-status-danger">
                                    Unavailable
                                </span>

                            <% } %>

                        </td>


                        <td>

                            <% if (isFeatured) { %>

                                <span class="featured-badge active">
                                    Featured
                                </span>

                            <% } else { %>

                                <span class="featured-badge">
                                    Regular
                                </span>

                            <% } %>

                        </td>


                        <td>

                            <span class="product-image-count">
                                <i class="bi bi-images"></i>
                                <%= productImages.length %>
                            </span>

                        </td>


                        <td>

                            <div class="product-actions">

                                <a
                                    href="/products/<%= productId %>"
                                    class="product-action-btn view"
                                    title="View Product"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <i class="bi bi-eye"></i>
                                </a>


                                <a
                                    href="/admin/products/edit/<%= productId %>"
                                    class="product-action-btn edit"
                                    title="Edit Product"
                                >
                                    <i class="bi bi-pencil-square"></i>
                                </a>


                                <form
                                    method="POST"
                                    action="/admin/products/delete/<%= productId %>"
                                    class="delete-product-form"
                                >

                                    <button
                                        type="submit"
                                        class="product-action-btn delete"
                                        title="Delete Product"
                                    >
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                <% }); %>

            <% } else { %>

                <tr>

                    <td
                        colspan="7"
                        class="products-empty-cell"
                    >

                        <div class="products-empty-state">

                            <div class="products-empty-icon">
                                <i class="bi bi-bag-x"></i>
                            </div>

                            <h3>
                                No Products Yet
                            </h3>

                            <p>
                                Your product collection is currently empty.
                                Add your first Patola product to get started.
                            </p>

                            <a
                                href="/admin/products/add"
                                class="admin-btn"
                            >
                                <i class="bi bi-plus-lg"></i>
                                Add Your First Product
                            </a>

                        </div>

                    </td>

                </tr>

            <% } %>

        </tbody>

    </table>

</div>


<div
    id="filterEmptyState"
    class="products-filter-empty"
    style="display: none;"
>

    <h3>
        No Products Found
    </h3>

    <p>
        Try changing your search or filter.
    </p>

    <button
        type="button"
        class="admin-btn-outline"
        id="clearFiltersFromEmpty"
    >
        Clear Filters
    </button>

</div>
```

</section>

<div
    class="modal fade"
    id="deleteProductModal"
    tabindex="-1"
    aria-hidden="true"
>

```
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content product-delete-modal">

        <div class="modal-header">

            <div class="delete-modal-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
            ></button>

        </div>


        <div class="modal-body">

            <h4>
                Delete Product?
            </h4>

            <p>
                Are you sure you want to delete
                <strong id="deleteProductName">
                    this product
                </strong>?
                <br>
                This action cannot be undone.
            </p>

        </div>


        <div class="modal-footer">

            <button
                type="button"
                class="admin-btn-outline"
                data-bs-dismiss="modal"
            >
                Cancel
            </button>

            <button
                type="button"
                class="delete-confirm-btn"
                id="confirmDeleteProduct"
            >
                <i class="bi bi-trash3"></i>
                Delete Product
            </button>

        </div>

    </div>

</div>
```

</div>
