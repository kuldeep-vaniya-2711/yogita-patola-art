<!-- =========================================================
     PAGE-SPECIFIC JAVASCRIPT
========================================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const searchInput =
        document.getElementById("reviewSearch");

    const statusFilter =
        document.getElementById("reviewStatusFilter");

    const ratingFilter =
        document.getElementById("reviewRatingFilter");

    const reviewRows =
        document.querySelectorAll(".review-row");

    const noResults =
        document.getElementById("noReviewResults");


    /* =====================================================
       FILTER REVIEWS
    ====================================================== */

    function filterReviews() {

        const searchValue =
            searchInput
                ? searchInput.value
                    .trim()
                    .toLowerCase()
                : "";

        const statusValue =
            statusFilter
                ? statusFilter.value
                : "all";

        const ratingValue =
            ratingFilter
                ? ratingFilter.value
                : "all";


        let visibleCount = 0;


        reviewRows.forEach(row => {

            const name =
                row.dataset.name || "";

            const email =
                row.dataset.email || "";

            const product =
                row.dataset.product || "";

            const rating =
                row.dataset.rating || "";

            const status =
                row.dataset.status || "";


            const matchesSearch =
                !searchValue ||
                name.includes(searchValue) ||
                email.includes(searchValue) ||
                product.includes(searchValue);


            const matchesStatus =
                statusValue === "all" ||
                status === statusValue;


            const matchesRating =
                ratingValue === "all" ||
                rating === ratingValue;


            const shouldShow =
                matchesSearch &&
                matchesStatus &&
                matchesRating;


            if (shouldShow) {

                row.style.display = "";

                visibleCount++;

            } else {

                row.style.display = "none";

            }

        });


        if (noResults) {

            if (
                reviewRows.length > 0 &&
                visibleCount === 0
            ) {

                noResults.classList.remove("d-none");

            } else {

                noResults.classList.add("d-none");

            }

        }

    }


    if (searchInput) {

        searchInput.addEventListener(
            "input",
            filterReviews
        );

    }


    if (statusFilter) {

        statusFilter.addEventListener(
            "change",
            filterReviews
        );

    }


    if (ratingFilter) {

        ratingFilter.addEventListener(
            "change",
            filterReviews
        );

    }


    /* =====================================================
       DELETE CONFIRMATION
    ====================================================== */

    const deleteForms =
        document.querySelectorAll(
            ".delete-review-form"
        );


    deleteForms.forEach(form => {

        form.addEventListener(
            "submit",
            function (event) {

                const confirmed =
                    confirm(
                        "Are you sure you want to delete this review?"
                    );


                if (!confirmed) {

                    event.preventDefault();

                }

            }
        );

    });


    /* =====================================================
       REVIEW MODAL
    ====================================================== */

    const reviewModal =
        document.getElementById("reviewModal");


    if (reviewModal) {

        reviewModal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button =
                    event.relatedTarget;


                if (!button) return;


                const name =
                    button.dataset.reviewName ||
                    "Anonymous";


                const email =
                    button.dataset.reviewEmail ||
                    "-";


                const product =
                    button.dataset.reviewProduct ||
                    "-";


                const rating =
                    Number(
                        button.dataset.reviewRating
                    ) || 0;


                const message =
                    button.dataset.reviewMessage ||
                    "-";


                const status =
                    button.dataset.reviewStatus ||
                    "-";


                const date =
                    button.dataset.reviewDate ||
                    "-";


                const modalName =
                    document.getElementById(
                        "modalCustomerName"
                    );


                const modalEmail =
                    document.getElementById(
                        "modalCustomerEmail"
                    );


                const modalProduct =
                    document.getElementById(
                        "modalProductName"
                    );


                const modalRating =
                    document.getElementById(
                        "modalRating"
                    );


                const modalMessage =
                    document.getElementById(
                        "modalReviewMessage"
                    );


                const modalStatus =
                    document.getElementById(
                        "modalReviewStatus"
                    );


                const modalDate =
                    document.getElementById(
                        "modalReviewDate"
                    );


                const modalInitial =
                    document.getElementById(
                        "modalCustomerInitial"
                    );


                if (modalName) {

                    modalName.textContent =
                        name;

                }


                if (modalEmail) {

                    modalEmail.textContent =
                        email;

                }


                if (modalProduct) {

                    modalProduct.textContent =
                        product;

                }


                if (modalMessage) {

                    modalMessage.textContent =
                        message;

                }


                if (modalStatus) {

                    modalStatus.textContent =
                        status;

                }


                if (modalDate) {

                    modalDate.textContent =
                        date;

                }


                if (modalInitial) {

                    modalInitial.textContent =
                        name
                            .charAt(0)
                            .toUpperCase();

                }


                if (modalRating) {

                    let stars = "";

                    for (
                        let i = 1;
                        i <= 5;
                        i++
                    ) {

                        if (i <= rating) {

                            stars +=
                                '<i class="bi bi-star-fill"></i>';

                        } else {

                            stars +=
                                '<i class="bi bi-star"></i>';

                        }

                    }

                    stars +=
                        ` <span style="color:var(--admin-muted);font-size:.72rem;margin-left:5px;">${rating}/5</span>`;

                    modalRating.innerHTML =
                        stars;

                }

            }
        );

    }

});

</script>