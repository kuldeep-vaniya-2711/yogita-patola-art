<% layout("admin/layout") -%>

<%
    /*
    =========================================================
    YOGITA PATOLA ART
    ADMIN — REVIEWS MANAGEMENT
    =========================================================
    Expected data:
    - reviews
    - success
    - error
    =========================================================
    */
%>

<div class="admin-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="admin-page-header">

        <div>

            <span class="admin-page-eyebrow">
                CUSTOMER MANAGEMENT
            </span>

            <h1 class="admin-page-title">
                Reviews Management
            </h1>

            <p class="admin-page-description">
                Review, approve, reject and manage customer reviews.
            </p>

        </div>

        <div class="admin-page-header-actions">

            <a
                href="/admin/dashboard"
                class="admin-btn admin-btn-outline"
            >
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

        </div>

    </div>


    <!-- =====================================================
         ALERTS
    ====================================================== -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="admin-alert admin-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                <%= success %>
            </span>

        </div>

    <% } %>


    <% if (typeof error !== "undefined" && error) { %>

        <div class="admin-alert admin-alert-danger">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- =====================================================
         REVIEW SUMMARY
    ====================================================== -->

    <div class="admin-review-stats">

        <%
            const reviewList =
                Array.isArray(reviews)
                    ? reviews
                    : [];

            const totalReviews =
                reviewList.length;

            const approvedReviews =
                reviewList.filter(
                    review => review.approved === true
                ).length;

            const pendingReviews =
                reviewList.filter(
                    review => review.approved !== true
                ).length;

            let totalRating = 0;

            reviewList.forEach(review => {

                const rating =
                    Number(review.rating) || 0;

                totalRating += rating;

            });

            const averageRating =
                totalReviews > 0
                    ? (totalRating / totalReviews).toFixed(1)
                    : "0.0";
        %>


        <!-- TOTAL -->

        <div class="admin-review-stat-card">

            <div class="admin-review-stat-icon">

                <i class="bi bi-chat-square-text"></i>

            </div>

            <div>

                <span>
                    Total Reviews
                </span>

                <strong>
                    <%= totalReviews %>
                </strong>

            </div>

        </div>


        <!-- APPROVED -->

        <div class="admin-review-stat-card">

            <div class="admin-review-stat-icon success">

                <i class="bi bi-check-circle"></i>

            </div>

            <div>

                <span>
                    Approved
                </span>

                <strong>
                    <%= approvedReviews %>
                </strong>

            </div>

        </div>


        <!-- PENDING -->

        <div class="admin-review-stat-card">

            <div class="admin-review-stat-icon warning">

                <i class="bi bi-clock"></i>

            </div>

            <div>

                <span>
                    Pending
                </span>

                <strong>
                    <%= pendingReviews %>
                </strong>

            </div>

        </div>


        <!-- AVERAGE -->

        <div class="admin-review-stat-card">

            <div class="admin-review-stat-icon gold">

                <i class="bi bi-star-fill"></i>

            </div>

            <div>

                <span>
                    Average Rating
                </span>

                <strong>
                    <%= averageRating %>
                </strong>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTER / TOOLBAR
    ====================================================== -->

    <div class="admin-review-toolbar">

        <div class="admin-review-toolbar-left">

            <div class="admin-search-box">

                <i class="bi bi-search"></i>

                <input
                    type="text"
                    id="reviewSearch"
                    placeholder="Search reviews..."
                    autocomplete="off"
                >

            </div>

        </div>


        <div class="admin-review-toolbar-right">

            <select
                id="reviewStatusFilter"
                class="admin-filter-select"
            >

                <option value="all">
                    All Reviews
                </option>

                <option value="approved">
                    Approved
                </option>

                <option value="pending">
                    Pending
                </option>

            </select>


            <select
                id="reviewRatingFilter"
                class="admin-filter-select"
            >

                <option value="all">
                    All Ratings
                </option>

                <option value="5">
                    ★★★★★ 5
                </option>

                <option value="4">
                    ★★★★ 4
                </option>

                <option value="3">
                    ★★★ 3
                </option>

                <option value="2">
                    ★★ 2
                </option>

                <option value="1">
                    ★ 1
                </option>

            </select>

        </div>

    </div>


    <!-- =====================================================
         REVIEWS TABLE
    ====================================================== -->

    <div class="admin-table-wrapper">

        <% if (reviewList.length > 0) { %>

            <table
                class="admin-table admin-reviews-table"
                id="reviewsTable"
            >

                <thead>

                    <tr>

                        <th>
                            Customer
                        </th>

                        <th>
                            Product
                        </th>

                        <th>
                            Rating
                        </th>

                        <th>
                            Review
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Date
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="reviewsTableBody">

                    <% reviewList.forEach(review => { %>

                        <%
                            const customerName =
                                review.name ||
                                (review.user && review.user.name) ||
                                "Anonymous";

                            const customerEmail =
                                review.email ||
                                (review.user && review.user.email) ||
                                "";

                            const productName =
                                review.product &&
                                review.product.name
                                    ? review.product.name
                                    : "General Review";

                            const rating =
                                Number(review.rating) || 0;

                            const reviewMessage =
                                review.message ||
                                review.comment ||
                                "";

                            const isApproved =
                                review.approved === true;

                            const reviewDate =
                                review.createdAt
                                    ? new Date(review.createdAt)
                                    : null;

                            const formattedDate =
                                reviewDate &&
                                !isNaN(reviewDate.getTime())
                                    ? reviewDate.toLocaleDateString(
                                        "en-IN",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric"
                                        }
                                    )
                                    : "-";
                        %>


                        <tr
                            class="review-row"
                            data-name="<%= customerName.toLowerCase() %>"
                            data-email="<%= customerEmail.toLowerCase() %>"
                            data-product="<%= productName.toLowerCase() %>"
                            data-rating="<%= rating %>"
                            data-status="<%= isApproved ? 'approved' : 'pending' %>"
                        >


                            <!-- CUSTOMER -->

                            <td>

                                <div class="admin-review-customer">

                                    <div class="admin-review-avatar">

                                        <%= customerName
                                            .charAt(0)
                                            .toUpperCase() %>

                                    </div>

                                    <div>

                                        <strong>
                                            <%= customerName %>
                                        </strong>

                                        <% if (customerEmail) { %>

                                            <small>
                                                <%= customerEmail %>
                                            </small>

                                        <% } %>

                                    </div>

                                </div>

                            </td>


                            <!-- PRODUCT -->

                            <td>

                                <% if (
                                    review.product &&
                                    review.product._id
                                ) { %>

                                    <a
                                        href="/products/<%= review.product._id %>"
                                        target="_blank"
                                        class="admin-review-product-link"
                                    >
                                        <%= productName %>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>

                                <% } else { %>

                                    <span>
                                        <%= productName %>
                                    </span>

                                <% } %>

                            </td>


                            <!-- RATING -->

                            <td>

                                <div
                                    class="admin-review-rating"
                                    aria-label="Rating <%= rating %> out of 5"
                                >

                                    <% for (
                                        let star = 1;
                                        star <= 5;
                                        star++
                                    ) { %>

                                        <% if (star <= rating) { %>

                                            <i class="bi bi-star-fill"></i>

                                        <% } else { %>

                                            <i class="bi bi-star"></i>

                                        <% } %>

                                    <% } %>

                                    <span>
                                        <%= rating %>/5
                                    </span>

                                </div>

                            </td>


                            <!-- REVIEW -->

                            <td>

                                <div class="admin-review-message">

                                    <%= reviewMessage %>

                                </div>

                            </td>


                            <!-- STATUS -->

                            <td>

                                <% if (isApproved) { %>

                                    <span
                                        class="admin-status admin-status-success"
                                    >
                                        <i class="bi bi-check-circle me-1"></i>
                                        Approved
                                    </span>

                                <% } else { %>

                                    <span
                                        class="admin-status admin-status-warning"
                                    >
                                        <i class="bi bi-clock me-1"></i>
                                        Pending
                                    </span>

                                <% } %>

                            </td>


                            <!-- DATE -->

                            <td>

                                <span class="admin-review-date">
                                    <%= formattedDate %>
                                </span>

                            </td>


                            <!-- ACTIONS -->

                            <td class="text-end">

                                <div class="admin-review-actions">


                                    <!-- VIEW -->

                                    <button
                                        type="button"
                                        class="admin-icon-btn"
                                        title="View Review"
                                        data-bs-toggle="modal"
                                        data-bs-target="#reviewModal"
                                        data-review-name="<%= customerName %>"
                                        data-review-email="<%= customerEmail %>"
                                        data-review-product="<%= productName %>"
                                        data-review-rating="<%= rating %>"
                                        data-review-message="<%= reviewMessage.replace(/"/g, '&quot;') %>"
                                        data-review-status="<%= isApproved ? 'Approved' : 'Pending' %>"
                                        data-review-date="<%= formattedDate %>"
                                    >

                                        <i class="bi bi-eye"></i>

                                    </button>


                                    <!-- APPROVE / REJECT -->

                                    <% if (!isApproved) { %>

                                        <form
                                            action="/admin/reviews/<%= review._id %>/approve"
                                            method="POST"
                                            class="d-inline"
                                        >

                                            <button
                                                type="submit"
                                                class="admin-icon-btn admin-icon-btn-success"
                                                title="Approve Review"
                                            >

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>

                                    <% } else { %>

                                        <form
                                            action="/admin/reviews/<%= review._id %>/reject"
                                            method="POST"
                                            class="d-inline"
                                        >

                                            <button
                                                type="submit"
                                                class="admin-icon-btn admin-icon-btn-warning"
                                                title="Reject Review"
                                            >

                                                <i class="bi bi-x-lg"></i>

                                            </button>

                                        </form>

                                    <% } %>


                                    <!-- DELETE -->

                                    <form
                                        action="/admin/reviews/<%= review._id %>/delete"
                                        method="POST"
                                        class="d-inline delete-review-form"
                                    >

                                        <button
                                            type="submit"
                                            class="admin-icon-btn admin-icon-btn-danger"
                                            title="Delete Review"
                                        >

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>


            <!-- NO FILTER RESULTS -->

            <div
                id="noReviewResults"
                class="admin-empty-state d-none"
            >

                <div class="admin-empty-icon">

                    <i class="bi bi-search"></i>

                </div>

                <h3>
                    No reviews found
                </h3>

                <p>
                    Try changing your search or filters.
                </p>

            </div>


        <% } else { %>


            <!-- NO REVIEWS -->

            <div class="admin-empty-state">

                <div class="admin-empty-icon">

                    <i class="bi bi-chat-square-heart"></i>

                </div>

                <h3>
                    No Reviews Yet
                </h3>

                <p>
                    Customer reviews will appear here once they are submitted.
                </p>

            </div>


        <% } %>

    </div>

</div>


<!-- =========================================================
     REVIEW DETAILS MODAL
========================================================== -->

<div
    class="modal fade"
    id="reviewModal"
    tabindex="-1"
    aria-labelledby="reviewModalLabel"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content admin-review-modal">

            <div class="modal-header">

                <div>

                    <span class="admin-modal-eyebrow">
                        CUSTOMER REVIEW
                    </span>

                    <h5
                        class="modal-title"
                        id="reviewModalLabel"
                    >
                        Review Details
                    </h5>

                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>


            <div class="modal-body">

                <div class="admin-modal-customer">

                    <div class="admin-review-avatar large">

                        <span id="modalCustomerInitial">
                            A
                        </span>

                    </div>

                    <div>

                        <strong id="modalCustomerName">
                            Customer
                        </strong>

                        <small id="modalCustomerEmail">
                            -
                        </small>

                    </div>

                </div>


                <div class="admin-modal-product">

                    <span>
                        PRODUCT
                    </span>

                    <strong id="modalProductName">
                        -
                    </strong>

                </div>


                <div class="admin-modal-rating">

                    <span>
                        RATING
                    </span>

                    <div id="modalRating">
                        -
                    </div>

                </div>


                <div class="admin-modal-review">

                    <span>
                        REVIEW
                    </span>

                    <p id="modalReviewMessage">
                        -
                    </p>

                </div>


                <div class="admin-modal-meta">

                    <div>

                        <span>
                            STATUS
                        </span>

                        <strong id="modalReviewStatus">
                            -
                        </strong>

                    </div>

                    <div>

                        <span>
                            DATE
                        </span>

                        <strong id="modalReviewDate">
                            -
                        </strong>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="admin-btn admin-btn-outline"
                    data-bs-dismiss="modal"
                >
                    Close
                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     PAGE-SPECIFIC CSS
========================================================== -->

<style>

    /* =====================================================
       PAGE
    ====================================================== */

    .admin-page {
        width: 100%;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .admin-page-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--admin-gold);

        font-size: 0.7rem;
        font-weight: 600;

        letter-spacing: 0.14em;
        text-transform: uppercase;
    }


    .admin-page-header-actions {
        display: flex;
        gap: 10px;
    }


    /* =====================================================
       ALERT
    ====================================================== */

    .admin-alert {
        display: flex;
        align-items: center;

        gap: 10px;

        margin-bottom: 24px;
        padding: 13px 16px;

        border-radius: 10px;

        font-size: 0.88rem;
    }


    .admin-alert-success {
        background: #eaf7ee;
        border: 1px solid #cfe9d7;
        color: #247442;
    }


    .admin-alert-danger {
        background: #fdeaea;
        border: 1px solid #f2cccc;
        color: #a52b35;
    }


    /* =====================================================
       REVIEW STATS
    ====================================================== */

    .admin-review-stats {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 18px;

        margin-bottom: 24px;
    }


    .admin-review-stat-card {
        display: flex;
        align-items: center;

        gap: 14px;

        padding: 20px;

        background: var(--admin-white);

        border: 1px solid var(--admin-border);

        border-radius: 14px;

        box-shadow:
            0 8px 25px rgba(
                36,
                27,
                24,
                0.04
            );
    }


    .admin-review-stat-icon {
        width: 44px;
        height: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #f7e9ec;

        color: var(--admin-red);

        font-size: 18px;
    }


    .admin-review-stat-icon.success {
        background: #e8f6ed;
        color: #247442;
    }


    .admin-review-stat-icon.warning {
        background: #fff4d8;
        color: #8a6410;
    }


    .admin-review-stat-icon.gold {
        background: #f7efdf;
        color: var(--admin-gold);
    }


    .admin-review-stat-card span {
        display: block;

        margin-bottom: 2px;

        color: var(--admin-muted);

        font-size: 0.75rem;
    }


    .admin-review-stat-card strong {
        display: block;

        color: var(--admin-ink);

        font-family: "Playfair Display", serif;

        font-size: 1.55rem;
        font-weight: 600;
    }


    /* =====================================================
       TOOLBAR
    ====================================================== */

    .admin-review-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        margin-bottom: 18px;

        padding: 15px;

        background: var(--admin-white);

        border: 1px solid var(--admin-border);

        border-radius: 12px;
    }


    .admin-review-toolbar-left,
    .admin-review-toolbar-right {
        display: flex;
        align-items: center;

        gap: 10px;
    }


    .admin-search-box {
        position: relative;

        width: 280px;
    }


    .admin-search-box i {
        position: absolute;

        top: 50%;
        left: 13px;

        color: var(--admin-muted);

        transform: translateY(-50%);
    }


    .admin-search-box input {
        width: 100%;

        height: 42px;

        padding:
            8px
            12px
            8px
            38px;

        border: 1px solid var(--admin-border);

        border-radius: 8px;

        outline: none;

        background: #fff;

        color: var(--admin-ink);

        font-family: "Poppins", sans-serif;

        font-size: 0.82rem;
    }


    .admin-search-box input:focus {
        border-color: var(--admin-red);

        box-shadow:
            0 0 0 3px
            rgba(
                143,
                29,
                44,
                0.08
            );
    }


    .admin-filter-select {
        min-width: 135px;

        height: 42px;

        padding: 0 12px;

        border: 1px solid var(--admin-border);

        border-radius: 8px;

        outline: none;

        background: #fff;

        color: var(--admin-ink);

        font-family: "Poppins", sans-serif;

        font-size: 0.82rem;

        cursor: pointer;
    }


    .admin-filter-select:focus {
        border-color: var(--admin-red);
    }


    /* =====================================================
       CUSTOMER
    ====================================================== */

    .admin-review-customer {
        display: flex;
        align-items: center;

        gap: 10px;

        min-width: 180px;
    }


    .admin-review-avatar {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 50%;

        background: #f5e8e9;

        color: var(--admin-red);

        font-family: "Playfair Display", serif;

        font-size: 16px;
        font-weight: 600;
    }


    .admin-review-avatar.large {
        width: 52px;
        height: 52px;

        font-size: 21px;
    }


    .admin-review-customer strong {
        display: block;

        margin-bottom: 1px;

        color: var(--admin-ink);

        font-size: 0.83rem;

        font-weight: 600;
    }


    .admin-review-customer small {
        display: block;

        max-width: 160px;

        overflow: hidden;

        color: var(--admin-muted);

        font-size: 0.68rem;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    /* =====================================================
       PRODUCT
    ====================================================== */

    .admin-review-product-link {
        color: var(--admin-red);

        font-size: 0.82rem;
        font-weight: 500;

        transition: 0.2s ease;
    }


    .admin-review-product-link:hover {
        color: var(--admin-red-dark);
    }


    .admin-review-product-link i {
        margin-left: 4px;

        font-size: 0.7rem;
    }


    /* =====================================================
       RATING
    ====================================================== */

    .admin-review-rating {
        display: flex;
        align-items: center;

        gap: 2px;

        white-space: nowrap;
    }


    .admin-review-rating i {
        color: var(--admin-gold);

        font-size: 0.72rem;
    }


    .admin-review-rating span {
        margin-left: 5px;

        color: var(--admin-muted);

        font-size: 0.7rem;
    }


    /* =====================================================
       MESSAGE
    ====================================================== */

    .admin-review-message {
        width: 260px;
        max-width: 260px;

        display: -webkit-box;

        overflow: hidden;

        color: var(--admin-muted);

        font-size: 0.8rem;

        line-height: 1.5;

        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }


    /* =====================================================
       DATE
    ====================================================== */

    .admin-review-date {
        color: var(--admin-muted);

        font-size: 0.75rem;

        white-space: nowrap;
    }


    /* =====================================================
       ACTIONS
    ====================================================== */

    .admin-review-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        gap: 5px;
    }


    .admin-icon-btn {
        width: 34px;
        height: 34px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 0;

        border: 1px solid var(--admin-border);

        border-radius: 7px;

        background: #fff;

        color: var(--admin-muted);

        cursor: pointer;

        transition: 0.2s ease;
    }


    .admin-icon-btn:hover {
        background: var(--admin-cream);

        border-color: var(--admin-gold);

        color: var(--admin-red);

        transform: translateY(-1px);
    }


    .admin-icon-btn-success:hover {
        background: #e8f6ed;

        border-color: #b9dfc4;

        color: #247442;
    }


    .admin-icon-btn-warning:hover {
        background: #fff4d8;

        border-color: #ecd99c;

        color: #8a6410;
    }


    .admin-icon-btn-danger:hover {
        background: #fdeaea;

        border-color: #efc2c2;

        color: #a52b35;
    }


    /* =====================================================
       EMPTY STATE
    ====================================================== */

    .admin-empty-state {
        padding: 70px 25px;

        text-align: center;
    }


    .admin-empty-icon {
        width: 65px;
        height: 65px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 18px;

        border-radius: 50%;

        background: #f6eee4;

        color: var(--admin-gold);

        font-size: 25px;
    }


    .admin-empty-state h3 {
        margin-bottom: 7px;

        color: var(--admin-ink);

        font-family: "Playfair Display", serif;

        font-size: 1.45rem;
    }


    .admin-empty-state p {
        margin: 0;

        color: var(--admin-muted);

        font-size: 0.82rem;
    }


    /* =====================================================
       MODAL
    ====================================================== */

    .admin-review-modal {
        overflow: hidden;

        border: 1px solid var(--admin-border);

        border-radius: 14px;
    }


