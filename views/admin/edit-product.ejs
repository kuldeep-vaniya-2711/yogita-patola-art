<%
layout("admin/layout", {
title: "Edit Product | Admin",
pageCss: "/css/admin/edit-product.css",
pageJs: "/js/admin/edit-product.js"
}) -%>

<div class="admin-page edit-product-page">


<!-- ====================================================
     PAGE HEADER
====================================================== -->

<div class="admin-page-header">

    <div>

        <span class="admin-page-eyebrow">
            PRODUCT MANAGEMENT
        </span>

        <h1 class="admin-page-title">
            Edit Product
        </h1>

        <p class="admin-page-description">
            Update product information, pricing, availability and images.
        </p>

    </div>


    <div class="admin-page-header-actions">

        <a
            href="/admin/products"
            class="admin-btn admin-btn-outline"
        >
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>

    </div>

</div>


<!-- ====================================================
     ALERTS
====================================================== -->

<%- include("../partials/alerts") %>


<!-- ====================================================
     FORM
====================================================== -->

<form
    id="editProductForm"
    action="/admin/products/edit/<%= product._id %>"
    method="POST"
    enctype="multipart/form-data"
    novalidate
>


    <div class="row g-4">


        <!-- =================================================
             LEFT COLUMN
        ================================================== -->

        <div class="col-xl-8">


            <!-- =================================================
                 BASIC INFORMATION
            ================================================== -->

            <div class="admin-edit-card">

                <div class="admin-edit-card-header">

                    <div>

                        <span class="card-eyebrow">
                            BASIC INFORMATION
                        </span>

                        <h2>
                            Product Details
                        </h2>

                    </div>

                </div>


                <div class="admin-edit-card-body">


                    <!-- PRODUCT NAME -->

                    <div class="mb-4">

                        <label
                            for="productName"
                            class="form-label"
                        >
                            Product Name
                            <span class="text-danger">*</span>
                        </label>

                        <input
                            id="productName"
                            name="name"
                            type="text"
                            class="form-control form-control-lg"
                            value="<%= product.name || '' %>"
                            placeholder="Enter product name"
                            minlength="2"
                            maxlength="150"
                            autocomplete="off"
                            required
                        >

                        <div class="invalid-feedback">
                            Please enter a valid product name.
                        </div>

                    </div>


                    <!-- CATEGORY + TECHNIQUE -->

                    <div class="row g-3">


                        <div class="col-md-6">

                            <label
                                for="productCategory"
                                class="form-label"
                            >
                                Category
                                <span class="text-danger">*</span>
                            </label>

                            <select
                                id="productCategory"
                                name="category"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select Category
                                </option>


                                <% [
                                    "Patola Sarees",
                                    "Double Ikat Sarees",
                                    "Single Ikat Sarees",
                                    "Dupattas",
                                    "Accessories"
                                ].forEach(category => { %>

                                    <option
                                        value="<%= category %>"
                                        <%= product.category === category ? "selected" : "" %>
                                    >
                                        <%= category %>
                                    </option>

                                <% }) %>

                            </select>

                            <div class="invalid-feedback">
                                Please select a category.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label
                                for="productTechnique"
                                class="form-label"
                            >
                                Technique
                            </label>

                            <input
                                id="productTechnique"
                                name="technique"
                                type="text"
                                class="form-control"
                                value="<%= product.technique || '' %>"
                                placeholder="e.g. Double Ikat"
                                maxlength="100"
                            >

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="mt-4">

                        <label
                            for="productDescription"
                            class="form-label"
                        >
                            Description
                            <span class="text-danger">*</span>
                        </label>

                        <textarea
                            id="productDescription"
                            name="description"
                            class="form-control"
                            rows="7"
                            minlength="10"
                            maxlength="3000"
                            placeholder="Enter detailed product description..."
                            required
                        ><%= product.description || '' %></textarea>


                        <div class="description-counter">

                            <span id="descriptionCount">
                                <%= (product.description || "").length %>
                            </span>

                            / 3000

                        </div>


                        <div class="invalid-feedback">
                            Please enter a valid product description.
                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 SPECIFICATIONS
            ================================================== -->

            <div class="admin-edit-card mt-4">

                <div class="admin-edit-card-header">

                    <div>

                        <span class="card-eyebrow">
                            PRODUCT SPECIFICATIONS
                        </span>

                        <h2>
                            Details & Specifications
                        </h2>

                    </div>

                </div>


                <div class="admin-edit-card-body">

                    <div class="row g-4">


                        <!-- PRICE -->

                        <div class="col-md-6">

                            <label
                                for="productPrice"
                                class="form-label"
                            >
                                Price
                                <span class="text-danger">*</span>
                            </label>


                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>


                                <input
                                    id="productPrice"
                                    name="price"
                                    type="number"
                                    class="form-control"
                                    value="<%= product.price || '' %>"
                                    min="0"
                                    step="1"
                                    placeholder="0"
                                    required
                                >

                            </div>


                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>

                        </div>


                        <!-- DISCOUNT -->

                        <div class="col-md-6">

                            <label
                                for="discountEnabled"
                                class="form-label"
                            >
                                Offer Discount?
                            </label>


                            <select
                                id="discountEnabled"
                                name="discountEnabled"
                                class="form-select"
                            >

                                <option
                                    value="false"
                                    <%= !product.discountEnabled ? "selected" : "" %>
                                >
                                    No Discount
                                </option>

                                <option
                                    value="true"
                                    <%= product.discountEnabled ? "selected" : "" %>
                                >
                                    Yes, Apply Discount
                                </option>

                            </select>

                        </div>


                        <!-- DISCOUNT PERCENTAGE -->

                        <div
                            id="discountPercentageField"
                            class="col-md-6 <%= product.discountEnabled ? '' : 'd-none' %>"
                        >

                            <label
                                for="discountPercentage"
                                class="form-label"
                            >
                                Discount Percentage
                            </label>


                            <div class="input-group">

                                <input
                                    id="discountPercentage"
                                    name="discountPercentage"
                                    type="number"
                                    class="form-control"
                                    value="<%= product.discountPercentage || '' %>"
                                    min="1"
                                    max="100"
                                    step="1"
                                    placeholder="e.g. 20"
                                >

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>


                            <div class="form-text">
                                Enter a discount between 1% and 100%.
                            </div>

                        </div>


                        <!-- DISCOUNT PREVIEW -->

                        <div
                            id="discountPricePreview"
                            class="col-md-6 <%= product.discountEnabled ? '' : 'd-none' %>"
                        >

                            <label class="form-label">
                                Final Price Preview
                            </label>


                            <div class="discount-price-preview-box">

                                <div class="discount-original-price">
                                    Original:
                                    <span id="originalPricePreview">
                                        ₹<%= Number(
                                            product.price || 0
                                        ).toLocaleString("en-IN") %>
                                    </span>
                                </div>


                                <div class="discount-final-price">
                                    <span id="finalPricePreview">
                                        ₹<%= Number(
                                            product.discountEnabled
                                                ? (
                                                    Number(product.price || 0) *
                                                    (1 - Number(product.discountPercentage || 0) / 100)
                                                )
                                                : Number(product.price || 0)
                                        ).toLocaleString("en-IN", {
                                            maximumFractionDigits: 0
                                        }) %>
                                    </span>
                                </div>


                                <span
                                    id="discountBadgePreview"
                                    class="discount-preview-badge"
                                >
                                    <%= product.discountPercentage || 0 %>% OFF
                                </span>

                            </div>

                        </div>


                        <!-- FABRIC -->

                        <div class="col-md-6">

                            <label
                                for="productFabric"
                                class="form-label"
                            >
                                Fabric
                            </label>

                            <input
                                id="productFabric"
                                name="fabric"
                                type="text"
                                class="form-control"
                                value="<%= product.fabric || '' %>"
                                placeholder="e.g. Silk"
                                maxlength="100"
                            >

                        </div>


                        <!-- COLOR -->

                        <div class="col-md-6">

                            <label
                                for="productColor"
                                class="form-label"
                            >
                                Color
                            </label>

                            <input
                                id="productColor"
                                name="color"
                                type="text"
                                class="form-control"
                                value="<%= product.color || '' %>"
                                placeholder="e.g. Red & Gold"
                                maxlength="100"
                            >

                        </div>


                        <!-- DIMENSIONS -->

                        <div class="col-md-6">

                            <label
                                for="productDimensions"
                                class="form-label"
                            >
                                Dimensions
                            </label>

                            <input
                                id="productDimensions"
                                name="dimensions"
                                type="text"
                                class="form-control"
                                value="<%= product.dimensions || '' %>"
                                placeholder="e.g. 6.3 meters"
                                maxlength="100"
                            >

                        </div>


                        <!-- AVAILABILITY -->

                        <div class="col-md-6">

                            <label
                                for="productAvailability"
                                class="form-label"
                            >
                                Availability
                                <span class="text-danger">*</span>
                            </label>


                            <select
                                id="productAvailability"
                                name="availability"
                                class="form-select"
                                required
                            >

                                <% [
                                    "In Stock",
                                    "Limited",
                                    "Out of Stock"
                                ].forEach(status => { %>

                                    <option
                                        value="<%= status %>"
                                        <%= product.availability === status ? "selected" : "" %>
                                    >
                                        <%= status %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <!-- FEATURED -->

                        <div class="col-md-6">

                            <label class="form-label d-block">
                                Homepage Visibility
                            </label>


                            <label
                                class="settings-switch"
                                for="featuredProduct"
                            >

                                <input
                                    id="featuredProduct"
                                    name="featured"
                                    type="checkbox"
                                    value="true"
                                    <%= product.featured ? "checked" : "" %>
                                >

                                <span class="switch-slider"></span>


                                <span class="switch-content">

                                    <strong>
                                        Show as Featured Product
                                    </strong>

                                    <small>
                                        Display this product in featured collections.
                                    </small>

                                </span>

                            </label>

                        </div>


                    </div>

                </div>

            </div>


            <!-- =================================================
                 PRODUCT IMAGES
            ================================================== -->

            <div class="admin-edit-card mt-4">

                <div class="admin-edit-card-header">

                    <div>

                        <span class="card-eyebrow">
                            PRODUCT IMAGES
                        </span>

                        <h2>
                            Update Product Photos
                        </h2>

                        <p>
                            Uploading new images will replace all
                            existing product images.
                        </p>

                    </div>

                </div>


                <div class="admin-edit-card-body">


                    <!-- CURRENT IMAGES -->

                    <% if (product.images && product.images.length) { %>

                        <div class="current-images-section">

                            <h3 class="image-section-title">
                                Current Images
                            </h3>


                            <div class="current-images-grid">

                                <% product.images.forEach((image, index) => { %>

                                    <div class="current-image-item">

                                        <img
                                            src="<%= image %>"
                                            alt="<%= product.name || 'Product Image' %>"
                                        >


                                        <% if (index === 0) { %>

                                            <span class="main-image-badge">
                                                Main Image
                                            </span>

                                        <% } %>


                                        <span class="current-image-number">
                                            <%= index + 1 %>
                                        </span>

                                    </div>

                                <% }) %>

                            </div>


                            <p class="image-help-text">

                                Current images remain unchanged if you
                                do not upload new images.

                            </p>

                        </div>


                    <% } else { %>


                        <div class="no-current-images">

                            <span>
                                ✦
                            </span>

                            <p>
                                No product images available.
                            </p>

                        </div>


                    <% } %>


                    <!-- NEW IMAGES -->

                    <div class="new-images-section mt-4">

                        <label
                            for="productImages"
                            class="form-label"
                        >
                            Upload New Images
                        </label>


                        <input
                            id="productImages"
                            name="productImages"
                            type="file"
                            class="form-control"
                            accept="image/jpeg,image/jpg,image/png,image/webp"
                            multiple
                        >


                        <div class="form-text">

                            JPG, JPEG, PNG or WEBP.
                            Maximum 5MB per image.
                            Maximum 5 images.

                        </div>


                        <div
                            id="imagePreview"
                            class="edit-product-image-preview"
                        ></div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="edit-form-actions mt-4">


                <a
                    href="/admin/products"
                    class="admin-btn admin-btn-outline"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    id="saveProductButton"
                    class="admin-btn admin-btn-primary"
                >

                    <span class="button-text">
                        Save Changes
                    </span>


                    <span class="button-loading d-none">
                        Saving...
                    </span>

                </button>

            </div>

        </div>


        <!-- =================================================
             RIGHT COLUMN
        ================================================== -->

        <div class="col-xl-4">


            <!-- =================================================
                 PRODUCT PREVIEW
            ================================================== -->

            <div class="admin-edit-card sticky-edit-card">

                <div class="admin-edit-card-header">

                    <div>

                        <span class="card-eyebrow">
                            CURRENT PRODUCT
                        </span>

                        <h2>
                            Preview
                        </h2>

                    </div>

                </div>


                <div class="admin-edit-card-body">


                    <div class="product-summary-image">


                        <% if (product.images && product.images.length) { %>

                            <img
                                id="productMainPreview"
                                src="<%= product.images[0] %>"
                                alt="<%= product.name || 'Product' %>"
                            >


                        <% } else { %>


                            <div
                                id="productMainPreview"
                                class="product-summary-placeholder"
                            >
                                Yogita Patola Art
                            </div>


                        <% } %>


                    </div>


                    <div class="product-summary-details">


                        <span
                            id="summaryCategory"
                            class="product-summary-category"
                        >
                            <%= product.category || "Patola" %>
                        </span>


                        <h3 id="summaryName">

                            <%= product.name || "Product Name" %>

                        </h3>


                        <div
                            id="summaryPrice"
                            class="product-summary-price"
                        >

                            <% if (product.discountEnabled && product.discountPercentage > 0) { %>

                                <span
                                    class="summary-original-price"
                                    id="summaryOriginalPrice"
                                >
                                    ₹<%= Number(
                                        product.price || 0
                                    ).toLocaleString("en-IN") %>
                                </span>

                                <span
                                    class="summary-discounted-price"
                                    id="summaryDiscountedPrice"
                                >
                                    ₹<%= Number(
                                        Number(product.price || 0) *
                                        (1 - Number(product.discountPercentage || 0) / 100)
                                    ).toLocaleString("en-IN", {
                                        maximumFractionDigits: 0
                                    }) %>
                                </span>

                                <span
                                    class="summary-discount-badge"
                                    id="summaryDiscountBadge"
                                >
                                    <%= product.discountPercentage %>% OFF
                                </span>

                            <% } else { %>

                                <span
                                    class="summary-discounted-price"
                                    id="summaryDiscountedPrice"
                                >
                                    ₹<%= Number(
                                        product.price || 0
                                    ).toLocaleString("en-IN") %>
                                </span>

                                <span
                                    class="summary-discount-badge d-none"
                                    id="summaryDiscountBadge"
                                ></span>

                                <span
                                    class="summary-original-price d-none"
                                    id="summaryOriginalPrice"
                                ></span>

                            <% } %>

                        </div>


                        <span
                            id="summaryAvailability"
                            class="product-summary-availability"
                        >

                            <%= product.availability || "In Stock" %>

                        </span>


                    </div>

                </div>

            </div>


            <!-- =================================================
                 PRODUCT ID
            ================================================== -->

            <div class="admin-edit-card mt-4">

                <div class="admin-edit-card-body">

                    <div class="product-id-box">

                        <span>
                            Product ID
                        </span>


                        <code>
                            <%= product._id %>
                        </code>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 INFO
            ================================================== -->

            <div class="admin-info-box mt-4">

                <div class="admin-info-icon">
                    ✦
                </div>


                <div>

                    <h3>
                        Editing Product
                    </h3>


                    <p>

                        Review all changes carefully before saving.
                        Product information will be updated in the
                        database immediately.

                    </p>

                </div>

            </div>

        </div>

    </div>

</form>


</div>

<!-- =========================================================
     EDIT PRODUCT DISCOUNT PREVIEW
========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", () => {

    const discountEnabled =
        document.getElementById("discountEnabled");

    const discountPercentage =
        document.getElementById("discountPercentage");

    const priceInput =
        document.getElementById("productPrice");

    const percentageField =
        document.getElementById("discountPercentageField");

    const pricePreview =
        document.getElementById("discountPricePreview");

    const originalPricePreview =
        document.getElementById("originalPricePreview");

    const finalPricePreview =
        document.getElementById("finalPricePreview");

    const discountBadgePreview =
        document.getElementById("discountBadgePreview");

    const summaryPrice =
        document.getElementById("summaryPrice");

    const summaryOriginalPrice =
        document.getElementById("summaryOriginalPrice");

    const summaryDiscountedPrice =
        document.getElementById("summaryDiscountedPrice");

    const summaryDiscountBadge =
        document.getElementById("summaryDiscountBadge");


    if (
        !discountEnabled ||
        !discountPercentage ||
        !priceInput
    ) {
        return;
    }


    const formatPrice = value =>
        `₹${Number(value || 0).toLocaleString("en-IN", {
            maximumFractionDigits: 0
        })}`;


    const updateDiscountPreview = () => {

        const enabled =
            discountEnabled.value === "true";

        const price =
            Number(priceInput.value) || 0;

        let percentage =
            Number(discountPercentage.value) || 0;


        if (percentage < 0) {
            percentage = 0;
        }

        if (percentage > 100) {
            percentage = 100;
        }


        percentageField.classList.toggle(
            "d-none",
            !enabled
        );

        pricePreview.classList.toggle(
            "d-none",
            !enabled
        );


        if (!enabled) {

            summaryOriginalPrice.textContent = "";
            summaryOriginalPrice.classList.add("d-none");

            summaryDiscountedPrice.textContent =
                formatPrice(price);

            summaryDiscountBadge.textContent = "";
            summaryDiscountBadge.classList.add("d-none");

            return;
        }


        const finalPrice =
            price * (1 - percentage / 100);


        originalPricePreview.textContent =
            formatPrice(price);

        finalPricePreview.textContent =
            formatPrice(finalPrice);

        discountBadgePreview.textContent =
            `${percentage}% OFF`;


        summaryOriginalPrice.textContent =
            formatPrice(price);

        summaryOriginalPrice.classList.remove(
            "d-none"
        );

        summaryDiscountedPrice.textContent =
            formatPrice(finalPrice);

        summaryDiscountBadge.textContent =
            `${percentage}% OFF`;

        summaryDiscountBadge.classList.remove(
            "d-none"
        );

    };


    discountEnabled.addEventListener(
        "change",
        updateDiscountPreview
    );

    discountPercentage.addEventListener(
        "input",
        updateDiscountPreview
    );

    priceInput.addEventListener(
        "input",
        updateDiscountPreview
    );


    updateDiscountPreview();

});

</script>
