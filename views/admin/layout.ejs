
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= typeof title !== "undefined" && title
            ? title + " | Yogita Patola Art Admin"
            : "Admin Panel | Yogita Patola Art" %>
    </title>

    <meta
        name="description"
        content="Yogita Patola Art Admin Panel"
    >


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >


    <!-- =====================================================
         GOOGLE FONTS
         ===================================================== -->

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    >


    <!-- =====================================================
         ADMIN GLOBAL CSS
         ===================================================== -->

    <link
        rel="stylesheet"
        href="/css/admin/admin-layout.css"
    >

    <link
        rel="stylesheet"
        href="/css/admin/sidebar.css"
    >

    <link
        rel="stylesheet"
        href="/css/admin/topbar.css"
    >


    <!-- =====================================================
         PAGE-SPECIFIC ADMIN CSS
         
         Example:
         /css/admin/dashboard.css
         /css/admin/products.css
         /css/admin/settings.css
         ===================================================== -->

    <% if (typeof pageCss !== "undefined" && pageCss) { %>

        <link
            rel="stylesheet"
            href="<%= pageCss %>"
        >

    <% } %>


</head>


<body class="admin-body">


    <!-- =====================================================
         ADMIN WRAPPER
         ===================================================== -->

    <div class="admin-wrapper">


        <!-- =================================================
             SIDEBAR
             ================================================= -->

        <%- include("../partials/sidebar") %>


        <!-- =================================================
             MAIN AREA
             ================================================= -->

        <div class="admin-main">


            <!-- =============================================
                 TOPBAR
                 ============================================= -->

            <%- include("../partials/topbar") %>


            <!-- =============================================
                 ALERTS
                 ============================================= -->

            <div class="admin-alert-container">

                <%- include("../partials/alerts") %>

            </div>


            <!-- =============================================
                 PAGE CONTENT
                 ============================================= -->

            <main class="admin-content">

                <%- body %>

            </main>


        </div>


    </div>


    <!-- =====================================================
         MOBILE SIDEBAR OVERLAY
         ===================================================== -->

    <div
        class="admin-sidebar-overlay"
        aria-hidden="true"
    ></div>


    <!-- =====================================================
         BOOTSTRAP JS
         ===================================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


    <!-- =====================================================
         ADMIN GLOBAL JS
         ===================================================== -->

    <script src="/js/admin/admin-layout.js"></script>


    <!-- =====================================================
         PAGE-SPECIFIC ADMIN JS
         ===================================================== -->

    <% if (typeof pageJs !== "undefined" && pageJs) { %>

        <script src="<%= pageJs %>"></script>

    <% } %>


</body>

</html>

