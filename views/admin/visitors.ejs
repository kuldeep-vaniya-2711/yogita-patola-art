<%
layout("admin/layout", {
    title: "Visitors",
    pageTitle: "Visitors",
    pageCss: "/css/admin/visitors.css"
});
%>

<%
const visitorList = Array.isArray(visitors) ? visitors : [];


/* =========================================================
   TOTAL VISITS
========================================================= */

const totalVisits = visitorList.length;


/* =========================================================
   UNIQUE VISITORS
========================================================= */

const uniqueIpSet = new Set();

visitorList.forEach(function (visitor) {

    if (!visitor) {
        return;
    }

    const ip =
        visitor.ip ||
        visitor.ipAddress ||
        visitor.clientIp ||
        visitor.clientIP ||
        visitor.remoteAddress ||
        "";

    if (ip) {
        uniqueIpSet.add(String(ip));
    }
});

const uniqueVisitors = uniqueIpSet.size;


/* =========================================================
   PAGE VISIT COUNTS
   ALL HISTORICAL VISITORS
========================================================= */

const pageCounts = {};

visitorList.forEach(function (visitor) {

    if (!visitor) {
        return;
    }

    const page = String(
        visitor.page ||
        visitor.path ||
        visitor.url ||
        visitor.route ||
        "/"
    );

    if (!pageCounts[page]) {
        pageCounts[page] = 0;
    }

    pageCounts[page]++;
});


/* =========================================================
   MOST VISITED PAGES
========================================================= */

const popularPages = Object.keys(pageCounts)
    .map(function (page) {

        return {
            page: page,
            count: pageCounts[page]
        };

    })
    .sort(function (a, b) {

        return b.count - a.count;

    })
    .slice(0, 7);


const maxPageCount =
    popularPages.length > 0
        ? Math.max.apply(
            null,
            popularPages.map(function (item) {
                return item.count;
            })
        )
        : 1;
%>


<div class="admin-visitors-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="visitors-page-header">

        <div>

            <h1 class="visitors-page-title">
                Visitor Analytics
            </h1>

            <p class="visitors-page-description">
                Monitor website traffic and understand which pages visitors use most.
            </p>

        </div>

    </div>


    <!-- =====================================================
         TOP STAT CARDS
    ====================================================== -->

    <section class="visitor-stats-grid">


        <!-- TOTAL VISITS -->

        <div class="visitor-stat-card">

            <div class="visitor-stat-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>

            <div class="visitor-stat-content">

                <span class="visitor-stat-label">
                    Total Visits
                </span>

                <strong class="visitor-stat-value">
                    <%= totalVisits.toLocaleString("en-IN") %>
                </strong>

                <span class="visitor-stat-small">
                    All recorded visits
                </span>

            </div>

        </div>


        <!-- UNIQUE VISITORS -->

        <div class="visitor-stat-card">

            <div class="visitor-stat-icon">
                <i class="bi bi-people"></i>
            </div>

            <div class="visitor-stat-content">

                <span class="visitor-stat-label">
                    Unique Visitors
                </span>

                <strong class="visitor-stat-value">
                    <%= uniqueVisitors.toLocaleString("en-IN") %>
                </strong>

                <span class="visitor-stat-small">
                    Based on unique IP addresses
                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MOST VISITED PAGES
    ====================================================== -->

    <section class="most-visited-card">


        <!-- HEADER -->

        <div class="most-visited-header">

            <div>

                <h2>
                    Most Visited Pages
                </h2>

                <p>
                    Page-wise visitor activity based on all recorded visits.
                </p>

            </div>

            <div class="most-visited-icon">
                <i class="bi bi-bar-chart-fill"></i>
            </div>

        </div>


        <% if (popularPages.length > 0) { %>


            <!-- =================================================
                 COLUMN CHART
            ================================================== -->

            <div class="page-chart-wrapper">

                <div class="page-chart">

                    <!-- Y AXIS -->

                    <div class="page-chart-y-axis">

                        <span>
                            <%= maxPageCount %>
                        </span>

                        <span>
                            <%= Math.round(maxPageCount * 0.75) %>
                        </span>

                        <span>
                            <%= Math.round(maxPageCount * 0.50) %>
                        </span>

                        <span>
                            <%= Math.round(maxPageCount * 0.25) %>
                        </span>

                        <span>
                            0
                        </span>

                    </div>


                    <!-- CHART AREA -->

                    <div class="page-chart-area">

                        <div class="page-chart-grid">

                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>

                        </div>


                        <!-- COLUMNS -->

                        <div class="page-chart-columns">

                            <% popularPages.forEach(function (item, index) { %>

                                <div class="page-chart-column">

                                    <div class="page-chart-value">
                                        <%= item.count %>
                                    </div>

                                    <div
                                        class="page-chart-bar"
                                        style="height:<%= Math.max(5, Math.round((item.count / maxPageCount) * 100)) %>%"
                                    >
                                    </div>

                                    <div class="page-chart-label">

                                        <span class="page-chart-rank">
                                            <%= index + 1 %>
                                        </span>

                                        <span
                                            class="page-chart-page"
                                            title="<%= item.page %>"
                                        >
                                            <%= item.page %>
                                        </span>

                                    </div>

                                </div>

                            <% }); %>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 PAGE SUMMARY
            ================================================== -->

            <div class="page-summary-list">

                <% popularPages.forEach(function (item, index) { %>

                    <div class="page-summary-item">

                        <div class="page-summary-left">

                            <span class="page-summary-rank">
                                <%= index + 1 %>
                            </span>

                            <span
                                class="page-summary-name"
                                title="<%= item.page %>"
                            >
                                <%= item.page %>
                            </span>

                        </div>

                        <div class="page-summary-right">

                            <strong>
                                <%= item.count.toLocaleString("en-IN") %>
                            </strong>

                            <span>
                                visits
                            </span>

                        </div>

                    </div>

                <% }); %>

            </div>


        <% } else { %>


            <!-- EMPTY STATE -->

            <div class="visitors-empty-state">

                <div class="visitors-empty-icon">
                    <i class="bi bi-bar-chart"></i>
                </div>

                <h3>
                    No Visitor Data Yet
                </h3>

                <p>
                    Page visit analytics will appear here once visitors start browsing the website.
                </p>

            </div>


        <% } %>


    </section>


</div>