
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Page Not Found | Yogita Patola Art
    </title>

    <meta
        name="description"
        content="The page you are looking for could not be found."
    >

    <link
        rel="icon"
        type="image/png"
        href="/images/favicon.png"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    >

    <!-- 404 PAGE CSS -->
    <link
        rel="stylesheet"
        href="/css/pages/404.css?v=2"
    >

</head>


<body class="error-body">


<section class="error-page">


    <!-- =====================================================
         BACKGROUND PATOLA SVG
    ====================================================== -->

    <div
        class="error-pattern"
        aria-hidden="true"
    >

        <svg
            class="patola-pattern-svg"
            viewBox="0 0 400 400"
            xmlns="http://www.w3.org/2000/svg"
        >

            <defs>

                <pattern
                    id="patolaDiamond"
                    width="80"
                    height="80"
                    patternUnits="userSpaceOnUse"
                >

                    <path
                        d="M40 4 L76 40 L40 76 L4 40 Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1"
                    />

                    <path
                        d="M40 17 L63 40 L40 63 L17 40 Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="0.8"
                    />

                    <path
                        d="
                            M40 4 L40 17
                            M40 63 L40 76
                            M4 40 L17 40
                            M63 40 L76 40
                        "
                        fill="none"
                        stroke="currentColor"
                        stroke-width="0.7"
                    />

                    <circle
                        cx="40"
                        cy="40"
                        r="4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="0.8"
                    />

                </pattern>

            </defs>


            <rect
                width="400"
                height="400"
                fill="url(#patolaDiamond)"
            />

        </svg>

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="error-container">

        <div class="error-content">


            <!-- =================================================
                 TOP ORNAMENT
            ================================================== -->

            <div class="error-ornament">

                <span class="ornament-line"></span>


                <svg
                    class="ornament-diamond"
                    viewBox="0 0 40 40"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >

                    <path
                        d="M20 2 L38 20 L20 38 L2 20 Z"
                    />

                    <path
                        d="M20 9 L31 20 L20 31 L9 20 Z"
                    />

                    <circle
                        cx="20"
                        cy="20"
                        r="3"
                    />

                </svg>


                <span class="ornament-line"></span>

            </div>


            <!-- =================================================
                 404 NUMBER
            ================================================== -->

            <div
                class="error-number"
                aria-label="404"
            >
                404
            </div>


            <!-- =================================================
                 LABEL
            ================================================== -->

            <div class="error-label">
                A LITTLE DETOUR
            </div>


            <!-- =================================================
                 TITLE
            ================================================== -->

            <h1 class="error-title">

                This Page Has Gone

                <span>
                    Off the Weave
                </span>

            </h1>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <p class="error-description">

                It seems the page you're looking for has been moved,
                removed, or is no longer part of our collection.

            </p>


            <!-- =================================================
                 ACTION BUTTONS
            ================================================== -->

            <div class="error-actions">


                <a
                    href="/"
                    class="error-btn error-btn-primary"
                >

                    <i
                        class="bi bi-house-door"
                        aria-hidden="true"
                    ></i>

                    <span>
                        Back to Home
                    </span>

                </a>


                <a
                    href="/collections"
                    class="error-btn error-btn-secondary"
                >

                    <span>
                        Explore Collections
                    </span>

                    <i
                        class="bi bi-arrow-right"
                        aria-hidden="true"
                    ></i>

                </a>


            </div>


            <!-- =================================================
                 BRAND
            ================================================== -->

            <div class="error-brand">

                <span></span>


                <div class="error-brand-name">
                    YOGITA PATOLA ART
                </div>


                <span></span>

            </div>


        </div>

    </div>


</section>


</body>

</html>

