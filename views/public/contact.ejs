
<%
    const sitePhone =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.sitePhone || ""
            : "";

    const siteEmail =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.siteEmail || ""
            : "";

    const whatsapp =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.whatsapp || ""
            : "";

    const instagram =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.instagram || ""
            : "";

    const facebook =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.facebook || ""
            : "";

    const youtube =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.youtube || ""
            : "";

    const address =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings.address || ""
            : "";

    const whatsappNumber = whatsapp.replace(/\D/g, "");

    const whatsappUrl = whatsappNumber
        ? `https://wa.me/${whatsappNumber}`
        : "";

    const phoneUrl = sitePhone
        ? `tel:${sitePhone.replace(/[^\d+]/g, "")}`
        : "";

    const emailUrl = siteEmail
        ? `mailto:${siteEmail}`
        : "";
%>

<%
    layout("layout", {
        title: title || "Contact Us | Yogita Patola Art",
        description:
            "Get in touch with Yogita Patola Art for Patola sarees, traditional textiles and product enquiries."
    });
%>

<%
    block("head").append(`
        <link rel="stylesheet" href="/css/pages/contact.css">
    `);
%>


<!-- =========================================================
     CONTACT PAGE
========================================================= -->

<section class="contact-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="contact-hero">

        <div class="contact-hero-inner">

            <span class="contact-eyebrow">
                GET IN TOUCH
            </span>

            <h1 class="contact-title">
                Contact Us
            </h1>

            <p class="contact-description">
                Have a question about our Patola sarees or products?
                Send us a message and we will be happy to assist you.
            </p>

        </div>

    </section>


    <!-- =====================================================
         CONTACT FORM
    ====================================================== -->

    <section class="contact-section">

        <div class="contact-container">

            <div class="contact-form-wrapper">

                <div class="contact-form-heading">

                    <span class="contact-form-eyebrow">
                        SEND A MESSAGE
                    </span>

                    <h2>
                        We'd Love to Hear From You
                    </h2>

                    <p>
                        Whether you have a product enquiry, need assistance,
                        or simply want to know more about Patola textiles,
                        feel free to reach out.
                    </p>

                </div>


                <!-- SUCCESS MESSAGE -->

                <% if (typeof success !== "undefined" && success) { %>

                    <div
                        class="contact-alert contact-alert-success"
                        role="alert"
                    >
                        <%= success %>
                    </div>

                <% } %>


                <!-- ERROR MESSAGE -->

                <% if (typeof error !== "undefined" && error) { %>

                    <div
                        class="contact-alert contact-alert-error"
                        role="alert"
                    >
                        <%= error %>
                    </div>

                <% } %>


                <!-- CONTACT FORM -->

                <form
                    action="/contact"
                    method="POST"
                    class="contact-form"
                    id="contactForm"
                >

                    <!-- NAME -->

                    <div class="contact-form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="contact-input"
                            placeholder="Enter your name"
                            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
                            required
                        >

                    </div>


                    <!-- EMAIL -->

                    <div class="contact-form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="contact-input"
                            placeholder="Enter your email address"
                            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                            required
                        >

                    </div>


                    <!-- PHONE -->

                    <div class="contact-form-group">

                        <label for="phone">
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            class="contact-input"
                            placeholder="Enter your phone number"
                            value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                        >

                    </div>


                    <!-- SUBJECT -->

                    <div class="contact-form-group">

                        <label for="subject">
                            Subject
                        </label>

                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            class="contact-input"
                            placeholder="What would you like to know?"
                            value="<%= typeof formData !== 'undefined' && formData.subject ? formData.subject : '' %>"
                            required
                        >

                    </div>


                    <!-- MESSAGE -->

                    <div class="contact-form-group">

                        <label for="message">
                            Message
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            class="contact-input contact-textarea"
                            rows="6"
                            placeholder="Write your message..."
                            required
                        ><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>

                    </div>


                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="contact-submit"
                        id="contactSubmit"
                    >

                        <span class="contact-submit-text">
                            Send Message
                        </span>

                        <span
                            class="contact-submit-loading"
                            aria-hidden="true"
                        >
                            Sending...
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </section>


    <!-- =====================================================
         REACH US DIRECTLY
    ====================================================== -->

    <section class="contact-direct-section">

        <div class="contact-container">

            <div class="contact-direct-header">

                <span class="contact-direct-eyebrow">
                    CONNECT WITH US
                </span>

                <h2 class="contact-direct-title">
                    Reach Us Directly
                </h2>

                <p class="contact-direct-description">
                    Prefer to connect directly? You can reach Yogita Patola Art
                    through the following channels.
                </p>

            </div>


            <div class="contact-direct-grid">


                <!-- =================================================
                     WHATSAPP & PHONE
                ================================================== -->

                <div class="contact-direct-card">

                    <div class="contact-direct-icon">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >

                            <path
                                d="M20.52 3.48A11.84 11.84 0 0 0 12.08 0
                                C5.53 0 .2 5.33.2 11.88
                                c0 2.09.55 4.13 1.6 5.92L.1 24
                                l6.35-1.66a11.87 11.87 0 0 0 5.63 1.43h.01
                                c6.55 0 11.88-5.33 11.88-11.88
                                0-3.18-1.24-6.17-3.45-8.41Z"
                            />

                            <path
                                d="M8.62 6.82c-.25-.56-.52-.57-.76-.58
                                h-.65c-.23 0-.6.09-.91.45
                                -.31.35-1.18 1.15-1.18 2.81
                                0 1.66 1.21 3.27 1.38 3.49
                                .17.22 2.33 3.56 5.64 4.84
                                2.79 1.08 3.36.87 3.97.81
                                .61-.05 1.97-.8 2.25-1.58
                                .28-.78.28-1.45.2-1.59
                                -.08-.14-.31-.22-.65-.39
                                -.35-.17-1.97-.97-2.28-1.08
                                -.31-.11-.53-.17-.76.17
                                -.22.35-.87 1.08-1.07 1.3
                                -.2.22-.39.25-.73.08
                                -.35-.17-1.46-.54-2.78-1.72
                                -1.03-.92-1.73-2.06-1.93-2.41
                                -.2-.35-.02-.54.15-.71
                                .15-.15.35-.39.52-.58
                                .17-.2.22-.35.34-.57
                                .11-.22.06-.42-.03-.59Z"
                            />

                        </svg>

                    </div>


                    <div class="contact-direct-content">

                        <h3 class="contact-direct-card-title">
                            Phone &amp; WhatsApp
                        </h3>


                        <% if (sitePhone) { %>

                            <a
                                href="<%= phoneUrl %>"
                                class="contact-direct-link contact-phone-link"
                            >
                                <%= sitePhone %>
                            </a>

                        <% } %>


                        <% if (whatsapp) { %>

                            <a
                                href="<%= whatsappUrl %>"
                                class="contact-direct-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                || <%= whatsapp %>
                            </a>

                        <% } %>


                        <% if (!sitePhone && !whatsapp) { %>

                            <span class="contact-direct-value">
                                Contact details coming soon
                            </span>

                        <% } %>


                        <p class="contact-direct-note">
                            For product enquiries and assistance.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     EMAIL
                ================================================== -->

                <div class="contact-direct-card">

                    <div class="contact-direct-icon">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >

                            <rect
                                x="3"
                                y="5"
                                width="18"
                                height="14"
                                rx="2"
                            />

                            <path
                                d="m3 7 9 6 9-6"
                            />

                        </svg>

                    </div>


                    <div class="contact-direct-content">

                        <h3 class="contact-direct-card-title">
                            Email
                        </h3>


                        <% if (siteEmail) { %>

                            <a
                                href="<%= emailUrl %>"
                                class="contact-direct-link"
                            >
                                <%= siteEmail %>
                            </a>

                        <% } else { %>

                            <span class="contact-direct-value">
                                Email details coming soon
                            </span>

                        <% } %>


                        <p class="contact-direct-note">
                            For general enquiries and product information.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     STUDIO & LOOM VISITS
                ================================================== -->

                <div class="contact-direct-card">

                    <div class="contact-direct-icon">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >

                            <path
                                d="M20 10c0 5-8 12-8 12S4 15 4 10
                                a8 8 0 1 1 16 0Z"
                            />

                            <circle
                                cx="12"
                                cy="10"
                                r="2.5"
                            />

                        </svg>

                    </div>


                    <div class="contact-direct-content">

                        <h3 class="contact-direct-card-title">
                            Studio &amp; Loom Visits
                        </h3>


                        <% if (address) { %>

                            <div class="contact-direct-value contact-address">
                                <%= address %>
                            </div>

                        <% } else { %>

                            <span class="contact-direct-value">
                                Address details coming soon
                            </span>

                        <% } %>


                        <p class="contact-direct-note">
                            Please contact us before planning a visit.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     FOLLOW ALONG
                ================================================== -->

                <div class="contact-direct-card">

                    <div class="contact-direct-icon">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >

                            <rect
                                x="3"
                                y="3"
                                width="18"
                                height="18"
                                rx="5"
                            />

                            <circle
                                cx="12"
                                cy="12"
                                r="4"
                            />

                            <circle
                                cx="17.5"
                                cy="6.5"
                                r="1"
                                class="instagram-dot"
                            />

                        </svg>

                    </div>


                    <div class="contact-direct-content">

                        <h3 class="contact-direct-card-title">
                            Follow Along
                        </h3>


                        <div class="contact-social-links">


                            <% if (instagram) { %>

                                <a
                                    href="<%= instagram %>"
                                    class="contact-direct-link contact-social-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >

                                    <svg
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >

                                        <rect
                                            x="3"
                                            y="3"
                                            width="18"
                                            height="18"
                                            rx="5"
                                        />

                                        <circle
                                            cx="12"
                                            cy="12"
                                            r="4"
                                        />

                                        <circle
                                            cx="17.5"
                                            cy="6.5"
                                            r="1"
                                        />

                                    </svg>

                                    Instagram

                                </a>

                            <% } %>


                            <% if (facebook) { %>

                                <a
                                    href="<%= facebook %>"
                                    class="contact-direct-link contact-social-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >

                                    <svg
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >

                                        <path
                                            d="M14 8h3V4h-3
                                            c-2.76 0-5 2.24-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9
                                            c0-.55.45-1 1-1Z"
                                        />

                                    </svg>

                                    Facebook

                                </a>

                            <% } %>


                            <% if (youtube) { %>

                                <a
                                    href="<%= youtube %>"
                                    class="contact-direct-link contact-social-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >

                                    <svg
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >

                                        <path
                                            d="M21.58 7.19
                                            a2.97 2.97 0 0 0-2.09-2.1
                                            C17.65 4.6 12 4.6 12 4.6
                                            s-5.65 0-7.49.49
                                            a2.97 2.97 0 0 0-2.09 2.1
                                            C1.93 9.03 1.93 12 1.93 12
                                            s0 2.97.49 4.81
                                            a2.97 2.97 0 0 0 2.09 2.1
                                            C6.35 19.4 12 19.4 12 19.4
                                            s5.65 0 7.49-.49
                                            a2.97 2.97 0 0 0 2.09-2.1
                                            C22.07 14.97 22.07 12 22.07 12
                                            s0-2.97-.49-4.81Z"
                                        />

                                        <path
                                            d="m10 15.5 5-3.5-5-3.5v7Z"
                                        />

                                    </svg>

                                    YouTube

                                </a>

                            <% } %>


                            <% if (!instagram && !facebook && !youtube) { %>

                                <span class="contact-direct-value">
                                    Social links coming soon
                                </span>

                            <% } %>

                        </div>


                        <p class="contact-direct-note">
                            Follow Yogita Patola Art for new collections and updates.
                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>


    <!-- =====================================================
         FAQ CTA
    ====================================================== -->

    <section class="contact-faq-section">

        <div class="contact-container">

            <div class="contact-faq-card">

                <div class="contact-faq-content">

                    <span class="contact-faq-eyebrow">
                        NEED QUICK ANSWERS?
                    </span>

                    <h2 class="contact-faq-title">
                        Have a Question?
                    </h2>

                    <p class="contact-faq-description">
                        Find answers about Patola sarees, care,
                        delivery, customization and more.
                    </p>

                </div>


                <a
                    href="/faq"
                    class="contact-faq-button"
                >
                    Visit Frequently Asked Questions
                    <span aria-hidden="true">→</span>
                </a>

            </div>

        </div>

    </section>

</section>


<!-- =========================================================
     CONTACT FORM JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const contactForm =
            document.getElementById("contactForm");

        const submitButton =
            document.getElementById("contactSubmit");

        const submitText =
            submitButton
                ? submitButton.querySelector(".contact-submit-text")
                : null;

        const loadingText =
            submitButton
                ? submitButton.querySelector(".contact-submit-loading")
                : null;


        if (!contactForm || !submitButton) {
            return;
        }


        contactForm.addEventListener("submit", function () {

            submitButton.disabled = true;


            if (submitText) {
                submitText.style.display = "none";
            }


            if (loadingText) {
                loadingText.style.display = "inline";
            }

        });

    });

</script>
