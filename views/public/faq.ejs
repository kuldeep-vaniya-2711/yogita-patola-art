                </div>


                <!-- =================================================
                     FAQ 7
                ================================================== -->

                <div class="faq-item">

                    <button
                        type="button"
                        class="faq-question"
                        aria-expanded="false"
                        aria-controls="faq-answer-7"
                    >

                        <span>
                            How can I contact Yogita Patola Art?
                        </span>

                        <span
                            class="faq-icon"
                            aria-hidden="true"
                        >
                            +
                        </span>

                    </button>


                    <div
                        class="faq-answer"
                        id="faq-answer-7"
                        hidden
                    >

                        <div class="faq-answer-inner">

                            <p>
                                You can contact us through the Contact Us page
                                for product enquiries, questions and other
                                assistance. You can also use the available
                                phone, WhatsApp, email and social media details
                                provided there.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FAQ 8
                ================================================== -->

                <div class="faq-item">

                    <button
                        type="button"
                        class="faq-question"
                        aria-expanded="false"
                        aria-controls="faq-answer-8"
                    >

                        <span>
                            How can I choose the right Patola saree?
                        </span>

                        <span
                            class="faq-icon"
                            aria-hidden="true"
                        >
                            +
                        </span>

                    </button>


                    <div
                        class="faq-answer"
                        id="faq-answer-8"
                        hidden
                    >

                        <div class="faq-answer-inner">

                            <p>
                                You can explore our collections and product
                                details to compare different styles, colours,
                                fabrics, techniques and availability. If you
                                need help choosing a particular piece, our
                                team can assist you with your enquiry.
                            </p>

                        </div>

                    </div>

                </div>


            </div>


            <!-- =================================================
                 STILL HAVE QUESTIONS
            ================================================== -->

            <div class="faq-contact-box">

                <div class="faq-contact-decoration">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <span class="faq-contact-eyebrow">
                    STILL HAVE A QUESTION?
                </span>

                <h2>
                    We’re Here to Help
                </h2>

                <p>
                    If you couldn't find the answer you're looking for,
                    feel free to reach out to us directly.
                </p>

                <a
                    href="/contact"
                    class="faq-contact-button"
                >
                    Contact Us
                </a>

            </div>


        </div>

    </section>

</section>


<!-- =========================================================
     FAQ JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const faqQuestions =
            document.querySelectorAll(".faq-question");


        faqQuestions.forEach(function (question) {

            question.addEventListener("click", function () {

                const isExpanded =
                    question.getAttribute("aria-expanded") === "true";

                const answerId =
                    question.getAttribute("aria-controls");

                const answer =
                    document.getElementById(answerId);

                const item =
                    question.closest(".faq-item");

                const icon =
                    question.querySelector(".faq-icon");


                /*
                 * Close all other FAQ items
                 */

                faqQuestions.forEach(function (otherQuestion) {

                    if (otherQuestion !== question) {

                        otherQuestion.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                        const otherAnswerId =
                            otherQuestion.getAttribute(
                                "aria-controls"
                            );

                        const otherAnswer =
                            document.getElementById(
                                otherAnswerId
                            );

                        const otherItem =
                            otherQuestion.closest(
                                ".faq-item"
                            );

                        const otherIcon =
                            otherQuestion.querySelector(
                                ".faq-icon"
                            );


                        if (otherAnswer) {
                            otherAnswer.hidden = true;
                        }

                        if (otherItem) {
                            otherItem.classList.remove(
                                "is-open"
                            );
                        }

                        if (otherIcon) {
                            otherIcon.textContent = "+";
                        }

                    }

                });


                /*
                 * Toggle current FAQ
                 */

                if (isExpanded) {

                    question.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    if (answer) {
                        answer.hidden = true;
                    }

                    if (item) {
                        item.classList.remove("is-open");
                    }

                    if (icon) {
                        icon.textContent = "+";
                    }

                } else {

                    question.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    if (answer) {
                        answer.hidden = false;
                    }

                    if (item) {
                        item.classList.add("is-open");
                    }

                    if (icon) {
                        icon.textContent = "−";
                    }

                }

            });

        });

    });

</script>