<%
layout("layout", {
    title: "Yogita Patola Art",
    description:
        "Handcrafted Patola Sarees and Traditional Indian Textiles",
    pageCss: "/css/pages/home.css"
});
%>


<%
/*
 * =========================================================
 * WEBSITE SETTINGS
 * =========================================================
 */

const siteSettings =
    typeof websiteSettings !== "undefined" &&
    websiteSettings
        ? websiteSettings
        : {};


/*
 * =========================================================
 * HERO SETTINGS
 * =========================================================
 */

const homeHeroHeading =
    siteSettings.heroHeading ||
    "Woven Heritage, Timeless Beauty.";


const homeHeroDescription =
    siteSettings.heroDescription ||
    "Discover the elegance of handcrafted Patola textiles, where centuries-old Indian artistry meets contemporary sophistication.";


const homeHeroImage =
    siteSettings.heroImage ||
    "";


/*
 * =========================================================
 * ABOUT SETTINGS
 * =========================================================
 */

const homeAboutHeading =
    siteSettings.aboutHeading ||
    "Preserving Tradition. Creating Legacy.";


const homeAboutDescription =
    siteSettings.aboutDescription ||
    "At Yogita Patola Art, we believe that traditional Indian textiles deserve to be experienced, celebrated and preserved.";


const homeAboutImage =
    siteSettings.aboutImage ||
    "";


/*
 * =========================================================
 * HERITAGE CARD IMAGES
 * =========================================================
 *
 * These are controlled from Admin > Settings.
 */

const heritageHandcraftedImage =
    siteSettings.heritageHandcraftedImage ||
    "";


const heritageIntricateImage =
    siteSettings.heritageIntricateImage ||
    "";


const heritageTimelessImage =
    siteSettings.heritageTimelessImage ||
    "";


/*
 * =========================================================
 * HEADING PARTS
 * =========================================================
 */

const heroParts =
    String(homeHeroHeading)
        .split(",");


const aboutParts =
    String(homeAboutHeading)
        .split(".");
%>


<div class="home-page">


    <!-- ==================================================
         HERO
    ================================================== -->

    <section
        class="home-hero"
        <% if (homeHeroImage) { %>
            style="background-image: url('<%= homeHeroImage %>');"
        <% } %>
    >

        <div class="home-hero-overlay"></div>


        <div class="home-container">

            <div class="home-hero-content">


                <div class="home-eyebrow">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        YOGITA PATOLA ART
                    </span>

                </div>


                <h1>

                    <%= heroParts[0] || "Woven Heritage" %>

                    <% if (heroParts.length > 1) { %>

                        <em>
                            <%= heroParts.slice(1).join(",") %>
                        </em>

                    <% } %>

                </h1>


                <p>
                    <%= homeHeroDescription %>
                </p>


                <div class="home-hero-actions">

                    <a
                        href="/collections"
                        class="home-btn home-btn-primary"
                    >
                        Explore Collection
                        <span>→</span>
                    </a>


                    <a
                        href="/about"
                        class="home-btn home-btn-outline"
                    >
                        Our Story
                    </a>

                </div>


            </div>

        </div>

    </section>



    <!-- ==================================================
         HERITAGE
    ================================================== -->

    <section class="home-heritage">

        <div class="home-container">


            <div class="home-section-heading home-centered">


                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        OUR HERITAGE
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>

                    A Tradition Woven

                    <em>
                        Into Every Thread
                    </em>

                </h2>


                <div class="home-heading-ornament">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>


                <p>

                    Patola is more than a textile.
                    It is a celebration
                    of patience, precision,
                    craftsmanship and India's
                    rich cultural heritage.

                </p>

            </div>



            <div class="home-heritage-grid">


                <!-- ==================================================
                     CARD 01 — HANDCRAFTED
                ================================================== -->

                <article class="home-heritage-card">

                    <% if (heritageHandcraftedImage) { %>

                        <div
                            class="home-heritage-card-bg"
                            style="background-image: url('<%= heritageHandcraftedImage %>');"
                        ></div>

                    <% } else { %>

                        <div class="home-heritage-card-bg"></div>

                    <% } %>


                    <div class="home-heritage-card-overlay"></div>


                    <div class="home-card-number">
                        01
                    </div>


                    <div class="home-heritage-icon">
                        ✧
                    </div>


                    <div class="home-heritage-card-content">

                        <h3>
                            Handcrafted
                        </h3>


                        <p>
                            Every piece reflects the dedication,
                            patience and skill of traditional artisans.
                        </p>

                    </div>

                </article>



                <!-- ==================================================
                     CARD 02 — INTRICATE ART
                ================================================== -->

                <article class="home-heritage-card">

                    <% if (heritageIntricateImage) { %>

                        <div
                            class="home-heritage-card-bg"
                            style="background-image: url('<%= heritageIntricateImage %>');"
                        ></div>

                    <% } else { %>

                        <div class="home-heritage-card-bg"></div>

                    <% } %>


                    <div class="home-heritage-card-overlay"></div>


                    <div class="home-card-number">
                        02
                    </div>


                    <div class="home-heritage-icon">
                        ◈
                    </div>


                    <div class="home-heritage-card-content">

                        <h3>
                            Intricate Art
                        </h3>


                        <p>
                            Detailed patterns and precise weaving
                            create the unmistakable Patola character.
                        </p>

                    </div>

                </article>



                <!-- ==================================================
                     CARD 03 — TIMELESS
                ================================================== -->

                <article class="home-heritage-card">

                    <% if (heritageTimelessImage) { %>

                        <div
                            class="home-heritage-card-bg"
                            style="background-image: url('<%= heritageTimelessImage %>');"
                        ></div>

                    <% } else { %>

                        <div class="home-heritage-card-bg"></div>

                    <% } %>


                    <div class="home-heritage-card-overlay"></div>


                    <div class="home-card-number">
                        03
                    </div>


                    <div class="home-heritage-icon">
                        ◷
                    </div>


                    <div class="home-heritage-card-content">

                        <h3>
                            Timeless
                        </h3>


                        <p>
                            Traditional techniques transformed into
                            pieces designed to be treasured for generations.
                        </p>

                    </div>

                </article>


            </div>

        </div>

    </section>



    <!-- ==================================================
         FEATURED PRODUCTS
    ================================================== -->

    <section class="home-featured">

        <div class="home-container">


            <div class="home-section-heading">


                <div class="home-eyebrow">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        CURATED COLLECTION
                    </span>

                </div>


                <h2>

                    Featured

                    <em>
                        Patola
                    </em>

                </h2>


                <p>

                    Discover selected pieces that represent
                    the beauty and craftsmanship of Patola.

                </p>

            </div>



            <div class="home-products-grid">

                <% if (
                    typeof featuredProducts !== "undefined" &&
                    Array.isArray(featuredProducts) &&
                    featuredProducts.length
                ) { %>


                    <% featuredProducts.forEach(product => { %>

                        <%- include(
                            "../partials/product-card",
                            {
                                product
                            }
                        ) %>

                    <% }) %>


                <% } else { %>


                    <div class="home-empty-state">

                        <div class="home-empty-icon">
                            ✦
                        </div>

                        <h3>
                            Collection Coming Soon
                        </h3>

                        <p>
                            Our handcrafted Patola collection
                            is being prepared.
                        </p>

                        <a href="/collections">
                            Explore Collections →
                        </a>

                    </div>


                <% } %>

            </div>



            <div class="home-centered home-section-action">

                <a
                    href="/collections"
                    class="home-btn home-btn-dark"
                >
                    View All Collections
                    <span>→</span>
                </a>

            </div>


        </div>

    </section>



    <!-- ==================================================
         ABOUT
    ================================================== -->

    <section class="home-about">

        <div class="home-container">

            <div class="home-about-grid">


                <div class="home-about-image">


                    <% if (homeAboutImage) { %>

                        <img
                            src="<%= homeAboutImage %>"
                            alt="Yogita Patola Art"
                            loading="lazy"
                        >


                    <% } else { %>


                        <div class="home-about-placeholder">

                            <span>
                                YOGITA
                            </span>

                            <strong>
                                PATOLA ART
                            </strong>

                            <small>
                                TRADITION • ART • LEGACY
                            </small>

                        </div>


                    <% } %>


                    <div class="home-about-image-overlay"></div>

                    <div class="home-about-frame"></div>


                </div>



                <div class="home-about-content">


                    <div class="home-eyebrow">

                        <span class="home-eyebrow-line"></span>

                        <span>
                            OUR STORY
                        </span>

                    </div>


                    <h2>


                        <%= aboutParts[0] || "Preserving Tradition" %>


                        <% if (aboutParts.length > 1) { %>

                            <em>
                                <%= aboutParts.slice(1).join(".") %>
                            </em>

                        <% } %>


                    </h2>


                    <div class="home-heading-ornament home-heading-ornament-left">

                        <span></span>

                        <i>✦</i>

                        <span></span>

                    </div>


                    <p class="home-about-lead">
                        <%= homeAboutDescription %>
                    </p>


                    <p class="home-about-text">

                        Through generations of knowledge,
                        careful craftsmanship and respect for
                        traditional techniques, we create
                        textiles that connect heritage with
                        contemporary elegance.

                    </p>


                    <a
                        href="/about"
                        class="home-text-link"
                    >

                        Discover Our Story

                        <span>
                            →
                        </span>

                    </a>


                </div>


            </div>

        </div>

    </section>



    <!-- ==================================================
         VALUES
    ================================================== -->

    <section class="home-values">

        <div class="home-container">


            <div class="home-section-heading home-centered">


                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        WHY PATOLA
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>

                    Crafted With

                    <em>
                        Purpose
                    </em>

                </h2>


                <div class="home-heading-ornament">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>


            </div>



            <div class="home-values-grid">


                <div class="home-value-item">

                    <span class="home-value-number">
                        01
                    </span>

                    <div class="home-value-icon">
                        ✧
                    </div>

                    <h3>
                        Authenticity
                    </h3>

                    <p>

                        Honouring traditional techniques
                        and authentic Patola craftsmanship.

                    </p>

                </div>



                <div class="home-value-item">

                    <span class="home-value-number">
                        02
                    </span>

                    <div class="home-value-icon">
                        ◈
                    </div>

                    <h3>
                        Precision
                    </h3>

                    <p>

                        Every motif and thread is created
                        with patience and extraordinary care.

                    </p>

                </div>



                <div class="home-value-item">

                    <span class="home-value-number">
                        03
                    </span>

                    <div class="home-value-icon">
                        ♡
                    </div>

                    <h3>
                        Legacy
                    </h3>

                    <p>

                        Creating textiles that can be
                        treasured across generations.

                    </p>

                </div>



                <div class="home-value-item">

                    <span class="home-value-number">
                        04
                    </span>

                    <div class="home-value-icon">
                        ◉
                    </div>

                    <h3>
                        Elegance
                    </h3>

                    <p>

                        Timeless Indian artistry interpreted
                        with refined contemporary sensibility.

                    </p>

                </div>


            </div>

        </div>

    </section>



    <!-- ==================================================
         FINAL CTA
    ================================================== -->

    <section class="home-final-cta">

        <div class="home-final-cta-pattern"></div>

        <div class="home-final-cta-overlay"></div>


        <div class="home-container">


            <div class="home-final-cta-content">


                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        BEGIN YOUR JOURNEY
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>

                    Wear a Piece of

                    <em>
                        Heritage
                    </em>

                </h2>


                <p>

                    Explore handcrafted Patola textiles
                    created with tradition, artistry and love.

                </p>


                <a
                    href="/collections"
                    class="home-btn home-btn-primary"
                >

                    Explore Collection

                    <span>
                        →
                    </span>

                </a>


            </div>

        </div>

    </section>


</div>