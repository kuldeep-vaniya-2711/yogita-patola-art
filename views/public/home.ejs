<%
layout("layout", {
title: "Yogita Patola Art",
description: "Handcrafted Patola Sarees and Traditional Indian Textiles",
pageCss: "/css/pages/home.css"
});
%>

<%
/* =========================================================
WEBSITE SETTINGS
========================================================= */

const siteSettings =
typeof websiteSettings !== "undefined" && websiteSettings
? websiteSettings
: (
typeof settings !== "undefined" && settings
? settings
: {}
);

/* =========================================================
HERO SETTINGS
========================================================= */

const homeHeroHeading =
siteSettings.heroHeading ||
"The Art of Patola, Woven Into Legacy";

const homeHeroDescription =
siteSettings.heroDescription ||
"Discover the timeless beauty of handcrafted Patola textiles, created with patience, precision and generations of tradition.";

const homeHeroImage =
siteSettings.heroImage ||
"";

/* =========================================================
ABOUT SETTINGS
========================================================= */

const homeAboutHeading =
siteSettings.aboutHeading ||
"A Legacy Woven Into Every Thread.";

const homeAboutDescription =
siteSettings.aboutDescription ||
"Yogita Patola Art celebrates the timeless artistry of Indian handloom traditions through carefully crafted textiles.";

const homeAboutImage =
siteSettings.aboutImage ||
"";

/* =========================================================
HERITAGE IMAGES
========================================================= */

const heritageHandcraftedImage =
siteSettings.heritageHandcraftedImage ||
"";

const heritageIntricateImage =
siteSettings.heritageIntricateImage ||
"";

const heritageTimelessImage =
siteSettings.heritageTimelessImage ||
"";

/* =========================================================
HERO / ABOUT HEADING PARTS
========================================================= */

const heroParts =
String(homeHeroHeading).split(",");

const aboutParts =
String(homeAboutHeading).split(".");

/* =========================================================
REVIEWS
========================================================= */

const reviews =
Array.isArray(homeReviews)
? homeReviews
: [];
%>

<div class="home-page"> 

<!-- ===================================================== 
     HERO 
====================================================== --> 

<section 
    class="home-hero" 
    <% if (homeHeroImage) { %> 
        style="background-image: url('<%= homeHeroImage %>');" 
    <% } %> 
> 

```
<div class="home-hero-overlay"></div> 


<div class="home-container"> 

    <div class="home-hero-content"> 

        <span class="home-eyebrow"> 
            YOGITA PATOLA ART 
        </span> 


        <h1 class="home-hero-heading"> 

            <% heroParts.forEach((part, index) => { %> 

                <span> 
                    <%= part.trim() %> 
                </span> 

            <% }) %> 

        </h1> 


        <div class="home-heading-ornament"> 
            <span></span> 
            <i class="bi bi-diamond-fill"></i> 
            <span></span> 
        </div> 


        <p class="home-hero-description"> 
            <%= homeHeroDescription %> 
        </p> 


        <div class="home-hero-actions"> 

            <a 
                href="/collections" 
                class="home-btn home-btn-primary" 
            > 
                Explore Collection 
                <i class="bi bi-arrow-right"></i> 
            </a> 


            <a 
                href="/about" 
                class="home-btn home-btn-outline" 
            > 
                Our Story 
            </a> 

        </div> 

    </div> 

</div> 
```

</section> 

<!-- ===================================================== 
     HERITAGE 
====================================================== --> 

<section class="home-heritage"> 

```
<div class="home-container"> 

    <div class="home-section-intro"> 

        <span class="home-eyebrow"> 
            OUR HERITAGE 
        </span> 


        <h2 class="home-section-heading"> 
            A Tradition Woven Into Every Thread 
        </h2> 


        <div class="home-heading-ornament"> 
            <span></span> 
            <i class="bi bi-diamond-fill"></i> 
            <span></span> 
        </div> 


        <p> 
            Rooted in India's rich handloom heritage, 
            Patola is an art of extraordinary patience, 
            precision and craftsmanship. Every motif, 
            colour and thread carries the story of a 
            tradition passed through generations. 
        </p> 

    </div> 


    <div class="home-heritage-grid"> 


        <article 
            class="home-heritage-card" 
            <% if (heritageHandcraftedImage) { %> 
                style="background-image: url('<%= heritageHandcraftedImage %>');" 
            <% } %> 
        > 

            <div class="home-heritage-card-overlay"></div> 

            <div class="home-heritage-card-number"> 
                01 
            </div> 

            <div class="home-heritage-card-icon"> 
                <i class="bi bi-hand-index-thumb"></i> 
            </div> 

            <div class="home-heritage-card-content"> 

                <h3> 
                    Handcrafted 
                </h3> 

                <p> 
                    Each piece is created with 
                    patience, skill and the human touch. 
                </p> 

            </div> 

        </article> 


        <article 
            class="home-heritage-card" 
            <% if (heritageIntricateImage) { %> 
                style="background-image: url('<%= heritageIntricateImage %>');" 
            <% } %> 
        > 

            <div class="home-heritage-card-overlay"></div> 

            <div class="home-heritage-card-number"> 
                02 
            </div> 

            <div class="home-heritage-card-icon"> 
                <i class="bi bi-grid-3x3-gap"></i> 
            </div> 

            <div class="home-heritage-card-content"> 

                <h3> 
                    Intricate Art 
                </h3> 

                <p> 
                    Every motif demands precision, 
                    balance and extraordinary attention to detail. 
                </p> 

            </div> 

        </article> 


        <article 
            class="home-heritage-card" 
            <% if (heritageTimelessImage) { %> 
                style="background-image: url('<%= heritageTimelessImage %>');" 
            <% } %> 
        > 

            <div class="home-heritage-card-overlay"></div> 

            <div class="home-heritage-card-number"> 
                03 
            </div> 

            <div class="home-heritage-card-icon"> 
                <i class="bi bi-hourglass-split"></i> 
            </div> 

            <div class="home-heritage-card-content"> 

                <h3> 
                    Timeless 
                </h3> 

                <p> 
                    A heritage textile designed to 
                    remain beautiful across generations. 
                </p> 

            </div> 

        </article> 


    </div> 

</div> 
```

</section> 

<!-- ===================================================== 
     FEATURED PATOLAS 
====================================================== --> 

<section class="home-featured"> 

```
<div class="home-container"> 

    <div class="home-section-intro"> 

        <span class="home-eyebrow"> 
            CURATED COLLECTION 
        </span> 

        <h2 class="home-section-heading"> 
            Featured Patola 
        </h2> 

        <div class="home-heading-ornament"> 
            <span></span> 
            <i class="bi bi-diamond-fill"></i> 
            <span></span> 
        </div> 

        <p> 
            Explore a carefully selected collection of 
            handcrafted Patola sarees and traditional 
            Indian textiles. 
        </p> 

    </div> 


    <% if ( 
        Array.isArray(featuredProducts) && 
        featuredProducts.length 
    ) { %> 

        <div class="home-products-grid"> 

            <% featuredProducts.forEach(product => { %> 

                <%- include( 
                    "../partials/product-card", 
                    { 
                        product 
                    } 
                ) %> 

            <% }) %> 

        </div> 

    <% } else { %> 

        <div class="home-featured-empty"> 

            <i class="bi bi-flower1"></i> 

            <h3> 
                Our Collection Is Being Curated 
            </h3> 

            <p> 
                Beautiful handcrafted Patola pieces 
                will be available here soon. 
            </p> 

        </div> 

    <% } %> 


    <div class="home-section-action"> 

        <a 
            href="/collections" 
            class="home-btn home-btn-primary" 
        > 
            View All Collections 
            <i class="bi bi-arrow-right"></i> 
        </a> 

    </div> 

</div> 


</section> 


<!-- ===================================================== 
     CRAFTED BY TRADITION 
====================================================== --> 

<section class="home-crafted"> 


<div class="home-container"> 

    <div class="home-section-intro"> 

        <span class="home-eyebrow"> 
            CRAFTED BY TRADITION 
        </span> 

        <h2 class="home-section-heading"> 
            One saree, up to nine months on the loom 
        </h2> 

        <div class="home-heading-ornament"> 
            <span></span> 
            <i class="bi bi-diamond-fill"></i> 
            <span></span> 
        </div> 

        <p> 
            A Patola saree begins long before it reaches 
            the loom. Raw mulberry silk is prepared with 
            care, while warp and weft threads are 
            meticulously planned so that the design meets 
            perfectly during weaving. 
        </p> 

        <p> 
            On the pit loom, every thread is aligned by 
            hand. The process is slow, deliberate and 
            deeply connected to the traditions that have 
            shaped Indian handloom artistry for generations. 
        </p> 

    </div> 


    <div class="home-crafted-process"> 

        <article class="home-process-item"> 

            <span class="home-process-number"> 
                01 
            </span> 

            <div class="home-process-icon"> 
                <i class="bi bi-pencil-square"></i> 
            </div> 

            <div class="home-process-content"> 

                <span class="home-process-label"> 
                    Design 
                </span> 

                <h3> 
                    Charting the motif 
                </h3> 

                <p> 
                    Every motif begins with careful planning, 
                    proportion and precision. 
                </p> 

            </div> 

        </article> 


        <article class="home-process-item"> 

            <span class="home-process-number"> 
                02 
            </span> 

            <div class="home-process-icon"> 
                <i class="bi bi-link-45deg"></i> 
            </div> 

            <div class="home-process-content"> 

                <span class="home-process-label"> 
                    Tying 
                </span> 

                <h3> 
                    Binding the resist 
                </h3> 

                <p> 
                    Sections of silk are tied carefully 
                    to protect the planned pattern. 
                </p> 

            </div> 

        </article> 


        <article class="home-process-item"> 

            <span class="home-process-number"> 
                03 
            </span> 

            <div class="home-process-icon"> 
                <i class="bi bi-droplet-half"></i> 
            </div> 

            <div class="home-process-content"> 

                <span class="home-process-label"> 
                    Dyeing 
                </span> 

                <h3> 
                    Layering colour 
                </h3> 

                <p> 
                    Colours are built layer by layer, 
                    following the exact design. 
                </p> 

            </div> 

        </article> 


        <article class="home-process-item"> 

            <span class="home-process-number"> 
                04 
            </span> 

            <div class="home-process-icon"> 
                <i class="bi bi-grid-1x2"></i> 
            </div> 

            <div class="home-process-content"> 

                <span class="home-process-label"> 
                    Weaving 
                </span> 

                <h3> 
                    Aligning by hand 
                </h3> 

                <p> 
                    Warp and weft come together thread by 
                    thread to reveal the final design. 
                </p> 

            </div> 

        </article> 

    </div> 

</div> 
```

</section> 

