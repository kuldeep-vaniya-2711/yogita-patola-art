
<%
layout("layout", {
    title: "Yogita Patola Art",
    description: "Handcrafted Patola Sarees and Traditional Indian Textiles"
});
%>

<%
/*
 * =========================================================
 * HOME PAGE CSS
 * =========================================================
 */

block("head").append(`
    <link
        rel="stylesheet"
        href="/css/pages/home.css"
    >
`);


/*
 * =========================================================
 * WEBSITE SETTINGS
 * =========================================================
 */

const siteSettings =
    typeof websiteSettings !== "undefined" &&
    websiteSettings
        ? websiteSettings
        : {};


/* =========================================================
   HERO SETTINGS
   ========================================================= */

const homeHeroHeading =
    siteSettings.heroHeading ||
    "Woven Heritage, Timeless Beauty.";

const homeHeroDescription =
    siteSettings.heroDescription ||
    "Discover the elegance of handcrafted Patola textiles, where centuries-old Indian artistry meets contemporary sophistication.";

const homeHeroImage =
    siteSettings.heroImage ||
    "";


/* =========================================================
   ABOUT SETTINGS
   ========================================================= */

const homeAboutHeading =
    siteSettings.aboutHeading ||
    "Preserving Tradition. Creating Legacy.";

const homeAboutDescription =
    siteSettings.aboutDescription ||
    "At Yogita Patola Art, we believe that traditional Indian textiles deserve to be experienced, celebrated and preserved.";

const homeAboutImage =
    siteSettings.aboutImage ||
    "";


/* =========================================================
   HERO HEADING
   ========================================================= */

const heroParts =
    String(homeHeroHeading).split(",");


/* =========================================================
   ABOUT HEADING
   ========================================================= */

const aboutParts =
    String(homeAboutHeading).split(".");
%>


<div class="home-page">


    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-container">

            <div class="home-hero-grid">


                <div class="home-hero-content">

                    <div class="home-eyebrow">

                        <span class="home-eyebrow-line"></span>

                        <span>
                            THE ART OF PATOLA
                        </span>

                    </div>


                    <h1 class="home-hero-title">

                        <% if (heroParts.length > 1) { %>

                            <span class="home-hero-title-main">
                                <%= heroParts[0].trim() %>,
                            </span>

                            <span class="home-hero-title-accent">
                                <%= heroParts.slice(1).join(",").trim() %>
                            </span>

                        <% } else { %>

                            <span class="home-hero-title-main">
                                <%= homeHeroHeading %>
                            </span>

                        <% } %>

                    </h1>


                    <p class="home-hero-description">
                        <%= homeHeroDescription %>
                    </p>


                    <div class="home-hero-actions">

                        <a
                            href="/collections"
                            class="home-btn home-btn-primary"
                        >
                            <span>
                                Explore Collection
                            </span>

                            <span class="home-btn-arrow">
                                →
                            </span>
                        </a>


                        <a
                            href="/about"
                            class="home-btn home-btn-secondary"
                        >
                            <span>
                                Our Story
                            </span>
                        </a>

                    </div>


                    <div class="home-hero-meta">

                        <div class="home-meta-item">

                            <strong>
                                01
                            </strong>

                            <span>
                                Handcrafted
                            </span>

                        </div>


                        <div class="home-meta-divider"></div>


                        <div class="home-meta-item">

                            <strong>
                                02
                            </strong>

                            <span>
                                Heritage
                            </span>

                        </div>


                        <div class="home-meta-divider"></div>


                        <div class="home-meta-item">

                            <strong>
                                03
                            </strong>

                            <span>
                                Timeless
                            </span>

                        </div>

                    </div>

                </div>


                <div class="home-hero-visual">

                    <div class="home-hero-image-wrap">

                        <div class="home-hero-image-frame">

                            <% if (homeHeroImage) { %>

                                <img
                                    src="<%= homeHeroImage %>"
                                    alt="<%= homeHeroHeading %>"
                                    class="home-hero-image"
                                >

                            <% } else { %>

                                <div class="home-image-placeholder">

                                    <div class="home-placeholder-icon">
                                        ✦
                                    </div>

                                    <div class="home-placeholder-title">
                                        Patola Heritage
                                    </div>

                                    <div class="home-placeholder-subtitle">
                                        Handcrafted Indian Textiles
                                    </div>

                                </div>

                            <% } %>


                            <div class="home-image-overlay"></div>

                        </div>


                        <div class="home-hero-gold-frame"></div>


                        <div class="home-hero-floating-card">

                            <span class="home-floating-small">
                                WOVEN WITH
                            </span>

                            <strong>
                                Heritage
                            </strong>

                            <span class="home-floating-number">
                                EST. CRAFT
                            </span>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- =====================================================
         HERITAGE INTRO
         ===================================================== -->

    <section class="home-heritage">

        <div class="home-container">

            <div class="home-section-heading home-centered">

                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        OUR HERITAGE
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>
                    A Tradition Woven
                    <em>Into Every Thread</em>
                </h2>


                <div class="home-heading-ornament">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>


                <p>
                    Patola is more than a textile. It is a celebration
                    of patience, precision, craftsmanship and India's
                    rich cultural heritage.
                </p>

            </div>


            <div class="home-heritage-grid">


                <article class="home-heritage-card">

                    <div class="home-card-number">
                        01
                    </div>

                    <div class="home-heritage-icon">
                        ✧
                    </div>

                    <h3>
                        Handcrafted
                    </h3>

                    <p>
                        Every piece reflects the dedication,
                        patience and skill of traditional artisans.
                    </p>

                </article>


                <article class="home-heritage-card">

                    <div class="home-card-number">
                        02
                    </div>

                    <div class="home-heritage-icon">
                        ◈
                    </div>

                    <h3>
                        Intricate Art
                    </h3>

                    <p>
                        Detailed patterns and precise weaving
                        create the unmistakable Patola character.
                    </p>

                </article>


                <article class="home-heritage-card">

                    <div class="home-card-number">
                        03
                    </div>

                    <div class="home-heritage-icon">
                        ◷
                    </div>

                    <h3>
                        Timeless
                    </h3>

                    <p>
                        Traditional techniques transformed into
                        pieces designed to be treasured for generations.
                    </p>

                </article>


            </div>

        </div>

    </section>



    <!-- =====================================================
         FEATURED PRODUCTS
         ===================================================== -->

    <section class="home-products">

        <div class="home-container">


            <div class="home-products-header">

                <div>

                    <div class="home-eyebrow">

                        <span class="home-eyebrow-line"></span>

                        <span>
                            CURATED FOR YOU
                        </span>

                    </div>


                    <h2>
                        Featured
                        <em>Collection</em>
                    </h2>

                </div>


                <a
                    href="/products"
                    class="home-view-all"
                >
                    <span>
                        View All Products
                    </span>

                    <span>
                        →
                    </span>
                </a>

            </div>



            <% if (
                Array.isArray(featuredProducts) &&
                featuredProducts.length > 0
            ) { %>


                <div class="home-product-grid">


                    <% featuredProducts.forEach(function(product, index) { %>


                        <article class="home-product-card">


                            <a
                                href="/products/<%= product._id %>"
                                class="home-product-image-link"
                            >

                                <div class="home-product-image-wrap">


                                    <% if (
                                        Array.isArray(product.images) &&
                                        product.images.length > 0
                                    ) { %>

                                        <img
                                            src="<%= product.images[0] %>"
                                            alt="<%= product.name || 'Patola Product' %>"
                                            class="home-product-image"
                                            loading="lazy"
                                        >

                                    <% } else { %>

                                        <div class="home-product-placeholder">
                                            ✦
                                        </div>

                                    <% } %>


                                    <% if (product.featured) { %>

                                        <span class="home-product-badge">
                                            Featured
                                        </span>

                                    <% } %>


                                    <span class="home-product-view">
                                        View Piece →
                                    </span>


                                </div>

                            </a>



                            <div class="home-product-info">

                                <span class="home-product-category">
                                    <%= product.category || "Patola Collection" %>
                                </span>


                                <h3 class="home-product-name">

                                    <a
                                        href="/products/<%= product._id %>"
                                    >
                                        <%= product.name || "Patola Product" %>
                                    </a>

                                </h3>


                                <% if (
                                    product.price !== undefined &&
                                    product.price !== null &&
                                    product.price !== ""
                                ) { %>

                                    <div class="home-product-bottom">

                                        <span class="home-product-price">
                                            ₹<%= Number(
                                                product.price
                                            ).toLocaleString("en-IN") %>
                                        </span>


                                        <span class="home-product-index">
                                            0<%= index + 1 %>
                                        </span>

                                    </div>

                                <% } %>

                            </div>


                        </article>


                    <% }) %>


                </div>


            <% } else { %>


                <div class="home-empty-products">

                    <div class="home-empty-icon">
                        ✦
                    </div>

                    <h3>
                        Collection Coming Soon
                    </h3>

                    <p>
                        Our handcrafted Patola collection
                        will appear here.
                    </p>

                    <a href="/products">
                        Explore Products →
                    </a>

                </div>


            <% } %>


        </div>

    </section>



    <!-- =====================================================
         COLLECTIONS
         ===================================================== -->

    <section class="home-collections">

        <div class="home-container">


            <div class="home-section-heading home-centered">

                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        EXPLORE
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>
                    Our <em>Collections</em>
                </h2>


                <div class="home-heading-ornament">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>

            </div>



            <div class="home-collection-grid">


                <a
                    href="/products?category=Patola%20Sarees"
                    class="home-collection-card"
                >

                    <div class="home-collection-number">
                        01
                    </div>

                    <div class="home-collection-content">

                        <span>
                            SIGNATURE
                        </span>

                        <h3>
                            Patola
                            <br>
                            Sarees
                        </h3>

                        <p>
                            Iconic handwoven masterpieces
                            created with timeless artistry.
                        </p>

                        <div class="home-collection-arrow">
                            →
                        </div>

                    </div>

                </a>



                <a
                    href="/products?category=Double%20Ikat%20Sarees"
                    class="home-collection-card"
                >

                    <div class="home-collection-number">
                        02
                    </div>

                    <div class="home-collection-content">

                        <span>
                            PRECISION
                        </span>

                        <h3>
                            Double
                            <br>
                            Ikat
                        </h3>

                        <p>
                            Precision woven from both sides
                            with remarkable symmetry.
                        </p>

                        <div class="home-collection-arrow">
                            →
                        </div>

                    </div>

                </a>



                <a
                    href="/products?category=Single%20Ikat%20Sarees"
                    class="home-collection-card"
                >

                    <div class="home-collection-number">
                        03
                    </div>

                    <div class="home-collection-content">

                        <span>
                            CLASSIC
                        </span>

                        <h3>
                            Single
                            <br>
                            Ikat
                        </h3>

                        <p>
                            Elegant traditional artistry
                            for contemporary wardrobes.
                        </p>

                        <div class="home-collection-arrow">
                            →
                        </div>

                    </div>

                </a>



                <a
                    href="/products?category=Dupattas"
                    class="home-collection-card"
                >

                    <div class="home-collection-number">
                        04
                    </div>

                    <div class="home-collection-content">

                        <span>
                            MODERN HERITAGE
                        </span>

                        <h3>
                            Patola
                            <br>
                            Dupattas
                        </h3>

                        <p>
                            Heritage craftsmanship
                            for modern wardrobes.
                        </p>

                        <div class="home-collection-arrow">
                            →
                        </div>

                    </div>

                </a>


            </div>

        </div>

    </section>



    <!-- =====================================================
         ABOUT
         ===================================================== -->

    <section class="home-about">

        <div class="home-container">

            <div class="home-about-grid">


                <div class="home-about-visual">

                    <div class="home-about-image-wrap">

                        <div class="home-about-image-frame">

                            <% if (homeAboutImage) { %>

                                <img
                                    src="<%= homeAboutImage %>"
                                    alt="<%= homeAboutHeading %>"
                                    class="home-about-image"
                                    loading="lazy"
                                >

                            <% } else { %>

                                <div class="home-image-placeholder home-about-placeholder">

                                    <div class="home-placeholder-icon">
                                        ✦
                                    </div>

                                    <div class="home-placeholder-title">
                                        Crafted With Care
                                    </div>

                                    <div class="home-placeholder-subtitle">
                                        Tradition • Art • Legacy
                                    </div>

                                </div>

                            <% } %>


                            <div class="home-image-overlay"></div>

                        </div>


                        <div class="home-about-label">

                            <span>
                                THE ART
                            </span>

                            <strong>
                                OF PATOLA
                            </strong>

                        </div>

                    </div>

                </div>



                <div class="home-about-content">

                    <div class="home-eyebrow">

                        <span class="home-eyebrow-line"></span>

                        <span>
                            THE YOGITA PATOLA ART STORY
                        </span>

                    </div>


                    <h2>

                        <% if (aboutParts.length > 1) { %>

                            <span>
                                <%= aboutParts[0].trim() %>.
                            </span>

                            <em>
                                <%= aboutParts.slice(1).join(".").trim() %>
                            </em>

                        <% } else { %>

                            <span>
                                <%= homeAboutHeading %>
                            </span>

                        <% } %>

                    </h2>


                    <div class="home-about-divider"></div>


                    <p class="home-about-lead">
                        <%= homeAboutDescription %>
                    </p>


                    <p class="home-about-text">
                        Our collection brings together the beauty
                        of Patola craftsmanship with a refined,
                        contemporary approach — preserving the soul
                        of the craft while celebrating its place
                        in today's world.
                    </p>


                    <a
                        href="/about"
                        class="home-text-link"
                    >
                        <span>
                            Discover Our Story
                        </span>

                        <span>
                            →
                        </span>
                    </a>

                </div>


            </div>

        </div>

    </section>



    <!-- =====================================================
         VALUES
         ===================================================== -->

    <section class="home-values">

        <div class="home-container">


            <div class="home-section-heading home-centered">

                <div class="home-eyebrow home-eyebrow-centered">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        OUR PROMISE
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>
                    Why Choose
                    <em>Yogita Patola Art?</em>
                </h2>


                <div class="home-heading-ornament">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>

            </div>



            <div class="home-values-grid">


                <article class="home-value-card">

                    <div class="home-value-top">

                        <span>
                            01
                        </span>

                        <div class="home-value-icon">
                            ♕
                        </div>

                    </div>

                    <h3>
                        Authentic Craft
                    </h3>

                    <p>
                        Celebrating genuine traditional textile
                        techniques and craftsmanship.
                    </p>

                </article>



                <article class="home-value-card">

                    <div class="home-value-top">

                        <span>
                            02
                        </span>

                        <div class="home-value-icon">
                            ◈
                        </div>

                    </div>

                    <h3>
                        Thoughtfully Curated
                    </h3>

                    <p>
                        Every collection is selected with attention
                        to quality, design and heritage.
                    </p>

                </article>



                <article class="home-value-card">

                    <div class="home-value-top">

                        <span>
                            03
                        </span>

                        <div class="home-value-icon">
                            ♡
                        </div>

                    </div>

                    <h3>
                        Made With Care
                    </h3>

                    <p>
                        We value the people and craftsmanship
                        behind every textile.
                    </p>

                </article>



                <article class="home-value-card">

                    <div class="home-value-top">

                        <span>
                            04
                        </span>

                        <div class="home-value-icon">
                            ◉
                        </div>

                    </div>

                    <h3>
                        Personal Service
                    </h3>

                    <p>
                        Get personalized assistance before choosing
                        your perfect piece.
                    </p>

                </article>


            </div>

        </div>

    </section>



    <!-- =====================================================
         FINAL CTA
         ===================================================== -->

    <section class="home-cta">

        <div class="home-cta-pattern"></div>

        <div class="home-container">

            <div class="home-cta-inner">

                <div class="home-eyebrow home-cta-eyebrow">

                    <span class="home-eyebrow-line"></span>

                    <span>
                        A PIECE OF HERITAGE
                    </span>

                    <span class="home-eyebrow-line"></span>

                </div>


                <h2>
                    Wear Art.
                    <em>Carry Tradition.</em>
                </h2>


                <p>
                    Explore handcrafted textiles created
                    to become part of your story.
                </p>


                <a
                    href="/products"
                    class="home-cta-button"
                >
                    <span>
                        Explore The Collection
                    </span>

                    <span>
                        →
                    </span>
                </a>

            </div>

        </div>

    </section>


</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const currentYear =
            document.getElementById("currentYear");

        if (currentYear) {

            currentYear.textContent =
                new Date().getFullYear();

        }

    }
);

</script>

