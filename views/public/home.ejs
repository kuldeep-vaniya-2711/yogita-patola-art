                    loading="lazy" 
                > 

            <% } else { %> 

                <div class="home-about-placeholder"> 

                    <i class="bi bi-flower1"></i> 

                    <span> 
                        Yogita Patola Art 
                    </span> 

                </div> 

            <% } %> 

            <div class="home-about-image-overlay"></div> 
            <div class="home-about-frame"></div> 

        </div> 


        <div class="home-about-content"> 

            <span class="home-eyebrow"> 
                OUR STORY 
            </span> 

            <h2 class="home-section-heading"> 

                <% aboutParts.forEach((part, index) => { %> 

                    <% if (part.trim()) { %> 

