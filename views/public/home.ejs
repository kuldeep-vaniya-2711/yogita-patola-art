<!-- ===================================================== 
     IN THEIR WORDS 
====================================================== --> 

<% if (reviews.length) { %>

```
<section class="home-reviews"> 

    <div class="home-container"> 

        <div class="home-section-intro"> 

            <span class="home-eyebrow"> 
                IN THEIR WORDS 
            </span> 

            <h2 class="home-section-heading"> 
                Loved by Those Who Wear It 
            </h2> 

            <div class="home-heading-ornament"> 
                <span></span> 
                <i class="bi bi-diamond-fill"></i> 
                <span></span> 
            </div> 

            <p> 
                Real experiences from customers who have 
                discovered the beauty of handcrafted textiles. 
            </p> 

        </div> 


        <div class="home-reviews-grid"> 

            <% reviews.forEach(review => { %> 

                <article class="home-review-card"> 

                    <div class="home-review-top"> 

                        <div class="home-review-stars"> 

                            <% const reviewRating = 
                                Math.min( 
                                    5, 
                                    Math.max( 
                                        0, 
                                        Number(review.rating || 0) 
                                    ) 
                                ); 
                            %> 

                            <% for ( 
                                let star = 1; 
                                star <= 5; 
                                star++ 
                            ) { %> 

                                <% if (star <= reviewRating) { %> 

                                    <i class="bi bi-star-fill"></i> 

                                <% } else { %> 

                                    <i class="bi bi-star"></i> 

                                <% } %> 

                            <% } %> 

                        </div> 

                        <i class="bi bi-quote home-review-quote"></i> 

                    </div> 


                    <p class="home-review-text"> 

                        <%= ( 
                            review.message || 
                            review.comment || 
                            review.review || 
                            review.text || 
                            "" 
                        ) %> 

                    </p> 


                    <div class="home-review-author"> 

                        <div class="home-review-avatar"> 
                            <i class="bi bi-person-fill"></i> 
                        </div> 

                        <div> 

                            <strong> 
                                <%= ( 
                                    review.name || 
                                    review.customerName || 
                                    review.userName || 
                                    review.author || 
                                    "Customer" 
                                ) %> 
                            </strong> 

                            <% if ( 
                                review.location || 
                                review.city 
                            ) { %> 

                                <span> 
                                    <%= ( 
                                        review.location || 
                                        review.city 
                                    ) %> 
                                </span> 

                            <% } %> 

                        </div> 

                    </div> 

                </article> 

            <% }) %> 

        </div> 

    </div> 

</section> 
```

<% } %>

