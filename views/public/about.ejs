
<%
layout("layout", {
    title: "Our Story | Yogita Patola Art"
});
%>


<%
/*
 * =========================================================
 * ABOUT / OUR STORY PAGE CSS
 * =========================================================
 *
 * IMPORTANT:
 * Do NOT use pageCss / activePageCss.
 * Layout uses native ejs-mate block("head").
 * =========================================================
 */

block("head").append(`
    <link
        rel="stylesheet"
        href="/css/pages/about.css"
    >
`);
%>


<!-- ================================================= -->
<!-- ABOUT / OUR STORY PAGE -->
<!-- ================================================= -->

<section class="about-page">


    <!-- =================================================
         HERO
         ================================================= -->

    <section class="about-hero py-5">

        <div class="container text-center">

            <span class="section-subtitle">
                YOGITA PATOLA ART
            </span>

            <h1 class="section-title">
                Our Story
            </h1>

            <p class="section-description mx-auto">
                Preserving the timeless beauty of Patola
                through traditional craftsmanship and
                contemporary elegance.
            </p>

        </div>

    </section>



    <!-- =================================================
         STORY
         ================================================= -->

    <section class="about-story py-5">

        <div class="container">

            <div class="row align-items-center g-5">


                <!-- STORY CONTENT -->

                <div class="col-lg-6">

                    <span class="section-subtitle">
                        THE ART OF PATOLA
                    </span>

                    <h2 class="section-title">
                        Woven With Tradition.
                        <br>
                        Created With Passion.
                    </h2>

                    <p class="section-description">
                        Patola is more than a textile.
                        It represents generations of
                        craftsmanship, patience and
                        artistic heritage.
                    </p>

                    <p class="section-description">
                        At Yogita Patola Art, we celebrate
                        this heritage by bringing carefully
                        crafted traditional textiles to
                        people who appreciate timeless
                        Indian artistry.
                    </p>

                </div>



                <!-- STORY VISUAL -->

                <div class="col-lg-6">

                    <div class="about-story-card">

                        <div class="about-story-content">

                            <span>
                                HERITAGE
                            </span>

                            <strong>
                                PATOLA ART
                            </strong>

                            <small>
                                Tradition • Craft • Elegance
                            </small>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- =================================================
         VALUES
         ================================================= -->

    <section class="about-values py-5">

        <div class="container">

            <div class="text-center mb-5">

                <span class="section-subtitle">
                    WHAT WE BELIEVE
                </span>

                <h2 class="section-title">
                    Our Values
                </h2>

            </div>


            <div class="row g-4">


                <!-- VALUE 01 -->

                <div class="col-md-4">

                    <div class="about-value-card text-center">

                        <h3>
                            Tradition
                        </h3>

                        <p>
                            Respecting the traditional
                            techniques and heritage behind
                            every Patola creation.
                        </p>

                    </div>

                </div>



                <!-- VALUE 02 -->

                <div class="col-md-4">

                    <div class="about-value-card text-center">

                        <h3>
                            Craftsmanship
                        </h3>

                        <p>
                            Appreciating the patience,
                            precision and dedication of
                            skilled artisans.
                        </p>

                    </div>

                </div>



                <!-- VALUE 03 -->

                <div class="col-md-4">

                    <div class="about-value-card text-center">

                        <h3>
                            Timeless Beauty
                        </h3>

                        <p>
                            Creating and presenting textiles
                            that can be cherished for years
                            and generations.
                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- =================================================
         CTA
         ================================================= -->

    <section class="about-cta py-5">

        <div class="container text-center">

            <span class="section-subtitle">
                EXPLORE OUR COLLECTION
            </span>

            <h2 class="section-title">
                Discover The Beauty Of Patola
            </h2>

            <p class="section-description mx-auto">
                Explore our handcrafted collection and
                discover the heritage behind every piece.
            </p>

            <a
                href="/collections"
                class="btn btn-dark btn-lg"
            >
                Explore Collections
            </a>

        </div>

    </section>


</section>

