<%
/*
=========================================================
YOGITA PATOLA ART
PRODUCT DETAIL PAGE
=========================================================
*/

layout("layout");

block("head").append(
    '<link rel="stylesheet" href="/css/pages/product-detail.css">'
);

block("scripts").append(
    '<script src="/js/pages/product-detail.js" defer></script>'
);


// =========================================================
// SAFE PRODUCT DATA
// =========================================================

const currentProduct =
    typeof product !== "undefined" && product
        ? product
        : null;

const reviewList =
    Array.isArray(reviews)
        ? reviews
        : [];

const relatedProductList =
    Array.isArray(relatedProducts)
        ? relatedProducts
        : [];

const wishlistStatus =
    typeof isInWishlist !== "undefined"
        ? Boolean(isInWishlist)
        : false;


// =========================================================
// SAFE PRODUCT VALUES
// =========================================================

const productName =
    currentProduct?.name ||
    "Patola Product";

const productId =
    currentProduct?._id
        ? String(currentProduct._id)
        : "";

const productPrice =
    currentProduct?.price !== undefined &&
    currentProduct?.price !== null
        ? Number(currentProduct.price)
        : 0;

const formattedPrice =
    productPrice.toLocaleString("en-IN");

const productDescription =
    currentProduct?.description ||
    "Handcrafted with traditional Patola weaving techniques.";

const productFabric =
    currentProduct?.fabric ||
    "Traditional Patola textile";

const productTechnique =
    currentProduct?.technique ||
    "Traditional Patola weaving";

const productColor =
    currentProduct?.color ||
    "Traditional Patola colours";

const productDimensions =
    currentProduct?.dimensions ||
    "As mentioned for the product";

const productCategory =
    currentProduct?.category ||
    "Patola";

const productAvailability =
    currentProduct?.availability ||
    "Available";


// =========================================================
// PRODUCT IMAGES
// =========================================================

let productImages = [];

if (
    Array.isArray(currentProduct?.images) &&
    currentProduct.images.length
) {
    productImages = currentProduct.images.filter(
        image =>
            image &&
            String(image).trim()
    );
}

if (
    !productImages.length &&
    currentProduct?.image
) {
    productImages = [
        currentProduct.image
    ];
}

if (!productImages.length) {
    productImages = [
        "/images/placeholder-product.jpg"
    ];
}

const mainProductImage =
    productImages[0];


// =========================================================
// RATING
// =========================================================

const ratingValue =
    typeof averageRating !== "undefined"
        ? Number(averageRating || 0)
        : 0;

const fullStars =
    Math.floor(ratingValue);

const hasHalfStar =
    ratingValue - fullStars >= 0.5;


// =========================================================
// WHATSAPP ORDER MESSAGE
// =========================================================

const whatsappPhone =
    typeof whatsappUrl !== "undefined" &&
    whatsappUrl
        ? String(whatsappUrl)
        : "";

const availabilityText =
    String(productAvailability);

const isOutOfStock =
    availabilityText
        .toLowerCase()
        .replace(/[_-]/g, " ")
        .trim() === "out of stock";

let whatsappMessage;

if (isOutOfStock) {

    whatsappMessage =
        "Hello, I am interested in this product.\n\n" +
        "Product: " +
        productName +
        "\n" +
        "Product ID: " +
        productId +
        "\n" +
        "Price: ₹" +
        formattedPrice +
        "\n" +
        "Category: " +
        productCategory +
        "\n" +
        "Availability: " +
        availabilityText +
        "\n\n" +
        "Please let me know if this product is available or if a similar piece is available.";

} else {

    whatsappMessage =
        "Hello, I would like to order this product.\n\n" +
        "Product: " +
        productName +
        "\n" +
        "Product ID: " +
        productId +
        "\n" +
        "Price: ₹" +
        formattedPrice +
        "\n" +
        "Category: " +
        productCategory +
        "\n" +
        "Availability: " +
        availabilityText +
        "\n\n" +
        "Please share the order details and next steps.";
}


let whatsappOrderUrl;

if (whatsappPhone) {

    whatsappOrderUrl =
        whatsappPhone +
        (
            whatsappPhone.includes("?")
                ? "&"
                : "?"
        ) +
        "text=" +
        encodeURIComponent(
            whatsappMessage
        );

} else {

    whatsappOrderUrl =
        "https://wa.me/?text=" +
        encodeURIComponent(
            whatsappMessage
        );
}

%>


<% if (currentProduct) { %>


<section class="product-detail-page">

    <div class="container">


        <!-- =================================================
             BREADCRUMB
        ================================================== -->

        <nav
            class="product-breadcrumb"
            aria-label="breadcrumb"
        >

            <a href="/">
                Home
            </a>

            <span>
                /
            </span>

            <a href="/collections">
                Collections
            </a>

            <span>
                /
            </span>

            <span>
                <%= productName %>
            </span>

        </nav>


        <!-- =================================================
             PRODUCT MAIN AREA
        ================================================== -->

        <div class="row g-4 g-lg-5">


            <!-- =================================================
                 PRODUCT GALLERY
            ================================================== -->

            <div class="col-lg-6">

                <div class="product-gallery">


                    <!-- =================================================
                         MAIN IMAGE
                    ================================================== -->

                    <div class="product-main-image">

                        <% if (productImages.length > 1) { %>

                            <!-- PREVIOUS -->

                            <button
                                type="button"
                                class="product-gallery-arrow product-gallery-prev"
                                id="productGalleryPrev"
                                aria-label="Previous product image"
                            >
                                <i class="bi bi-chevron-left"></i>
                            </button>

                        <% } %>


                        <!-- MAIN PRODUCT IMAGE -->

                        <img
                            id="mainProductImage"
                            src="<%= mainProductImage %>"
                            alt="<%= productName %>"
                            loading="eager"
                        >


                        <!-- FULL IMAGE BUTTON -->

                        <button
                            type="button"
                            class="product-image-zoom"
                            id="openProductLightbox"
                            aria-label="Open product image in full view"
                        >
                            <i class="bi bi-arrows-fullscreen"></i>
                        </button>


                        <% if (productImages.length > 1) { %>

                            <!-- NEXT -->

                            <button
                                type="button"
                                class="product-gallery-arrow product-gallery-next"
                                id="productGalleryNext"
                                aria-label="Next product image"
                            >
                                <i class="bi bi-chevron-right"></i>
                            </button>

                        <% } %>

                    </div>


                    <!-- =================================================
                         PRODUCT THUMBNAILS
                    ================================================== -->

                    <% if (productImages.length > 1) { %>

                        <div
                            class="product-thumbnails"
                            id="productThumbnails"
                            aria-label="Product images"
                        >

                            <% productImages.forEach((image, index) => { %>

                                <button
                                    type="button"
                                    class="product-thumbnail <%= index === 0 ? 'active' : '' %>"
                                    data-image="<%= image %>"
                                    data-index="<%= index %>"
                                    aria-label="View product image <%= index + 1 %>"
                                    aria-current="<%= index === 0 ? 'true' : 'false' %>"
                                >

                                    <img
                                        src="<%= image %>"
                                        alt="<%= productName %> image <%= index + 1 %>"
                                        loading="lazy"
                                    >

                                </button>

                            <% }); %>

                        </div>

                    <% } %>


                </div>

            </div>


            <!-- =================================================
                 PRODUCT INFORMATION
            ================================================== -->

            <div class="col-lg-6">

                <div class="product-info">


                    <!-- CATEGORY -->

                    <div class="product-category">
                        <%= productCategory %>
                    </div>


                    <!-- TITLE -->

                    <h1 class="product-title">
                        <%= productName %>
                    </h1>


                    <!-- RATING -->

                    <% if (ratingValue > 0) { %>

                        <div class="product-rating">

                            <div class="rating-stars">

                                <% for (let i = 1; i <= 5; i++) { %>

                                    <% if (i <= fullStars) { %>

                                        <i class="bi bi-star-fill"></i>

                                    <% } else if (
                                        i === fullStars + 1 &&
                                        hasHalfStar
                                    ) { %>

                                        <i class="bi bi-star-half"></i>

                                    <% } else { %>

                                        <i class="bi bi-star"></i>

                                    <% } %>

                                <% } %>

                            </div>

                            <span class="rating-value">
                                <%= ratingValue.toFixed(1) %>
                            </span>

                            <span class="rating-count">
                                (<%= reviewList.length %>
                                <%= reviewList.length === 1
                                    ? "Review"
                                    : "Reviews"
                                %>)
                            </span>

                        </div>

                    <% } %>


                    <!-- PRICE -->

                    <div class="product-price">
                        ₹<%= formattedPrice %>
                    </div>


                    <!-- AVAILABILITY -->

                    <div class="product-availability">

                        <span>
                            Availability:
                        </span>

                        <strong
                            class="<%= isOutOfStock
                                ? 'text-danger'
                                : 'text-success'
                            %>"
                        >
                            <%= productAvailability %>
                        </strong>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="product-description">

                        <p>
                            <%= productDescription %>
                        </p>

                    </div>


                    <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                    <div class="product-actions">


                        <!-- WISHLIST -->

                        <form
                            method="POST"
                            action="<%= wishlistStatus
                                ? '/wishlist/remove/' + productId
                                : '/wishlist/add/' + productId
                            %>"
                        >

                            <button
                                type="submit"
                                class="btn btn-outline-dark wishlist-btn"
                                aria-label="<%= wishlistStatus
                                    ? 'Remove from wishlist'
                                    : 'Add to wishlist'
                                %>"
                            >

                                <i
                                    class="bi <%= wishlistStatus
                                        ? 'bi-heart-fill'
                                        : 'bi-heart'
                                    %>"
                                ></i>

                                <span>
                                    <%= wishlistStatus
                                        ? "Remove from Wishlist"
                                        : "Add to Wishlist"
                                    %>
                                </span>

                            </button>

                        </form>


                        <!-- WHATSAPP ORDER -->

                        <a
                            href="<%= whatsappOrderUrl %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-dark inquiry-btn"
                            aria-label="<%= isOutOfStock
                                ? 'Ask about ' + productName + ' on WhatsApp'
                                : 'Order ' + productName + ' on WhatsApp'
                            %>"
                        >

                            <i class="bi bi-whatsapp"></i>

                            <span>
                                <%= isOutOfStock
                                    ? "Ask on WhatsApp"
                                    : "Order on WhatsApp"
                                %>
                            </span>

                        </a>

                    </div>


                    <!-- WHATSAPP NOTE -->

                    <div class="product-whatsapp-note">

                        <i class="bi bi-whatsapp"></i>

                        <span>
                            Orders are confirmed personally through WhatsApp.
                        </span>

                    </div>


                    <!-- =================================================
                         SPECIFICATIONS
                    ================================================== -->

                    <div class="product-specifications">


                        <div class="specification-row">

                            <span>
                                Fabric
                            </span>

                            <strong>
                                <%= productFabric %>
                            </strong>

                        </div>


                        <div class="specification-row">

                            <span>
                                Technique
                            </span>

                            <strong>
                                <%= productTechnique %>
                            </strong>

                        </div>


                        <div class="specification-row">

                            <span>
                                Colour
                            </span>

                            <strong>
                                <%= productColor %>
                            </strong>

                        </div>


                        <div class="specification-row">

                            <span>
                                Dimensions
                            </span>

                            <strong>
                                <%= productDimensions %>
                            </strong>

                        </div>


                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             PRODUCT INFORMATION TABS
        ================================================== -->

        <div class="product-information-section">

            <ul
                class="nav nav-tabs product-tabs"
                id="productInfoTabs"
                role="tablist"
            >


                <li
                    class="nav-item"
                    role="presentation"
                >

                    <button
                        class="nav-link active"
                        data-bs-toggle="tab"
                        data-bs-target="#descriptionTab"
                        type="button"
                        role="tab"
                    >
                        Description
                    </button>

                </li>


                <li
                    class="nav-item"
                    role="presentation"
                >

                    <button
                        class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#craftsmanshipTab"
                        type="button"
                        role="tab"
                    >
                        Craftsmanship
                    </button>

                </li>


                <li
                    class="nav-item"
                    role="presentation"
                >

                    <button
                        class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#fabricTab"
                        type="button"
                        role="tab"
                    >
                        Fabric & Care
                    </button>

                </li>


                <li
                    class="nav-item"
                    role="presentation"
                >

                    <button
                        class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#shippingTab"
                        type="button"
                        role="tab"
                    >
                        Shipping
                    </button>

                </li>


                <li
                    class="nav-item"
                    role="presentation"
                >

                    <button
                        class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#returnsTab"
                        type="button"
                        role="tab"
                    >
                        Returns & Exchange
                    </button>

                </li>


            </ul>


            <div class="tab-content product-tab-content">


                <!-- DESCRIPTION -->

                <div
                    class="tab-pane fade show active"
                    id="descriptionTab"
                    role="tabpanel"
                >

                    <h3>
                        Product Description
                    </h3>

                    <p>
                        <%= productDescription %>
                    </p>

                </div>


                <!-- CRAFTSMANSHIP -->

                <div
                    class="tab-pane fade"
                    id="craftsmanshipTab"
                    role="tabpanel"
                >

                    <h3>
                        The Art of Patola
                    </h3>

                    <p>
                        Each Patola creation represents generations
                        of textile craftsmanship, patience and
                        artistic precision.
                    </p>

                    <p>
                        The traditional weaving process creates
                        intricate patterns and vibrant colours that
                        make every piece distinctive.
                    </p>

                    <p>
                        Technique:

                        <strong>
                            <%= productTechnique %>
                        </strong>

                    </p>

                </div>


                <!-- FABRIC -->

                <div
                    class="tab-pane fade"
                    id="fabricTab"
                    role="tabpanel"
                >

                    <h3>
                        Fabric & Care
                    </h3>

                    <p>
                        Fabric:

                        <strong>
                            <%= productFabric %>
                        </strong>
                    </p>

                    <p>
                        For long-lasting beauty, store the textile
                        away from direct sunlight and moisture.
                        Follow professional textile cleaning
                        recommendations where appropriate.
                    </p>

                </div>


                <!-- SHIPPING -->

                <div
                    class="tab-pane fade"
                    id="shippingTab"
                    role="tabpanel"
                >

                    <h3>
                        Shipping
                    </h3>

                    <p>
                        Shipping and delivery details are confirmed
                        personally through WhatsApp before the order
                        is finalized.
                    </p>

                </div>


                <!-- RETURNS -->

                <div
                    class="tab-pane fade"
                    id="returnsTab"
                    role="tabpanel"
                >

                    <h3>
                        Returns & Exchange
                    </h3>

                    <p>
                        Return and exchange eligibility is discussed
                        and confirmed before the order is finalized.
                    </p>

                </div>


            </div>

        </div>


        <!-- =================================================
             WHAT'S INCLUDED
        ================================================== -->

        <section class="product-included-section">

            <div class="section-heading">

                <span class="section-eyebrow">
                    Your Purchase
                </span>

                <h2>
                    What's Included
                </h2>

            </div>


            <div class="row g-4">


                <div class="col-md-4">

                    <div class="included-card">

                        <i class="bi bi-award"></i>

                        <h3>
                            Authentic Craftsmanship
                        </h3>

                        <p>
                            A traditionally crafted Patola textile
                            made with attention to detail.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="included-card">

                        <i class="bi bi-box-seam"></i>

                        <h3>
                            Carefully Prepared
                        </h3>

                        <p>
                            Your selected piece is prepared carefully
                            before dispatch.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="included-card">

                        <i class="bi bi-whatsapp"></i>

                        <h3>
                            Personal Assistance
                        </h3>

                        <p>
                            Order confirmation and assistance are
                            handled personally through WhatsApp.
                        </p>

                    </div>

                </div>


            </div>

        </section>


        <!-- =================================================
             RELATED PRODUCTS
        ================================================== -->

        <% if (relatedProductList.length) { %>

            <section class="related-products-section">

                <div class="section-heading">

                    <span class="section-eyebrow">
                        You May Also Like
                    </span>

                    <h2>
                        Related Products
                    </h2>

                </div>


                <!--
                    Same product grid structure as Collections page.
                    Shared product-card partial remains unchanged.
                -->

                <div class="row collections-product-grid">

                    <% relatedProductList.forEach(relatedProduct => { %>

                        <div class="col-6 col-md-4 col-lg-3 collection-product-item">

                            <%- include(
                                "../partials/product-card",
                                {
                                    product: relatedProduct
                                }
                            ) %>

                        </div>

                    <% }); %>

                </div>

            </section>

        <% } %>


        <!-- =================================================
             PRODUCT STORY
        ================================================== -->

        <section class="product-story-section">

            <div class="product-story-content">

                <span class="section-eyebrow">
                    Yogita Patola Art
                </span>

                <h2>
                    Woven With Tradition.
                    Created With Passion.
                </h2>

                <p>
                    Every Patola textile carries the story of
                    traditional Indian craftsmanship. From carefully
                    planned motifs to intricate weaving, each piece
                    reflects patience, skill and heritage.
                </p>

                <p>
                    We believe that authentic textile art should not
                    only be worn, but preserved and celebrated for
                    generations.
                </p>

            </div>

        </section>


        <!-- =================================================
             REVIEWS
        ================================================== -->

        <% if (
            typeof showReviews === "undefined" ||
            showReviews !== false
        ) { %>

            <section class="product-reviews-section">

                <div class="section-heading">

                    <span class="section-eyebrow">
                        Customer Experience
                    </span>

                    <h2>
                        Reviews
                    </h2>

                </div>


                <% if (reviewList.length) { %>

                    <div class="reviews-list">

                        <% reviewList.forEach(review => { %>

                            <article class="review-card">

                                <div class="review-card-header">

                                    <div>

                                        <strong>
                                            <%= review.name || "Customer" %>
                                        </strong>

                                        <div class="review-stars">

                                            <% for (
                                                let i = 1;
                                                i <= 5;
                                                i++
                                            ) { %>

                                                <i
                                                    class="bi <%= i <= Number(review.rating || 0)
                                                        ? 'bi-star-fill'
                                                        : 'bi-star'
                                                    %>"
                                                ></i>

                                            <% } %>

                                        </div>

                                    </div>


                                    <% if (review.createdAt) { %>

                                        <time>

                                            <%= new Date(
                                                review.createdAt
                                            ).toLocaleDateString(
                                                "en-IN"
                                            ) %>

                                        </time>

                                    <% } %>

                                </div>


                                <p>
                                    <%= review.comment ||
                                        review.message ||
                                        ""
                                    %>
                                </p>

                            </article>

                        <% }); %>

                    </div>

                <% } else { %>

                    <div class="no-reviews">

                        <i class="bi bi-chat-quote"></i>

                        <p>
                            Be the first to share your experience
                            with this product.
                        </p>

                    </div>

                <% } %>


                <!-- REVIEW FORM -->

                <div class="review-form-wrapper">

                    <h3>
                        Write a Review
                    </h3>


                    <form
                        method="POST"
                        action="/products/<%= productId %>/review"
                        class="product-review-form"
                    >

                        <div class="row g-3">


                            <div class="col-md-6">

                                <label
                                    for="reviewName"
                                    class="form-label"
                                >
                                    Name
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="reviewName"
                                    name="name"
                                    required
                                >

                            </div>


                            <div class="col-md-6">

                                <label
                                    for="reviewEmail"
                                    class="form-label"
                                >
                                    Email
                                </label>

                                <input
                                    type="email"
                                    class="form-control"
                                    id="reviewEmail"
                                    name="email"
                                >

                            </div>


                            <div class="col-md-6">

                                <label
                                    for="reviewRating"
                                    class="form-label"
                                >
                                    Rating
                                </label>

                                <select
                                    class="form-select"
                                    id="reviewRating"
                                    name="rating"
                                    required
                                >

                                    <option value="">
                                        Select rating
                                    </option>

                                    <option value="5">
                                        5 - Excellent
                                    </option>

                                    <option value="4">
                                        4 - Very Good
                                    </option>

                                    <option value="3">
                                        3 - Good
                                    </option>

                                    <option value="2">
                                        2 - Fair
                                    </option>

                                    <option value="1">
                                        1 - Poor
                                    </option>

                                </select>

                            </div>


                            <div class="col-12">

                                <label
                                    for="reviewMessage"
                                    class="form-label"
                                >
                                    Review
                                </label>

                                <textarea
                                    class="form-control"
                                    id="reviewMessage"
                                    name="comment"
                                    rows="5"
                                    required
                                ></textarea>

                            </div>


                            <div class="col-12">

                                <button
                                    type="submit"
                                    class="btn btn-dark"
                                >
                                    Submit Review
                                </button>

                            </div>


                        </div>

                    </form>

                </div>

            </section>

        <% } %>


        <!-- =================================================
             CONTACT CTA
        ================================================== -->

        <section class="product-contact-cta">

            <div class="product-contact-cta-content">

                <span class="section-eyebrow">
                    Need Assistance?
                </span>

                <h2>
                    Interested in This Piece?
                </h2>

                <p>
                    Contact us directly for product details,
                    availability, shipping information and
                    personalized assistance.
                </p>


                <a
                    href="<%= whatsappOrderUrl %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-dark"
                >

                    <i class="bi bi-whatsapp"></i>

                    <span>
                        <%= isOutOfStock
                            ? "Ask on WhatsApp"
                            : "Order on WhatsApp"
                        %>
                    </span>

                </a>

            </div>

        </section>


    </div>

</section>


<!-- =========================================================
     PRODUCT IMAGE LIGHTBOX / FULL IMAGE VIEW
========================================================= -->

<div
    class="product-lightbox"
    id="productLightbox"
    aria-hidden="true"
>

    <div
        class="lightbox-dialog"
        role="dialog"
        aria-modal="true"
        aria-label="Product image full view"
    >


        <!-- CLOSE -->

        <button
            type="button"
            class="lightbox-close"
            id="lightboxClose"
            aria-label="Close full image view"
        >
            <i class="bi bi-x-lg"></i>
        </button>


        <% if (productImages.length > 1) { %>

            <!-- PREVIOUS -->

            <button
                type="button"
                class="lightbox-nav lightbox-prev"
                id="lightboxPrev"
                aria-label="Previous product image"
            >
                <i class="bi bi-chevron-left"></i>
            </button>

        <% } %>


        <!-- FULL IMAGE -->

        <img
            id="lightboxImage"
            src="<%= mainProductImage %>"
            alt="<%= productName %>"
        >


        <% if (productImages.length > 1) { %>

            <!-- NEXT -->

            <button
                type="button"
                class="lightbox-nav lightbox-next"
                id="lightboxNext"
                aria-label="Next product image"
            >
                <i class="bi bi-chevron-right"></i>
            </button>

        <% } %>


        <!-- FULLSCREEN -->

        <button
            type="button"
            class="lightbox-fullscreen"
            id="lightboxFullscreen"
            aria-label="View image fullscreen"
        >
            <i class="bi bi-fullscreen"></i>
        </button>


    </div>

</div>


<% } else { %>


<!-- =========================================================
     PRODUCT NOT FOUND
========================================================= -->

<section class="product-not-found">

    <div class="container text-center">

        <i class="bi bi-box-seam"></i>

        <h1>
            Product Not Found
        </h1>

        <p>
            The product you are looking for is no longer
            available or the link is incorrect.
        </p>

        <a
            href="/collections"
            class="btn btn-dark"
        >
            Browse Collections
        </a>

    </div>

</section>


<% } %>