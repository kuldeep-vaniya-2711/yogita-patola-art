<%
layout("layout", {
    title:
        typeof title !== "undefined" && title
            ? title
            : "Products | Yogita Patola Art",

    description:
        typeof description !== "undefined" && description
            ? description
            : "Explore handcrafted Patola sarees and traditional Indian textiles."
});
%>


<!-- =========================================================
     PAGE CSS
     ========================================================= -->

<% block("head").append(`
    <link
        rel="stylesheet"
        href="/css/pages/collections.css"
    >

    <link
        rel="stylesheet"
        href="/css/pages/products.css"
    >
`) %>


<%
/* =========================================================
   PRODUCTS DATA
   ========================================================= */

const productList =
    typeof products !== "undefined" &&
    Array.isArray(products)
        ? products
        : [];

const currentSearch =
    typeof search !== "undefined" && search
        ? search
        : "";

const currentCategory =
    typeof category !== "undefined" && category
        ? category
        : "";

const currentAvailability =
    typeof availability !== "undefined" && availability
        ? availability
        : "";

const currentPage =
    typeof page !== "undefined"
        ? Number(page)
        : 1;

const totalPages =
    typeof pages !== "undefined"
        ? Number(pages)
        : 1;


/* =========================================================
   URL HELPERS
   ========================================================= */

function productsUrl(overrides = {}) {

    const params = new URLSearchParams();

    const values = {
        search: currentSearch,
        category: currentCategory,
        availability: currentAvailability,
        page: currentPage,

        ...overrides
    };


    if (values.search) {
        params.set("search", values.search);
    }

    if (values.category) {
        params.set("category", values.category);
    }

    if (values.availability) {
        params.set("availability", values.availability);
    }

    if (
        values.page &&
        Number(values.page) > 1
    ) {
        params.set("page", values.page);
    }


    const query = params.toString();

    return query
        ? `/products?${query}`
        : "/products";
}


function categoryUrl(value) {

    return productsUrl({
        category: value,
        page: 1
    });

}


function availabilityUrl(value) {

    return productsUrl({
        availability: value,
        page: 1
    });

}


const totalProducts =
    productList.length;


const showingFrom =
    totalProducts > 0
        ? ((currentPage - 1) * totalProducts) + 1
        : 0;


const showingTo =
    totalProducts > 0
        ? showingFrom + totalProducts - 1
        : 0;

%>



<!-- ========================================================= -->
<!-- PRODUCTS PAGE                                             -->
<!-- ========================================================= -->

<section class="collections-page products-page">


    <!-- ===================================================== -->
    <!-- HERO                                                   -->
    <!-- ===================================================== -->

    <section class="collections-hero">

        <div class="container">

            <div class="collections-hero-content">

                <span class="collections-eyebrow">
                    YOGITA PATOLA ART
                </span>


                <h1 class="collections-title">
                    Our Products
                </h1>


                <div class="collections-hero-rule">

                    <span></span>

                    <i>✦</i>

                    <span></span>

                </div>


                <h2 class="collections-hero-subtitle">
                    Handwoven Sarees &amp; Textiles
                </h2>


                <p class="collections-description">

                    Discover handcrafted Patola sarees,
                    traditional textiles and timeless
                    Indian artistry, created with patience,
                    skill and heritage.

                </p>

            </div>

        </div>

    </section>



    <!-- ===================================================== -->
    <!-- PRODUCTS CONTENT                                       -->
    <!-- ===================================================== -->

    <section class="collections-content">

        <div class="container">


            <!-- ================================================= -->
            <!-- CATEGORY NAVIGATION                                -->
            <!-- ================================================= -->

            <div class="collections-category-area">

                <div class="collections-category-label">
                    Explore by craft
                </div>


                <nav
                    class="collections-filters"
                    aria-label="Product categories"
                >

                    <a
                        href="<%= categoryUrl('') %>"
                        class="<%= !currentCategory ? 'active' : '' %>"
                    >
                        All
                    </a>


                    <a
                        href="<%= categoryUrl('Patola Sarees') %>"
                        class="<%= currentCategory === 'Patola Sarees'
                            ? 'active'
                            : '' %>"
                    >
                        Patola Sarees
                    </a>


                    <a
                        href="<%= categoryUrl('Double Ikat Sarees') %>"
                        class="<%= currentCategory === 'Double Ikat Sarees'
                            ? 'active'
                            : '' %>"
                    >
                        Double Ikat
                    </a>


                    <a
                        href="<%= categoryUrl('Single Ikat Sarees') %>"
                        class="<%= currentCategory === 'Single Ikat Sarees'
                            ? 'active'
                            : '' %>"
                    >
                        Single Ikat
                    </a>


                    <a
                        href="<%= categoryUrl('Dupattas') %>"
                        class="<%= currentCategory === 'Dupattas'
                            ? 'active'
                            : '' %>"
                    >
                        Dupattas
                    </a>


                    <a
                        href="<%= categoryUrl('Accessories') %>"
                        class="<%= currentCategory === 'Accessories'
                            ? 'active'
                            : '' %>"
                    >
                        Accessories
                    </a>

                </nav>

            </div>



            <!-- ================================================= -->
            <!-- TOOLBAR                                             -->
            <!-- ================================================= -->

            <div class="collections-toolbar products-toolbar">


                <!-- SEARCH -->

                <form
                    action="/products"
                    method="GET"
                    class="collections-search-form"
                >

                    <% if (currentCategory) { %>

                        <input
                            type="hidden"
                            name="category"
                            value="<%= currentCategory %>"
                        >

                    <% } %>


                    <% if (currentAvailability) { %>

                        <input
                            type="hidden"
                            name="availability"
                            value="<%= currentAvailability %>"
                        >

                    <% } %>


                    <div class="collections-search-box">

                        <i class="bi bi-search"></i>

                        <input
                            type="search"
                            name="search"
                            value="<%= currentSearch %>"
                            placeholder="Search products..."
                            aria-label="Search products"
                        >


                        <% if (currentSearch) { %>

                            <a
                                href="<%= productsUrl({
                                    search: '',
                                    page: 1
                                }) %>"
                                class="collections-search-clear"
                                aria-label="Clear search"
                            >
                                <i class="bi bi-x"></i>
                            </a>

                        <% } %>

                    </div>

                </form>



                <!-- AVAILABILITY -->

                <form
                    action="/products"
                    method="GET"
                    class="products-availability-form"
                >

                    <% if (currentSearch) { %>

                        <input
                            type="hidden"
                            name="search"
                            value="<%= currentSearch %>"
                        >

                    <% } %>


                    <% if (currentCategory) { %>

                        <input
                            type="hidden"
                            name="category"
                            value="<%= currentCategory %>"
                        >

                    <% } %>


                    <label
                        for="productAvailability"
                        class="collections-sort-label"
                    >
                        Availability
                    </label>


                    <select
                        id="productAvailability"
                        name="availability"
                        class="collections-sort-select"
                        onchange="this.form.submit()"
                    >

                        <option value="">
                            All
                        </option>

                        <option
                            value="In Stock"
                            <%= currentAvailability === "In Stock"
                                ? "selected"
                                : "" %>
                        >
                            In Stock
                        </option>

                        <option
                            value="Limited"
                            <%= currentAvailability === "Limited"
                                ? "selected"
                                : "" %>
                        >
                            Limited
                        </option>

                        <option
                            value="Out of Stock"
                            <%= currentAvailability === "Out of Stock"
                                ? "selected"
                                : "" %>
                        >
                            Out of Stock
                        </option>

                    </select>

                </form>



                <!-- RESET -->

                <% if (
                    currentSearch ||
                    currentCategory ||
                    currentAvailability
                ) { %>

                    <a
                        href="/products"
                        class="products-reset-link"
                    >
                        Reset
                    </a>

                <% } %>

            </div>



            <!-- ================================================= -->
            <!-- SECTION HEADER                                     -->
            <!-- ================================================= -->

            <div class="collections-section-header">

                <div class="collections-section-heading">

                    <span class="section-subtitle">
                        CURATED TEXTILES
                    </span>


                    <h2 class="section-title">
                        Discover Our Products
                    </h2>

                </div>


                <div class="collections-results-count">

                    Showing

                    <strong>
                        <%= totalProducts > 0
                            ? showingFrom
                            : 0 %>
                    </strong>

                    –

                    <strong>
                        <%= showingTo %>
                    </strong>

                    <span>
                        of
                    </span>

                    <strong>
                        <%= totalProducts %>
                    </strong>

                    <span>
                        pieces
                    </span>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- PRODUCT GRID                                       -->
            <!-- ================================================= -->

            <% if (productList.length > 0) { %>

                <div
                    class="row g-4 collections-product-grid"
                    id="productsGrid"
                >

                    <% productList.forEach(product => { %>

                        <div
                            class="col-6 col-md-6 col-lg-4 col-xl-4 collection-product-item"
                            data-category="<%= product.category || '' %>"
                            data-availability="<%= product.availability || '' %>"
                        >

                            <%- include("../partials/product-card", {
                                product: product
                            }) %>

                        </div>

                    <% }); %>

                </div>

            <% } else { %>


                <!-- ================================================= -->
                <!-- EMPTY STATE                                       -->
                <!-- ================================================= -->

                <div class="collections-empty">

                    <div class="collections-empty-icon">
                        ✦
                    </div>


                    <h3>
                        No Products Found
                    </h3>


                    <p>
                        We could not find any products matching
                        your current filters.
                    </p>


                    <a
                        href="/products"
                        class="collections-empty-button"
                    >
                        View All Products
                    </a>

                </div>

            <% } %>



            <!-- ================================================= -->
            <!-- PAGINATION                                          -->
            <!-- ================================================= -->

            <% if (totalPages > 1) { %>

                <nav
                    class="collections-pagination"
                    aria-label="Products pagination"
                >


                    <!-- PREVIOUS -->

                    <% if (currentPage > 1) { %>

                        <a
                            href="<%= productsUrl({
                                page: currentPage - 1
                            }) %>"
                            class="collections-pagination-arrow"
                            aria-label="Previous page"
                        >
                            <i class="bi bi-arrow-left"></i>
                        </a>

                    <% } else { %>

                        <span
                            class="collections-pagination-arrow disabled"
                            aria-hidden="true"
                        >
                            <i class="bi bi-arrow-left"></i>
                        </span>

                    <% } %>



                    <!-- PAGE NUMBERS -->

                    <div class="collections-pagination-numbers">

                        <% for (
                            let pageNumber = 1;
                            pageNumber <= totalPages;
                            pageNumber++
                        ) { %>

                            <a
                                href="<%= productsUrl({
                                    page: pageNumber
                                }) %>"
                                class="<%= pageNumber === currentPage
                                    ? 'active'
                                    : '' %>"
                                aria-label="Page <%= pageNumber %>"
                                <%= pageNumber === currentPage
                                    ? 'aria-current="page"'
                                    : '' %>
                            >
                                <%= pageNumber %>
                            </a>

                        <% } %>

                    </div>



                    <!-- NEXT -->

                    <% if (currentPage < totalPages) { %>

                        <a
                            href="<%= productsUrl({
                                page: currentPage + 1
                            }) %>"
                            class="collections-pagination-arrow"
                            aria-label="Next page"
                        >
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    <% } else { %>

                        <span
                            class="collections-pagination-arrow disabled"
                            aria-hidden="true"
                        >
                            <i class="bi bi-arrow-right"></i>
                        </span>

                    <% } %>

                </nav>

            <% } %>

        </div>

    </section>



    <!-- ================================================= -->
    <!-- PRODUCTS CTA                                      -->
    <!-- ================================================= -->

    <section class="collections-cta py-5">

        <div class="container">

            <div class="text-center">

                <span class="collections-eyebrow">
                    YOGITA PATOLA ART
                </span>


                <h2 class="section-title">
                    Looking For Something Special?
                </h2>


                <p class="section-description mx-auto">
                    Get in touch with us to learn more about
                    our handcrafted Patolas and available
                    pieces.
                </p>


                <a
                    href="/contact"
                    class="btn btn-dark btn-lg"
                >
                    Contact Us
                </a>

            </div>

        </div>

    </section>


</section>