<% if (
    typeof success !== "undefined" &&
    success
) { %>

    <div
        class="alert alert-success alert-dismissible fade show"
        role="alert"
    >

        <strong>
            Success!
        </strong>

        <%= success %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>

    </div>

<% } %>



<% if (
    typeof error !== "undefined" &&
    error
) { %>

    <div
        class="alert alert-danger alert-dismissible fade show"
        role="alert"
    >

        <strong>
            Error!
        </strong>

        <%= error %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>

    </div>

<% } %>



<% if (
    typeof message !== "undefined" &&
    message
) { %>

    <div
        class="alert alert-info alert-dismissible fade show"
        role="alert"
    >

        <%= message %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>

    </div>

<% } %>