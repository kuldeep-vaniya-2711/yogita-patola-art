<%
    const s =
        typeof websiteSettings !== "undefined" && websiteSettings
            ? websiteSettings
            : (
                typeof settings !== "undefined"
                    ? settings
                    : null
            );

    const user =
        typeof currentUser !== "undefined"
            ? currentUser
            : null;

    const path =
        typeof currentPath !== "undefined" && currentPath
            ? currentPath
            : (
                typeof req !== "undefined" && req.path
                    ? req.path
                    : ""
            );

    const siteName =
        s && s.siteName
            ? s.siteName
            : "Yogita Patola Art";
%>


<nav class="navbar sticky-top patola-navbar">

    <div class="container patola-navbar-container">


        <!-- =================================================
             BRAND
        ================================================== -->

        <a
            href="/"
            class="navbar-brand patola-navbar-brand"
            aria-label="<%= siteName %>"
        >

            <span class="patola-brand-decoration patola-brand-decoration-left">
                ◆
            </span>

            <span class="patola-brand-main">
                <%= siteName %>
            </span>

            <span class="patola-brand-subtitle">
                Patola Heritage
            </span>

            <span class="patola-brand-decoration patola-brand-decoration-right">
                ◆
            </span>

        </a>


        <!-- =================================================
             MOBILE HAMBURGER
        ================================================== -->

        <button
            class="navbar-toggler patola-navbar-toggler"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-label="Open navigation menu"
        >

            <span class="patola-hamburger-icon">
                <span></span>
                <span></span>
                <span></span>
            </span>

        </button>


        <!-- =================================================
             NAVIGATION / DRAWER
        ================================================== -->

        <div
            class="patola-navbar-menu offcanvas offcanvas-start"
            tabindex="-1"
            id="mainNavbar"
            aria-labelledby="mainNavbarLabel"
        >


            <!-- =================================================
                 MOBILE DRAWER HEADER
            ================================================== -->

            <div class="offcanvas-header patola-drawer-header">

                <div class="patola-drawer-pattern"></div>


                <div class="patola-drawer-brand">

                    <span class="patola-drawer-small-title">
                        YOGITA
                    </span>

                    <span
                        class="patola-drawer-title"
                        id="mainNavbarLabel"
                    >
                        <%= siteName %>
                    </span>

                    <span class="patola-drawer-subtitle">
                        Traditional Patola Heritage
                    </span>

                </div>


                <button
                    type="button"
                    class="patola-navbar-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close navigation menu"
                >

                    <span></span>
                    <span></span>

                </button>

            </div>


            <!-- =================================================
                 DRAWER BODY
            ================================================== -->

            <div class="offcanvas-body patola-drawer-body">


                <!-- DECORATIVE TOP ELEMENT -->

                <div class="patola-drawer-ornament">

                    <span></span>
                    <strong>✦</strong>
                    <span></span>

                </div>


                <ul class="navbar-nav patola-main-nav">


                    <!-- HOME -->

                    <li class="nav-item">

                        <a
                            href="/"
                            class="nav-link <%= path === "/" ? "active" : "" %>"
                        >

                            <span class="patola-nav-symbol">
                                ◈
                            </span>

                            <span class="patola-nav-text">
                                Home
                            </span>

                            <span class="patola-nav-arrow">
                                ›
                            </span>

                        </a>

                    </li>


                    <!-- COLLECTIONS -->

                    <li class="nav-item">

                        <a
                            href="/collections"
                            class="nav-link <%= path === "/collections" ? "active" : "" %>"
                        >

                            <span class="patola-nav-symbol">
                                ◈
                            </span>

                            <span class="patola-nav-text">
                                Collections
                            </span>

                            <span class="patola-nav-arrow">
                                ›
                            </span>

                        </a>

                    </li>


                    <!-- OUR STORY -->

                    <li class="nav-item">

                        <a
                            href="/about"
                            class="nav-link <%= path === "/about" ? "active" : "" %>"
                        >

                            <span class="patola-nav-symbol">
                                ◈
                            </span>

                            <span class="patola-nav-text">
                                Our Story
                            </span>

                            <span class="patola-nav-arrow">
                                ›
                            </span>

                        </a>

                    </li>


                    <!-- CONTACT -->

                    <% if (!s || s.showContact !== false) { %>

                        <li class="nav-item">

                            <a
                                href="/contact"
                                class="nav-link <%= path === "/contact" ? "active" : "" %>"
                            >

                                <span class="patola-nav-symbol">
                                    ◈
                                </span>

                                <span class="patola-nav-text">
                                    Contact
                                </span>

                                <span class="patola-nav-arrow">
                                    ›
                                </span>

                            </a>

                        </li>

                    <% } %>


                    <!-- FEEDBACK -->

                    <% if (!s || s.showFeedback !== false) { %>

                        <li class="nav-item">

                            <a
                                href="/feedback"
                                class="nav-link <%= path === "/feedback" ? "active" : "" %>"
                            >

                                <span class="patola-nav-symbol">
                                    ◈
                                </span>

                                <span class="patola-nav-text">
                                    Feedback
                                </span>

                                <span class="patola-nav-arrow">
                                    ›
                                </span>

                            </a>

                        </li>

                    <% } %>


                    <!-- =================================================
                         DESKTOP SEARCH
                    ================================================== -->

                    <li class="nav-item patola-desktop-search">

                        <form
                            action="/search"
                            method="GET"
                            class="navbar-search-form"
                        >

                            <input
                                type="search"
                                name="q"
                                class="form-control"
                                placeholder="Search products..."
                                aria-label="Search products"
                                required
                            >

                            <button
                                type="submit"
                                class="btn"
                                aria-label="Search"
                            >
                                <span>⌕</span>
                            </button>

                        </form>

                    </li>


                    <% if (user) { %>


                        <!-- =================================================
                             LOGGED-IN PROFILE
                        ================================================== -->

                        <li class="nav-item patola-desktop-user">

                            <a
                                href="/user/profile"
                                class="nav-link patola-account-link"
                            >

                                <span class="patola-account-icon">
                                    ♙
                                </span>

                                <span>
                                    <%= user.name || "Account" %>
                                </span>

                            </a>

                        </li>


                        <!-- WISHLIST -->

                        <li class="nav-item patola-desktop-user">

                            <a
                                href="/wishlist"
                                class="nav-link <%= path.indexOf("/wishlist") === 0 ? "active" : "" %>"
                            >

                                <span class="patola-wishlist-icon">
                                    ♡
                                </span>

                                <span>
                                    Wishlist
                                </span>

                            </a>

                        </li>


                        <!-- LOGOUT -->

                        <li class="nav-item patola-desktop-user">

                            <a
                                href="/user/logout"
                                class="nav-link patola-logout-link"
                            >
                                Logout
                            </a>

                        </li>


                    <% } else { %>


                        <!-- LOGIN -->

                        <li class="nav-item patola-desktop-user patola-login-item">

                            <a
                                href="/user/login"
                                class="nav-link"
                            >
                                Login
                            </a>

                        </li>


                        <!-- REGISTER -->

                        <li class="nav-item patola-desktop-user patola-register-item">

                            <a
                                href="/user/register"
                                class="nav-link patola-register-btn"
                            >
                                Register
                            </a>

                        </li>


                    <% } %>


                </ul>


                <!-- =================================================
                     MOBILE SEARCH
                ================================================== -->

                <div class="mobile-search">

                    <div class="patola-mobile-section-title">
                        Explore Collection
                    </div>

                    <form
                        action="/search"
                        method="GET"
                        class="navbar-search-form"
                    >

                        <input
                            type="search"
                            name="q"
                            class="form-control"
                            placeholder="Search products..."
                            aria-label="Search products"
                            required
                        >

                        <button
                            type="submit"
                            class="btn"
                            aria-label="Search"
                        >
                            <span>⌕</span>
                        </button>

                    </form>

                </div>


                <% if (user) { %>


                    <!-- =================================================
                         MOBILE LOGGED-IN USER
                    ================================================== -->

                    <div class="patola-mobile-user">

                        <div class="patola-mobile-section-title">
                            My Account
                        </div>


                        <!-- PROFILE -->

                        <a
                            href="/user/profile"
                            class="patola-mobile-user-link"
                        >

                            <span class="patola-mobile-user-icon">
                                ♙
                            </span>

                            <span class="patola-mobile-user-text">

                                <small>
                                    Welcome back
                                </small>

                                <strong>
                                    <%= user.name || "Account" %>
                                </strong>

                            </span>

                            <span class="patola-mobile-user-arrow">
                                →
                            </span>

                        </a>


                        <!-- WISHLIST -->

                        <a
                            href="/wishlist"
                            class="patola-mobile-user-link <%= path.indexOf("/wishlist") === 0 ? "active" : "" %>"
                        >

                            <span class="patola-mobile-user-icon">
                                ♡
                            </span>

                            <span class="patola-mobile-user-text">

                                <small>
                                    Your Saved Products
                                </small>

                                <strong>
                                    Wishlist
                                </strong>

                            </span>

                            <span class="patola-mobile-user-arrow">
                                →
                            </span>

                        </a>


                        <!-- LOGOUT -->

                        <a
                            href="/user/logout"
                            class="patola-mobile-logout"
                        >
                            Logout
                        </a>

                    </div>


                <% } else { %>


                    <!-- =================================================
                         MOBILE LOGGED-OUT USER
                    ================================================== -->

                    <div class="patola-mobile-auth">

                        <div class="patola-mobile-section-title">
                            Your Account
                        </div>


                        <a
                            href="/user/login"
                            class="patola-mobile-login"
                        >
                            Login
                        </a>


                        <a
                            href="/user/register"
                            class="patola-mobile-register"
                        >
                            Create Account
                        </a>

                    </div>


                <% } %>


                <!-- DRAWER BOTTOM ORNAMENT -->

                <div class="patola-drawer-bottom-ornament">

                    <span></span>
                    <i></i>
                    <span></span>

                </div>


            </div>

        </div>

    </div>

</nav>