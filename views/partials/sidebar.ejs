<aside class="admin-sidebar">

    <div class="admin-sidebar-header">

        <a href="/admin" class="admin-sidebar-brand">
            <span class="admin-sidebar-brand-main">
                Yogita Patola Art
            </span>
            <span class="admin-sidebar-brand-subtitle">
                Admin Panel
            </span>
        </a>

        <button
            type="button"
            class="admin-sidebar-close"
            aria-label="Close navigation"
        >
            &times;
        </button>

    </div>


    <nav class="admin-sidebar-nav" aria-label="Admin navigation">

        <div class="admin-sidebar-section-title">
            Main
        </div>

        <a
            href="/admin"
            class="admin-sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">🏠</span>
            <span class="admin-sidebar-text">Dashboard</span>
        </a>


        <div class="admin-sidebar-section-title">
            Products
        </div>

        <a
            href="/admin/products"
            class="admin-sidebar-link <%= currentPath === '/admin/products' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">🛍️</span>
            <span class="admin-sidebar-text">Products</span>
        </a>

        <a
            href="/admin/products/add"
            class="admin-sidebar-link <%= currentPath === '/admin/products/add' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">➕</span>
            <span class="admin-sidebar-text">Add Product</span>
        </a>


        <div class="admin-sidebar-section-title">
            Customer Activity
        </div>

        <a
            href="/admin/reviews"
            class="admin-sidebar-link <%= currentPath === '/admin/reviews' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">⭐</span>
            <span class="admin-sidebar-text">Reviews</span>
        </a>

        <a
            href="/admin/feedback"
            class="admin-sidebar-link <%= currentPath === '/admin/feedback' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">💬</span>
            <span class="admin-sidebar-text">Feedback</span>
        </a>

        <a
            href="/admin/contacts"
            class="admin-sidebar-link <%= currentPath === '/admin/contacts' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">✉️</span>
            <span class="admin-sidebar-text">Contact Messages</span>
        </a>


        <div class="admin-sidebar-section-title">
            Analytics
        </div>

        <a
            href="/admin/visitors"
            class="admin-sidebar-link <%= currentPath === '/admin/visitors' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">📊</span>
            <span class="admin-sidebar-text">Visitors</span>
        </a>


        <div class="admin-sidebar-section-title">
            System
        </div>

        <a
            href="/admin/settings"
            class="admin-sidebar-link <%= currentPath === '/admin/settings' ? 'active' : '' %>"
        >
            <span class="admin-sidebar-icon">⚙️</span>
            <span class="admin-sidebar-text">Settings</span>
        </a>

    </nav>


    <div class="admin-sidebar-footer">

        <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="admin-sidebar-link admin-view-site"
        >
            <span class="admin-sidebar-icon">🌐</span>
            <span class="admin-sidebar-text">View Website</span>
        </a>

        <a
            href="/admin/logout"
            class="admin-sidebar-link admin-logout"
        >
            <span class="admin-sidebar-icon">🚪</span>
            <span class="admin-sidebar-text">Logout</span>
        </a>

    </div>

</aside>