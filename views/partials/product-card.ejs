<%
/*
* =====================================================
* PREMIUM PRODUCT CARD
* Yogita Patola Art
* =====================================================
*
* Used by:
* home.ejs
* collections.ejs
* products.ejs
* search.ejs
*
*/
%>

<article class="product-card h-100">


<!-- ================================================= -->
<!-- PRODUCT IMAGE -->
<!-- ================================================= -->

<div class="product-image">

    <a
        href="/products/<%= product._id %>"
        class="product-image-link"
        aria-label="View <%= product.name || 'Patola Product' %>"
    >

        <% if (
            product &&
            Array.isArray(product.images) &&
            product.images.length > 0
        ) { %>

            <img
                src="<%= product.images[0] %>"
                alt="<%= product.name || 'Patola Product' %>"
                class="product-image-main"
                loading="lazy"
            >

        <% } else { %>

            <div class="no-product-image">
                <span>Yogita Patola Art</span>
            </div>

        <% } %>

        <!-- IMAGE OVERLAY -->

        <div class="product-image-overlay">
            <span class="product-view-link">
                View Piece
                <span class="product-view-arrow">→</span>
            </span>
        </div>

    </a>


    <!-- ================================================= -->
    <!-- PRODUCT BADGE -->
    <!-- ================================================= -->

    <span class="product-badge">
        Handcrafted
    </span>


    <!-- ================================================= -->
    <!-- NUMBER -->
    <!-- ================================================= -->

    <span class="product-image-mark">
        ✦
    </span>

</div>


<!-- ================================================= -->
<!-- PRODUCT INFORMATION -->
<!-- ================================================= -->

<div class="product-info">


    <!-- CATEGORY -->

    <span class="product-category">
        <%= product.category || "Patola Collection" %>
    </span>


    <!-- NAME -->

    <h3 class="product-name">

        <a href="/products/<%= product._id %>">

            <%= product.name || "Handcrafted Patola" %>

        </a>

    </h3>


    <!-- DESCRIPTION -->

    <p class="product-description">

        <%= product.description
            ? (
                product.description.length > 100
                    ? product.description.substring(0, 100) + "..."
                    : product.description
            )
            : "A beautifully handcrafted Patola created with traditional artistry."
        %>

    </p>


    <!-- ================================================= -->
    <!-- BOTTOM META -->
    <!-- ================================================= -->

    <div class="product-bottom">


        <!-- PRICE -->

        <div class="product-price-wrap">

            <span class="product-price-label">
                Price
            </span>

            <span class="product-price">
                ₹<%= Number(
                    product.price || 0
                ).toLocaleString("en-IN") %>
            </span>

        </div>


        <!-- AVAILABILITY -->

        <span
            class="product-availability
            <%= product.availability === 'In Stock'
                ? 'is-stock'
                : product.availability === 'Limited'
                    ? 'is-limited'
                    : 'is-unavailable'
            %>"
        >

            <span class="availability-dot"></span>

            <%= product.availability || "In Stock" %>

        </span>

    </div>


    <!-- ================================================= -->
    <!-- VIEW DETAILS -->
    <!-- ================================================= -->

    <a
        href="/products/<%= product._id %>"
        class="product-details-btn"
    >

        <span>
            View Details
        </span>

        <span class="product-details-arrow">
            →
        </span>

    </a>

</div>


</article>
