
<header class="admin-topbar">

    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <div class="admin-topbar-left">

        <!-- MOBILE MENU BUTTON -->

        <button
            type="button"
            class="admin-menu-toggle"
            aria-label="Open admin navigation"
            aria-controls="adminSidebar"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>


        <!-- PAGE INFORMATION -->

        <div class="admin-topbar-page-info">

            <span class="admin-topbar-label">
                ADMIN PANEL
            </span>

            <h1 class="admin-topbar-title">
                <%= typeof pageTitle !== "undefined" && pageTitle
                    ? pageTitle
                    : "Dashboard" %>
            </h1>

        </div>

    </div>


    <!-- =====================================================
         RIGHT SIDE
         ===================================================== -->

    <div class="admin-topbar-right">


        <!-- VIEW WEBSITE -->

        <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="admin-topbar-site-link"
            aria-label="Open website in new tab"
        >

            <span class="admin-topbar-site-icon">
                <i class="bi bi-globe2"></i>
            </span>

            <span class="admin-topbar-site-text d-none d-md-inline">
                View Website
            </span>

            <i class="bi bi-box-arrow-up-right admin-topbar-external-icon d-none d-lg-inline"></i>

        </a>


        <!-- DIVIDER -->

        <span
            class="admin-topbar-divider"
            aria-hidden="true"
        ></span>


        <!-- ADMIN USER -->

        <div class="admin-topbar-user">

            <div
                class="admin-topbar-avatar"
                aria-hidden="true"
            >
                <%= typeof adminName !== "undefined" && adminName
                    ? adminName.charAt(0).toUpperCase()
                    : "A" %>
            </div>


            <div class="admin-topbar-user-info">

                <strong>
                    <%= typeof adminName !== "undefined" && adminName
                        ? adminName
                        : "Administrator" %>
                </strong>

                <small>
                    Administrator
                </small>

            </div>

        </div>

    </div>

</header>

