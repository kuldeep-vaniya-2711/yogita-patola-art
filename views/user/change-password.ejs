<%
    layout("layout", {
        title: "Change Password | Yogita Patola Art",
        description: "Change your Yogita Patola Art account password."
    });
%>


<!-- =========================================================
     CHANGE PASSWORD CSS
     Loaded directly for this page
========================================================= -->

<link
    rel="stylesheet"
    href="/css/pages/password.css"
>


<!-- =========================================================
     CHANGE PASSWORD PAGE
========================================================= -->

<section class="password-page">

    <div class="password-container">


        <!-- =================================================
             BRAND SIDE
        ================================================== -->

        <div class="password-brand">

            <div class="brand-icon">
                ✦
            </div>

            <span class="brand-eyebrow">
                YOGITA PATOLA ART
            </span>

            <h1>
                Keep your<br>
                <span>Account Secure.</span>
            </h1>

            <p>
                Protect your account by regularly updating your
                password. Choose a strong password that you
                don't use on other websites.
            </p>

            <div class="brand-divider"></div>

            <div class="brand-note">
                <span>✦</span>
                Your privacy and security come first.
            </div>

        </div>


        <!-- =================================================
             CHANGE PASSWORD CARD
        ================================================== -->

        <div class="password-card">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="password-card-header">

                <span class="card-label">
                    ACCOUNT SECURITY
                </span>

                <h2>
                    Change Password
                </h2>

                <p>
                    Enter your current password and choose a
                    new password for your account.
                </p>

            </div>


            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="password-alert password-alert-error">

                    <span class="alert-icon">
                        !
                    </span>

                    <div>

                        <strong>
                            Unable to change password
                        </strong>

                        <p>
                            <%= error %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 SUCCESS MESSAGE
            ================================================== -->

            <% if (typeof success !== "undefined" && success) { %>

                <div class="password-alert password-alert-success">

                    <span class="alert-icon">
                        ✓
                    </span>

                    <div>

                        <strong>
                            Password changed successfully
                        </strong>

                        <p>
                            <%= success %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 SECURITY INFORMATION
            ================================================== -->

            <div class="change-password-info">

                For your security, you'll need to enter your
                current password before creating a new one.

            </div>


            <!-- =================================================
                 CHANGE PASSWORD FORM
            ================================================== -->

            <form
                action="/user/change-password"
                method="POST"
                class="password-form"
                autocomplete="off"
            >


                <!-- CURRENT PASSWORD -->

                <div class="form-group">

                    <label for="currentPassword">
                        Current Password
                    </label>

                    <div class="input-wrapper password-input-wrapper">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="currentPassword"
                            name="currentPassword"
                            placeholder="Enter your current password"
                            autocomplete="current-password"
                            required
                            maxlength="100"
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('currentPassword', this)"
                            aria-label="Show current password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="newPassword">
                        New Password
                    </label>

                    <div class="input-wrapper password-input-wrapper">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            placeholder="Enter your new password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="100"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('newPassword', this)"
                            aria-label="Show new password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>

                    <div class="input-wrapper password-input-wrapper">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Re-enter your new password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="100"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirmPassword', this)"
                            aria-label="Show confirm password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <!-- PASSWORD REQUIREMENTS -->

                <div class="password-requirements">

                    <div class="password-requirements-title">
                        Password requirements
                    </div>

                    <ul>

                        <li>
                            At least 8 characters
                        </li>

                        <li>
                            Use a combination of letters and numbers
                        </li>

                        <li>
                            Avoid reusing an old password
                        </li>

                    </ul>

                </div>


                <!-- PASSWORD STRENGTH -->

                <div
                    class="password-strength"
                    id="changePasswordStrength"
                >

                    <div class="password-strength-bar">

                        <div
                            class="password-strength-fill"
                            id="changePasswordStrengthFill"
                        ></div>

                    </div>

                    <div
                        class="password-strength-text"
                        id="changePasswordStrengthText"
                    >
                        Enter a password
                    </div>

                </div>


                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="password-submit-btn"
                >

                    <span>
                        Change Password
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>

            </form>


            <!-- BACK TO ACCOUNT -->

            <div class="password-footer">

                <span>
                    Want to go back?
                </span>

                <a href="/user/profile">
                    My Account
                </a>

            </div>


            <!-- SECURITY NOTE -->

            <div class="security-note">

                <span class="security-icon">
                    🔒
                </span>

                <span>
                    Never share your password with anyone.
                </span>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PASSWORD UI JAVASCRIPT
========================================================= -->

<script>

    /* =====================================================
       SHOW / HIDE PASSWORD
    ===================================================== */

    function togglePassword(inputId, button) {

        const input =
            document.getElementById(inputId);

        if (!input) {
            return;
        }


        if (input.type === "password") {

            input.type = "text";

            button.textContent = "◌";

            button.setAttribute(
                "aria-label",
                "Hide password"
            );

        } else {

            input.type = "password";

            button.textContent = "◉";

            button.setAttribute(
                "aria-label",
                "Show password"
            );

        }

    }


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const newPasswordInput =
        document.getElementById("newPassword");

    const confirmPasswordInput =
        document.getElementById("confirmPassword");

    const strengthFill =
        document.getElementById(
            "changePasswordStrengthFill"
        );

    const strengthText =
        document.getElementById(
            "changePasswordStrengthText"
        );


    /* =====================================================
       PASSWORD STRENGTH
    ===================================================== */

    function updatePasswordStrength() {

        if (
            !newPasswordInput ||
            !strengthFill ||
            !strengthText
        ) {
            return;
        }


        const password =
            newPasswordInput.value || "";


        if (!password.length) {

            strengthFill.style.width = "0%";

            strengthText.textContent =
                "Enter a password";

            return;

        }


        let score = 0;


        if (password.length >= 8) {
            score++;
        }


        if (/[A-Z]/.test(password)) {
            score++;
        }


        if (/[a-z]/.test(password)) {
            score++;
        }


        if (/[0-9]/.test(password)) {
            score++;
        }


        if (/[^A-Za-z0-9]/.test(password)) {
            score++;
        }


        if (score <= 2) {

            strengthFill.style.width =
                "35%";

            strengthText.textContent =
                "Weak password";

        } else if (score <= 3) {

            strengthFill.style.width =
                "65%";

            strengthText.textContent =
                "Moderate password";

        } else {

            strengthFill.style.width =
                "100%";

            strengthText.textContent =
                "Strong password";

        }

    }


    /* =====================================================
       PASSWORD INPUT EVENT
    ===================================================== */

    if (newPasswordInput) {

        newPasswordInput.addEventListener(
            "input",
            updatePasswordStrength
        );

    }


    /* =====================================================
       CONFIRM PASSWORD CHECK
    ===================================================== */

    if (confirmPasswordInput) {

        confirmPasswordInput.addEventListener(
            "input",
            function () {

                if (!newPasswordInput) {
                    return;
                }


                if (
                    confirmPasswordInput.value &&
                    confirmPasswordInput.value !==
                    newPasswordInput.value
                ) {

                    confirmPasswordInput.style.borderColor =
                        "#c98787";

                } else {

                    confirmPasswordInput.style.borderColor =
                        "";

                }

            }
        );

    }

</script>