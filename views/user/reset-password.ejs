<%
    layout("layout", {
        title: "Reset Password | Yogita Patola Art",
        description: "Create a new password for your Yogita Patola Art account."
    });
%>

<!-- =========================================================
     PAGE CSS
========================================================= -->

<link rel="stylesheet" href="/css/pages/password.css">


<!-- =========================================================
     RESET PASSWORD PAGE
========================================================= -->

<section class="password-page">

    <div class="password-container">


        <!-- =================================================
             BRAND SIDE
        ================================================== -->

        <div class="password-brand">

            <div class="brand-icon">
                ✦
            </div>

            <span class="brand-eyebrow">
                YOGITA PATOLA ART
            </span>

            <h1>
                Create a<br>
                <span>New Password.</span>
            </h1>

            <p>
                Your identity has been verified. Create a strong
                new password to secure your account and continue
                shopping with us.
            </p>

            <div class="brand-divider"></div>

            <div class="brand-note">
                <span>✦</span>
                Choose a password you don't use elsewhere.
            </div>

        </div>


        <!-- =================================================
             RESET PASSWORD CARD
        ================================================== -->

        <div class="password-card">

            <div class="password-card-header">

                <span class="card-label">
                    ACCOUNT SECURITY
                </span>

                <h2>
                    Reset Password
                </h2>

                <p>
                    Enter your new password below.
                </p>

            </div>


            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="password-alert password-alert-error">

                    <span class="alert-icon">
                        !
                    </span>

                    <div>

                        <strong>
                            Unable to reset password
                        </strong>

                        <p>
                            <%= error %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 SUCCESS MESSAGE
            ================================================== -->

            <% if (typeof success !== "undefined" && success) { %>

                <div class="password-alert password-alert-success">

                    <span class="alert-icon">
                        ✓
                    </span>

                    <div>

                        <strong>
                            Password updated
                        </strong>

                        <p>
                            <%= success %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 RESET PASSWORD FORM
            ================================================== -->

            <form
                action="/user/reset-password"
                method="POST"
                class="password-form"
                autocomplete="off"
            >

                <!-- =============================================
                     NEW PASSWORD
                ============================================== -->

                <div class="form-group">

                    <label for="password">
                        New Password
                    </label>

                    <div class="input-wrapper password-input-wrapper">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your new password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="100"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('password', this)"
                            aria-label="Show password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <!-- =============================================
                     CONFIRM PASSWORD
                ============================================== -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>

                    <div class="input-wrapper password-input-wrapper">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Re-enter your new password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="100"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirmPassword', this)"
                            aria-label="Show password"
                        >
                            ◉
                        </button>

                    </div>

                </div>


                <!-- =============================================
                     PASSWORD REQUIREMENTS
                ============================================== -->

                <div class="password-requirements">

                    <div class="password-requirements-title">
                        Password requirements
                    </div>

                    <ul>

                        <li>
                            At least 8 characters
                        </li>

                        <li>
                            Use a combination of letters and numbers
                        </li>

                        <li>
                            Avoid using an easily guessed password
                        </li>

                    </ul>

                </div>


                <!-- =============================================
                     PASSWORD STRENGTH
                ============================================== -->

                <div
                    class="password-strength"
                    id="passwordStrength"
                >

                    <div class="password-strength-bar">

                        <div
                            class="password-strength-fill"
                            id="passwordStrengthFill"
                        ></div>

                    </div>

                    <div
                        class="password-strength-text"
                        id="passwordStrengthText"
                    >
                        Enter a password
                    </div>

                </div>


                <!-- =============================================
                     SUBMIT
                ============================================== -->

                <button
                    type="submit"
                    class="password-submit-btn"
                    id="resetPasswordButton"
                >

                    <span>
                        Update Password
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>

            </form>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="password-footer">

                <span>
                    Already remember your password?
                </span>

                <a href="/user/login">
                    Back to Login
                </a>

            </div>


            <!-- =================================================
                 SECURITY NOTE
            ================================================== -->

            <div class="security-note">

                <span class="security-icon">
                    🔒
                </span>

                <span>
                    Your new password will be securely encrypted.
                </span>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PASSWORD UI JAVASCRIPT
========================================================= -->

<script>

    /* =====================================================
       SHOW / HIDE PASSWORD
    ===================================================== */

    function togglePassword(inputId, button) {

        const input =
            document.getElementById(inputId);

        if (!input) {
            return;
        }

        if (input.type === "password") {

            input.type = "text";

            button.textContent = "◌";

            button.setAttribute(
                "aria-label",
                "Hide password"
            );

        } else {

            input.type = "password";

            button.textContent = "◉";

            button.setAttribute(
                "aria-label",
                "Show password"
            );

        }

    }


    /* =====================================================
       PASSWORD STRENGTH
    ===================================================== */

    const passwordInput =
        document.getElementById("password");

    const confirmPasswordInput =
        document.getElementById("confirmPassword");

    const strengthFill =
        document.getElementById("passwordStrengthFill");

    const strengthText =
        document.getElementById("passwordStrengthText");


    function updatePasswordStrength() {

        if (
            !passwordInput ||
            !strengthFill ||
            !strengthText
        ) {
            return;
        }

        const password =
            passwordInput.value || "";


        if (!password.length) {

            strengthFill.style.width = "0%";

            strengthText.textContent =
                "Enter a password";

            return;

        }


        let score = 0;


        /* Length */

        if (password.length >= 8) {
            score++;
        }


        /* Uppercase */

        if (/[A-Z]/.test(password)) {
            score++;
        }


        /* Lowercase */

        if (/[a-z]/.test(password)) {
            score++;
        }


        /* Number */

        if (/[0-9]/.test(password)) {
            score++;
        }


        /* Special character */

        if (/[^A-Za-z0-9]/.test(password)) {
            score++;
        }


        if (score <= 2) {

            strengthFill.style.width =
                "35%";

            strengthText.textContent =
                "Weak password";

        } else if (score <= 3) {

            strengthFill.style.width =
                "65%";

            strengthText.textContent =
                "Moderate password";

        } else {

            strengthFill.style.width =
                "100%";

            strengthText.textContent =
                "Strong password";

        }

    }


    /* =====================================================
       PASSWORD INPUT EVENTS
    ===================================================== */

    if (passwordInput) {

        passwordInput.addEventListener(
            "input",
            updatePasswordStrength
        );

    }


    /* =====================================================
       CONFIRM PASSWORD VISUAL CHECK
    ===================================================== */

    if (confirmPasswordInput) {

        confirmPasswordInput.addEventListener(
            "input",
            function () {

                if (
                    !passwordInput ||
                    !confirmPasswordInput
                ) {
                    return;
                }


                if (
                    confirmPasswordInput.value &&
                    confirmPasswordInput.value !==
                    passwordInput.value
                ) {

                    confirmPasswordInput.style.borderColor =
                        "#c98787";

                } else {

                    confirmPasswordInput.style.borderColor =
                        "";

                }

            }
        );

    }

</script>