<%
    layout("layout", {
        title: "Forgot Password | Yogita Patola Art",
        description: "Reset your Yogita Patola Art account password."
    });
%>

<!-- =========================================================
     PAGE CSS
========================================================= -->

<link rel="stylesheet" href="/css/pages/password.css">


<!-- =========================================================
     FORGOT PASSWORD PAGE
========================================================= -->

<section class="password-page">

    <div class="password-container">

        <!-- =================================================
             LEFT / BRAND AREA
        ================================================== -->

        <div class="password-brand">

            <div class="brand-icon">
                ✦
            </div>

            <span class="brand-eyebrow">
                YOGITA PATOLA ART
            </span>

            <h1>
                Forgot your<br>
                <span>Password?</span>
            </h1>

            <p>
                No worries. Enter the email address associated
                with your account and we'll send you a secure
                OTP to reset your password.
            </p>

            <div class="brand-divider"></div>

            <div class="brand-note">
                <span>✦</span>
                Your account security matters to us.
            </div>

        </div>


        <!-- =================================================
             FORM CARD
        ================================================== -->

        <div class="password-card">

            <div class="password-card-header">

                <span class="card-label">
                    ACCOUNT RECOVERY
                </span>

                <h2>
                    Reset Password
                </h2>

                <p>
                    Enter your registered email address below.
                </p>

            </div>


            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="password-alert password-alert-error">

                    <span class="alert-icon">
                        !
                    </span>

                    <div>

                        <strong>
                            Unable to continue
                        </strong>

                        <p>
                            <%= error %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 SUCCESS MESSAGE
            ================================================== -->

            <% if (typeof success !== "undefined" && success) { %>

                <div class="password-alert password-alert-success">

                    <span class="alert-icon">
                        ✓
                    </span>

                    <div>

                        <strong>
                            Success
                        </strong>

                        <p>
                            <%= success %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 FORGOT PASSWORD FORM
            ================================================== -->

            <form
                action="/user/forgot-password"
                method="POST"
                class="password-form"
                autocomplete="on"
            >

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            @
                        </span>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your registered email"
                            autocomplete="email"
                            required
                            maxlength="150"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                        >

                    </div>

                </div>


                <!-- =================================================
                     SUBMIT BUTTON
                ================================================== -->

                <button
                    type="submit"
                    class="password-submit-btn"
                >

                    <span>
                        Send OTP
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>

            </form>


            <!-- =================================================
                 BACK TO LOGIN
            ================================================== -->

            <div class="password-footer">

                <span>
                    Remember your password?
                </span>

                <a href="/user/login">
                    Back to Login
                </a>

            </div>


            <!-- =================================================
                 SECURITY NOTE
            ================================================== -->

            <div class="security-note">

                <span class="security-icon">
                    🔒
                </span>

                <span>
                    Your information is securely protected.
                </span>

            </div>

        </div>

    </div>

</section>