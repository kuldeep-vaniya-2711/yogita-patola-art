<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Email Verified | Yogita Patola Art
    </title>


    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    >


    <style>

        body {

            min-height: 100vh;

            margin: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #f8f7f4;

            font-family: "Poppins", sans-serif;

        }


        .card-box {

            width: 100%;

            max-width: 520px;

            background: #fff;

            padding: 45px;

            border-radius: 18px;

            text-align: center;

            box-shadow:
                0 10px 40px
                rgba(0,0,0,0.08);

        }


        .brand {

            font-family:
                "Playfair Display",
                serif;

            font-size: 28px;

            font-weight: 600;

            margin-bottom: 25px;

        }


        .success-icon {

            font-size: 60px;

            margin-bottom: 20px;

        }


        h1 {

            font-family:
                "Playfair Display",
                serif;

            margin-bottom: 15px;

        }


        p {

            color: #777;

            line-height: 1.7;

        }


        .email {

            font-weight: 600;

            color: #222;

            word-break: break-word;

        }


        .btn-dark {

            border-radius: 10px;

            padding: 12px 30px;

        }


        @media (max-width: 576px) {

            .card-box {

                margin: 20px;

                padding: 30px 20px;

            }

        }

    </style>

</head>


<body>


<div class="card-box">


    <div class="brand">

        Yogita Patola Art

    </div>


    <div class="success-icon">

        ✅

    </div>


    <h1>

        Email Verified!

    </h1>


    <p>

        Your email address has been
        successfully verified.

    </p>


    <% if (email) { %>

        <p class="email">

            <%= email %>

        </p>

    <% } %>


    <p>

        Your account is now ready to use.

    </p>


    <div class="mt-4">

        <a
            href="/user/login"
            class="btn btn-dark"
        >

            Login to Your Account

        </a>

    </div>


    <div class="mt-3">

        <a
            href="/"
            class="text-muted text-decoration-none"
        >

            ← Back to Website

        </a>

    </div>


</div>


</body>

</html>