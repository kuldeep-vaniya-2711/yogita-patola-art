<%
    layout("layout", {
        title: "Edit Profile | Yogita Patola Art",
        description: "Update your Yogita Patola Art account information."
    });
%>


<!-- =========================================================
     EDIT PROFILE CSS
========================================================= -->

<link
    rel="stylesheet"
    href="/css/pages/edit-profile.css"
>


<!-- =========================================================
     EDIT PROFILE PAGE
========================================================= -->

<section class="edit-profile-page">

    <div class="edit-profile-container">

        <div class="edit-profile-card">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="edit-profile-header">

                <div class="edit-profile-icon">
                    ✦
                </div>

                <span class="edit-profile-label">
                    MY ACCOUNT
                </span>

                <h1>
                    Edit Profile
                </h1>

                <p>
                    Update your account information
                </p>

            </div>


            <!-- =================================================
                 MESSAGES
            ================================================== -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="edit-profile-alert edit-profile-alert-error">

                    <span class="edit-alert-icon">
                        !
                    </span>

                    <div>
                        <strong>
                            Unable to update profile
                        </strong>

                        <p>
                            <%= error %>
                        </p>
                    </div>

                </div>

            <% } %>


            <% if (typeof success !== "undefined" && success) { %>

                <div class="edit-profile-alert edit-profile-alert-success">

                    <span class="edit-alert-icon">
                        ✓
                    </span>

                    <div>
                        <strong>
                            Profile updated successfully
                        </strong>

                        <p>
                            <%= success %>
                        </p>
                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 FORM
            ================================================== -->

            <form
                action="/user/profile/edit"
                method="POST"
                class="edit-profile-form"
            >


                <!-- NAME -->

                <div class="edit-form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <div class="edit-input-wrapper">

                        <span class="edit-input-icon">
                            ◇
                        </span>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= user.name || '' %>"
                            minlength="2"
                            maxlength="50"
                            placeholder="Enter your name"
                            required
                        >

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="edit-form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="edit-input-wrapper">

                        <span class="edit-input-icon">
                            @
                        </span>

                        <input
                            type="email"
                            id="email"
                            value="<%= user.email || '' %>"
                            readonly
                        >

                        <span class="edit-input-lock">
                            🔒
                        </span>

                    </div>

                    <small>
                        Email address cannot be changed here.
                    </small>

                </div>


                <!-- PHONE -->

                <div class="edit-form-group">

                    <label for="phone">
                        Phone Number
                    </label>

                    <div class="edit-input-wrapper">

                        <span class="edit-input-icon">
                            ☎
                        </span>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="<%= user.phone || '' %>"
                            placeholder="Enter your phone number"
                        >

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="edit-profile-actions">

                    <button
                        type="submit"
                        class="edit-save-btn"
                    >

                        <span>
                            Save Changes
                        </span>

                        <span>
                            →
                        </span>

                    </button>


                    <a
                        href="/user/profile"
                        class="edit-cancel-btn"
                    >

                        <span>
                            Cancel
                        </span>

                    </a>

                </div>

            </form>


            <!-- =================================================
                 SECURITY NOTE
            ================================================== -->

            <div class="edit-security-note">

                <span>
                    🔒
                </span>

                <div>

                    <strong>
                        Your information is secure
                    </strong>

                    <p>
                        Your account information is kept private
                        and is only used to manage your account.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="edit-profile-footer">

                <a href="/user/profile">
                    ← Back to My Account
                </a>

            </div>

        </div>

    </div>

</section>