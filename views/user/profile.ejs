<%
    layout("layout", {
        title: "My Profile | Yogita Patola Art",
        description: "Manage your Yogita Patola Art account profile and password."
    });
%>


<!-- =========================================================
     PROFILE PAGE CSS
     Loaded directly for this page
========================================================= -->

<link
    rel="stylesheet"
    href="/css/pages/password.css"
>


<!-- =========================================================
     PROFILE PAGE
========================================================= -->

<section class="password-page profile-page">

    <div class="password-container">


        <!-- =====================================================
             PROFILE CARD
        ====================================================== -->

        <div class="password-card profile-card">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="password-card-header profile-header">

                <div class="brand-icon">
                    👤
                </div>

                <span class="card-label">
                    MY ACCOUNT
                </span>

                <h1>
                    My Profile
                </h1>

                <p>
                    Manage your account information and security.
                </p>

            </div>



            <!-- =================================================
                 PROFILE INFORMATION
            ================================================== -->

            <div class="profile-information">


                <!-- NAME -->

                <div class="form-group">

                    <label class="password-label">
                        Name
                    </label>

                    <div class="profile-value">
                        <%= user.name || "—" %>
                    </div>

                </div>



                <!-- EMAIL -->

                <div class="form-group">

                    <label class="password-label">
                        Email Address
                    </label>

                    <div class="profile-value">
                        <%= user.email || "—" %>
                    </div>

                </div>



                <!-- PHONE -->

                <div class="form-group">

                    <label class="password-label">
                        Phone
                    </label>

                    <div class="profile-value">
                        <%= user.phone || "Not provided" %>
                    </div>

                </div>



                <!-- EMAIL VERIFICATION -->

                <div class="form-group">

                    <label class="password-label">
                        Email Verification
                    </label>

                    <div class="profile-value">

                        <% if (user.emailVerified) { %>

                            <span class="profile-status verified">
                                ✓ Verified
                            </span>

                        <% } else { %>

                            <span class="profile-status not-verified">
                                Not Verified
                            </span>

                        <% } %>

                    </div>

                </div>


            </div>



            <!-- =================================================
                 ACCOUNT ACTIONS
            ================================================== -->

            <div class="profile-actions">


                <!-- EDIT PROFILE -->

                <a
                    href="/user/profile/edit"
                    class="password-submit-btn profile-action-primary"
                >

                    <span>
                        Edit Profile
                    </span>

                    <span>
                        →
                    </span>

                </a>



                <!-- CHANGE PASSWORD -->

                <a
                    href="/user/change-password"
                    class="password-secondary-btn profile-action-secondary"
                >

                    <span>
                        🔐 Change Password
                    </span>

                </a>



                <!-- WISHLIST -->

                <a
                    href="/wishlist"
                    class="password-secondary-btn profile-action-secondary"
                >

                    <span>
                        ❤️ Wishlist
                    </span>

                </a>



                <!-- LOGOUT -->

                <a
                    href="/user/logout"
                    class="password-secondary-btn profile-action-secondary"
                >

                    <span>
                        Logout
                    </span>

                </a>


            </div>



            <!-- =================================================
                 SECURITY NOTE
            ================================================== -->

            <div class="security-note">

                <span class="security-note-icon">
                    🔒
                </span>

                <div>

                    <strong>
                        Account Security
                    </strong>

                    <p>
                        Keep your password private and use a strong,
                        unique password to protect your account.
                    </p>

                </div>

            </div>



            <!-- =================================================
                 BACK TO WEBSITE
            ================================================== -->

            <div class="password-footer">

                <a href="/">
                    ← Back to Yogita Patola Art
                </a>

            </div>


        </div>

    </div>

</section>