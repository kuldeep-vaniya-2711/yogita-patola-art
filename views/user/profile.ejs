<% layout("layout") -%>


<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7 col-md-9">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">


                        <!-- PROFILE HEADER -->

                        <div class="text-center mb-4">

                            <div class="fs-1">
                                👤
                            </div>

                            <h1 class="h3 mb-1">
                                My Profile
                            </h1>

                            <p class="text-muted mb-0">
                                Your account information
                            </p>

                        </div>


                        <!-- NAME -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Name
                            </label>

                            <div class="form-control bg-light">
                                <%= user.name || "—" %>
                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <div class="form-control bg-light">
                                <%= user.email || "—" %>
                            </div>

                        </div>


                        <!-- PHONE -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Phone
                            </label>

                            <div class="form-control bg-light">
                                <%= user.phone || "Not provided" %>
                            </div>

                        </div>


                        <!-- EMAIL VERIFICATION -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Email Verification
                            </label>

                            <div class="form-control bg-light">

                                <%= user.emailVerified
                                    ? "✓ Verified"
                                    : "Not Verified"
                                %>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="d-flex flex-wrap gap-2">


                            <!-- EDIT PROFILE -->

                            <a
                                href="/user/profile/edit"
                                class="btn btn-dark"
                            >
                                Edit Profile
                            </a>


                            <!-- WISHLIST -->

                            <a
                                href="/wishlist"
                                class="btn btn-outline-dark"
                            >
                                ❤️ Wishlist
                            </a>


                            <!-- LOGOUT -->

                            <a
                                href="/user/logout"
                                class="btn btn-outline-dark"
                            >
                                Logout
                            </a>


                        </div>


                    </div>

                </div>

            </div>

        </div>

    </div>

</section>